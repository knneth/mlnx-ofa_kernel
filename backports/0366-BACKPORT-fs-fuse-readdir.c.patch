From: Valentine Fatiev <valentinef@nvidia.com>
Subject: [PATCH] BACKPORT: fs/fuse/readdir.c

---
 fs/fuse/readdir.c | 27 +++++++++++++++++++++++++++
 1 file changed, 27 insertions(+)

diff --git a/fs/fuse/readdir.c b/fs/fuse/readdir.c
index xxxxxxx..xxxxxxx 100644
--- a/fs/fuse/readdir.c
+++ b/fs/fuse/readdir.c
@@ -13,6 +13,10 @@
 #include <linux/pagemap.h>
 #include <linux/highmem.h>
 
+#ifndef HAVE_FILLDIR_FLAG_NOINTR
+#define FILLDIR_FLAG_NOINTR 0
+#endif
+
 static bool fuse_use_readdirplus(struct inode *dir, struct dir_context *ctx)
 {
 	struct fuse_conn *fc = get_fuse_conn(dir);
@@ -160,7 +164,9 @@ static int fuse_direntplus_link(struct file *file,
 	struct inode *dir = d_inode(parent);
 	struct fuse_conn *fc;
 	struct inode *inode;
+#ifndef HAVE_D_ALLOC_PARALLEL_2_ARGS
 	DECLARE_WAIT_QUEUE_HEAD_ONSTACK(wq);
+#endif
 	int epoch;
 
 	if (!o->nodeid) {
@@ -197,7 +203,16 @@ static int fuse_direntplus_link(struct file *file,
 	dentry = d_lookup(parent, &name);
 	if (!dentry) {
 retry:
+#ifdef HAVE_D_ALLOC_PARALLEL_2_ARGS
+/* Upstream commit 0e0e490f5d5ec2f91209b77a95f9c7185d97cfc6
+ * ("VFS: use wait_var_event for waiting in d_alloc_parallel()", 7.2+)
+ * d_alloc_parallel() now waits via wait_var_event internally, so the
+ * caller-supplied wait_queue_head_t argument was dropped.
+ */
+		dentry = d_alloc_parallel(parent, &name);
+#else
 		dentry = d_alloc_parallel(parent, &name, &wq);
+#endif
 		if (IS_ERR(dentry))
 			return PTR_ERR(dentry);
 	}
@@ -341,7 +356,11 @@ static int fuse_readdir_uncached(struct file *file, struct dir_context *ctx)
 	struct fuse_io_args ia = {};
 	struct fuse_args *args = &ia.ap.args;
 	void *buf;
+#ifdef HAVE_DIR_CONTEXT_COUNT
 	size_t bufsize = clamp((unsigned int) ctx->count, PAGE_SIZE, fc->max_pages << PAGE_SHIFT);
+#else
+	size_t bufsize = (size_t)fc->max_pages << PAGE_SHIFT;
+#endif
 	u64 attr_version = 0, evict_ctr = 0;
 	bool locked;
 
@@ -477,7 +496,11 @@ retry_locked:
 	if (!fi->rdc.cached) {
 		/* Starting cache? Set cache mtime. */
 		if (!ctx->pos && !fi->rdc.size) {
+#ifdef HAVE_INODE_GET_MTIME
 			fi->rdc.mtime = inode_get_mtime(inode);
+#else
+			fi->rdc.mtime = inode->i_mtime;
+#endif
 			fi->rdc.iversion = inode_query_iversion(inode);
 		}
 		spin_unlock(&fi->rdc.lock);
@@ -489,7 +512,11 @@ retry_locked:
 	 * changed, and reset the cache if so.
 	 */
 	if (!ctx->pos) {
+#ifdef HAVE_INODE_GET_MTIME
 		struct timespec64 mtime = inode_get_mtime(inode);
+#else
+		struct timespec64 mtime = inode->i_mtime;
+#endif
 
 		if (inode_peek_iversion(inode) != fi->rdc.iversion ||
 		    !timespec64_equal(&fi->rdc.mtime, &mtime)) {
