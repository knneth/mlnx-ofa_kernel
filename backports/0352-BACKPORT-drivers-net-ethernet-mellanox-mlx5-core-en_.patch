+#endif
 	struct mlx5e_ipsec *ipsec;
 	struct mlx5e_priv *priv;
 	gfp_t gfp;
 	int err;
+#if !defined(HAVE_XDO_XFRM_ADD_STATE_GET_EXTACK) && !defined(HAVE_XDO_DEV_STATE_DELETE_GET_NET_DEVICE)
+	struct netlink_ext_ack *extack;
+	extack = NULL;
+#endif
 
 	priv = netdev_priv(dev);
 	if (!priv->ipsec)
 		return -EOPNOTSUPP;
 
 	ipsec = priv->ipsec;
+#ifdef HAVE_XFRM_DEV_OFFLOAD_FLAG_ACQ
 	gfp = (x->xso.flags & XFRM_DEV_OFFLOAD_FLAG_ACQ) ? GFP_ATOMIC : GFP_KERNEL;
+#else
+	gfp = GFP_ATOMIC;
+#endif
 	sa_entry = kzalloc(sizeof(*sa_entry), gfp);
 	if (!sa_entry)
 		return -ENOMEM;
 
 	sa_entry->x = x;
+#ifdef HAVE_XDO_DEV_STATE_DELETE_GET_NET_DEVICE
 	sa_entry->dev = dev;
+#endif
 	sa_entry->ipsec = ipsec;
 	/* Check if this SA is originated from acquire flow temporary SA */
+#ifdef HAVE_XFRM_DEV_OFFLOAD_FLAG_ACQ
 	if (x->xso.flags & XFRM_DEV_OFFLOAD_FLAG_ACQ)
 		goto out;
+#endif
 
 	err = mlx5e_xfrm_validate_state(priv->mdev, x, extack);
 	if (err)
@@ -810,6 +912,7 @@ static int mlx5e_xfrm_add_state(struct net_device *dev,
 	if (err)
 		goto unblock_ipsec;
 
+#ifdef HAVE_XFRM_DEV_TYPE
 	if (x->props.mode == XFRM_MODE_TUNNEL &&
 	    x->xso.type == XFRM_DEV_OFFLOAD_PACKET) {
 		allow_tunnel_mode = mlx5e_ipsec_fs_tunnel_allowed(sa_entry);
@@ -820,6 +923,7 @@ static int mlx5e_xfrm_add_state(struct net_device *dev,
 			goto unblock_mode;
 		}
 	}
+#endif
 
 	/* check esn */
 	if (x->props.flags & XFRM_STATE_ESN)
@@ -865,19 +969,25 @@ static int mlx5e_xfrm_add_state(struct net_device *dev,
 		queue_delayed_work(ipsec->wq, &sa_entry->dwork->dwork,
 				   MLX5_IPSEC_RESCHED);
 
+#ifdef HAVE_XFRM_DEV_TYPE
 	if (allow_tunnel_mode) {
 		xa_lock_bh(&ipsec->sadb);
 		__xa_set_mark(&ipsec->sadb, sa_entry->ipsec_obj_id,
 			      MLX5E_IPSEC_TUNNEL_SA);
 		xa_unlock_bh(&ipsec->sadb);
 	}
+#endif
 
+#ifdef HAVE_XFRM_DEV_OFFLOAD_FLAG_ACQ
 out:
+#endif
 	x->xso.offload_handle = (unsigned long)sa_entry;
+#ifdef HAVE_XFRM_DEV_TYPE
 	if (allow_tunnel_mode)
 		mlx5_eswitch_unblock_encap(priv->mdev);
 
 	mlx5_eswitch_unblock_mode(priv->mdev);
+#endif
 
 	return 0;
 
@@ -892,38 +1002,57 @@ release_work:
 		kfree(sa_entry->work->data);
 	kfree(sa_entry->work);
 unblock_encap:
+#ifdef HAVE_XFRM_DEV_TYPE
 	if (allow_tunnel_mode)
 		mlx5_eswitch_unblock_encap(priv->mdev);
 unblock_mode:
+#endif
 	mlx5_eswitch_unblock_mode(priv->mdev);
 unblock_ipsec:
 	mlx5_eswitch_unblock_ipsec(priv->mdev);
 err_xfrm:
 	kfree(sa_entry);
+#ifdef HAVE_NL_SET_ERR_MSG_WEAK_MOD
 	NL_SET_ERR_MSG_WEAK_MOD(extack, "Device failed to offload this state");
+#else
+	if ((extack) && !(extack)->_msg)
+		NL_SET_ERR_MSG_MOD((extack), "Device failed to offload this state");
+#endif
 	return err;
 }
 
-static void mlx5e_xfrm_del_state(struct net_device *dev, struct xfrm_state *x)
