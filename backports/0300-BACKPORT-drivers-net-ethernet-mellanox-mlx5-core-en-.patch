From: Valentine Fatiev <valentinef@nvidia.com>
Subject: [PATCH] BACKPORT: drivers/net/ethernet/mellanox/mlx5/core/en/trap.c

Change-Id: I83f18354c7714eb35bb80739373cc03a1ebb7f75
---
 .../net/ethernet/mellanox/mlx5/core/en/trap.c | 57 +++++++++++++++++++
 1 file changed, 57 insertions(+)

--- a/drivers/net/ethernet/mellanox/mlx5/core/en/trap.c
+++ b/drivers/net/ethernet/mellanox/mlx5/core/en/trap.c
@@ -1,6 +1,15 @@
 // SPDX-License-Identifier: GPL-2.0 OR Linux-OpenIB
 /* Copyright (c) 2020 Mellanox Technologies */
 
+#ifdef HAVE_DEVLINK_TRAP_SUPPORT
+
+#ifdef HAVE_NET_PAGE_POOL_OLD_H
+#include <net/page_pool.h>
+#endif
+#ifdef HAVE_NET_PAGE_POOL_TYPES_H
+#include <net/page_pool/types.h>
+#include <net/page_pool/helpers.h>
+#endif
 #include "en/txrx.h"
 #include "en/params.h"
 #include "en/trap.h"
@@ -52,7 +61,9 @@ static void mlx5e_init_trap_rq(struct ml
 	rq->hw_mtu       = MLX5E_SW2HW_MTU(params, params->sw_mtu);
 	rq->stats        = &priv->trap_stats.rq;
 	rq->ptp_cyc2time = mlx5_rq_ts_translator(mdev);
+#ifdef HAVE_XDP_SUPPORT
 	xdp_rxq_info_unused(&rq->xdp_rxq);
+#endif
 	mlx5e_rq_set_trap_handlers(rq, params);
 }
 
@@ -150,7 +161,15 @@ static struct mlx5e_trap *mlx5e_open_tra
 	t->mkey_be  = cpu_to_be32(priv->mdev->mlx5e_res.hw_objs.mkey);
 	t->stats    = &priv->trap_stats.ch;
 
+#ifdef HAVE_NAPI_LOCKED_API
+	/* Upstream commit 8f7b00307bf1: changed to locked variant */
 	netif_napi_add_locked(netdev, &t->napi, mlx5e_trap_napi_poll);
+#elif defined(HAVE_NETIF_NAPI_ADD_GET_3_PARAMS)
+	/* Before commit 8f7b00307bf1: used non-locked variant */
+	netif_napi_add(netdev, &t->napi, mlx5e_trap_napi_poll);
+#else
+	netif_napi_add(netdev, &t->napi, mlx5e_trap_napi_poll, 64);
+#endif
 
 	err = mlx5e_open_trap_rq(priv, t);
 	if (unlikely(err))
@@ -165,7 +184,13 @@ static struct mlx5e_trap *mlx5e_open_tra
 err_close_trap_rq:
 	mlx5e_close_trap_rq(&t->rq);
 err_napi_del:
+#ifdef HAVE_NAPI_LOCKED_API
+	/* Upstream commit 8f7b00307bf1: changed to locked variant */
 	netif_napi_del_locked(&t->napi);
+#else
+	/* Before commit 8f7b00307bf1: used non-locked variant */
+	netif_napi_del(&t->napi);
+#endif
 	kvfree(t);
 	return ERR_PTR(err);
 }
@@ -174,13 +199,25 @@ void mlx5e_close_trap(struct mlx5e_trap
 {
 	mlx5e_tir_destroy(&trap->tir);
 	mlx5e_close_trap_rq(&trap->rq);
+#ifdef HAVE_NAPI_LOCKED_API
+	/* Upstream commit 8f7b00307bf1: changed to locked variant */
 	netif_napi_del_locked(&trap->napi);
+#else
+	/* Before commit 8f7b00307bf1: used non-locked variant */
+	netif_napi_del(&trap->napi);
+#endif
 	kvfree(trap);
 }
 
 static void mlx5e_activate_trap(struct mlx5e_trap *trap)
 {
+#ifdef HAVE_NAPI_LOCKED_API
+	/* Upstream commit 8f7b00307bf1: changed to locked variant */
 	napi_enable_locked(&trap->napi);
+#else
+	/* Before commit 8f7b00307bf1: used non-locked variant */
+	napi_enable(&trap->napi);
+#endif
 	mlx5e_activate_rq(&trap->rq);
 	mlx5e_trigger_napi_sched(&trap->napi);
 }
@@ -190,7 +227,13 @@ void mlx5e_deactivate_trap(struct mlx5e_
 	struct mlx5e_trap *trap = priv->en_trap;
 
 	mlx5e_deactivate_rq(&trap->rq);
+#ifdef HAVE_NAPI_LOCKED_API
+	/* Upstream commit 8f7b00307bf1: changed to locked variant */
 	napi_disable_locked(&trap->napi);
+#else
+	/* Before commit 8f7b00307bf1: used non-locked variant */
+	napi_disable(&trap->napi);
+#endif
 }
 
 static struct mlx5e_trap *mlx5e_add_trap_queue(struct mlx5e_priv *priv)
@@ -237,11 +280,13 @@ static int mlx5e_handle_action_trap(stru
 		if (err)
 			goto err_out;
 		break;
+#ifdef HAVE_DEVLINK_TRAP_DMAC_FILTER
 	case DEVLINK_TRAP_GENERIC_ID_DMAC_FILTER:
 		err = mlx5e_add_mac_trap(priv->fs, trap_id, mlx5e_trap_get_tirn(priv->en_trap));
 		if (err)
 			goto err_out;
 		break;
+#endif
 	default:
 		netdev_warn(priv->netdev, "%s: Unknown trap id %d\n", __func__, trap_id);
 		err = -EINVAL;
@@ -261,9 +306,11 @@ static int mlx5e_handle_action_drop(stru
 	case DEVLINK_TRAP_GENERIC_ID_INGRESS_VLAN_FILTER:
 		mlx5e_remove_vlan_trap(priv->fs);
 		break;
+#ifdef HAVE_DEVLINK_TRAP_DMAC_FILTER
 	case DEVLINK_TRAP_GENERIC_ID_DMAC_FILTER:
 		mlx5e_remove_mac_trap(priv->fs);
 		break;
+#endif
 	default:
 		netdev_warn(priv->netdev, "%s: Unknown trap id %d\n", __func__, trap_id);
 		return -EINVAL;
@@ -286,7 +333,10 @@ int mlx5e_handle_trap_event(struct mlx5e
 	if (!test_bit(MLX5E_STATE_OPENED, &priv->state))
 		return 0;
 
+#ifdef HAVE_NETDEVICE_NETDEV_LOCK
+	/* Upstream commit 8f7b00307bf1: added lock (no lock before) */
 	netdev_lock(priv->netdev);
+#endif
 	switch (trap_ctx->action) {
 	case DEVLINK_TRAP_ACTION_TRAP:
 		err = mlx5e_handle_action_trap(priv, trap_ctx->id);
@@ -299,7 +349,10 @@ int mlx5e_handle_trap_event(struct mlx5e
 			    trap_ctx->action);
 		err = -EINVAL;
 	}
+#ifdef HAVE_NETDEVICE_NETDEV_LOCK
+	/* Upstream commit 8f7b00307bf1: added unlock (no lock before) */
 	netdev_unlock(priv->netdev);
+#endif
 	return err;
 }
 
@@ -319,7 +372,9 @@ static int mlx5e_apply_trap(struct mlx5e
 
 static const int mlx5e_traps_arr[] = {
 	DEVLINK_TRAP_GENERIC_ID_INGRESS_VLAN_FILTER,
+#ifdef HAVE_DEVLINK_TRAP_DMAC_FILTER
 	DEVLINK_TRAP_GENERIC_ID_DMAC_FILTER,
+#endif
 };
 
 int mlx5e_apply_traps(struct mlx5e_priv *priv, bool enable)
@@ -334,3 +389,5 @@ int mlx5e_apply_traps(struct mlx5e_priv
 	}
 	return 0;
 }
+
+#endif /* HAVE_DEVLINK_TRAP_SUPPORT */
