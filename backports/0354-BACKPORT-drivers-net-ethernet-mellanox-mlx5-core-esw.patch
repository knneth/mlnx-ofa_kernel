 {
 	struct mlx5_esw_sched_node *node = priv;
@@ -2145,6 +2189,7 @@ mlx5_esw_qos_pre_cleanup(struct mlx5_cor
 	esw_qos_unlock(esw);
 }
 
+#ifdef HAVE_DEVLINK_HAS_RATE_FUNCTIONS
