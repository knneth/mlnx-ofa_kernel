+#endif
 
 /* Minimum supported BW share value by the HW is 1 Mbit/sec */
 #define MLX5_MIN_BW_SHARE 1
@@ -524,7 +527,10 @@ static void __esw_qos_free_node(struct m
 	kfree(node);
 }
 
-static void esw_qos_destroy_node(struct mlx5_esw_sched_node *node, struct netlink_ext_ack *extack)
+#ifdef HAVE_DEVLINK_HAS_RATE_FUNCTIONS
+static
+#endif
+void esw_qos_destroy_node(struct mlx5_esw_sched_node *node, struct netlink_ext_ack *extack)
 {
 	esw_qos_node_destroy_sched_element(node, extack);
 	__esw_qos_free_node(node);
@@ -965,9 +971,14 @@ esw_qos_vport_tc_enable(struct mlx5_vpor
 		max_level = 1 << MLX5_CAP_QOS(vport_node->esw->dev,
 					      log_esw_max_sched_depth);
 		if (new_level > max_level) {
+#ifdef HAVE_NL_SET_ERR_MSG_FMT_MOD
 			NL_SET_ERR_MSG_FMT_MOD(extack,
 					       "TC arbitration on leafs is not supported beyond max depth %d",
 					       max_level);
+#else
+			NL_SET_ERR_MSG_MOD(extack,
+					   "TC arbitration on leafs is not supported beyond max scheduling depth");
+#endif
 			return -EOPNOTSUPP;
 		}
 	}
@@ -1443,9 +1454,14 @@ static int esw_qos_node_enable_tc_arbitr
 	new_level = node->level + 1;
 	max_level = 1 << MLX5_CAP_QOS(node->esw->dev, log_esw_max_sched_depth);
 	if (new_level > max_level) {
+#ifdef HAVE_NL_SET_ERR_MSG_FMT_MOD
 		NL_SET_ERR_MSG_FMT_MOD(extack,
 				       "TC arbitration on nodes is not supported beyond max depth %d",
 				       max_level);
+#else
+		NL_SET_ERR_MSG_MOD(extack,
+				       "TC arbitration on nodes is not supported beyond max depth");
+#endif
 		return -EOPNOTSUPP;
 	}
 
@@ -1519,8 +1535,8 @@ out:
 	return speed;
 }
 
