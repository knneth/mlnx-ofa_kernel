+		goto out_old_shash;
+	}
+	if (WARN_ON(prk_len > NVME_AUTH_MAX_DIGEST_SIZE)) {
+		ret = -EINVAL;
+		goto out_old_prk;
+	}
+	ret = hkdf_extract(hmac_tfm, psk, psk_len,
+			   default_salt, prk_len, prk);
+	if (ret)
+		goto out_old_prk;
+
+	ret = crypto_shash_setkey(hmac_tfm, prk, prk_len);
+	if (ret)
+		goto out_old_prk;
+
+	ctx = kasprintf(GFP_KERNEL, "%02d %s", hmac_id,
+			(const char *)psk_digest);
+	if (!ctx) {
+		ret = -ENOMEM;
+		goto out_old_prk;
+	}
+
+	tls_key = kzalloc(psk_len, GFP_KERNEL);
+	if (!tls_key) {
+		ret = -ENOMEM;
+		goto out_old_ctx;
+	}
+	ret = hkdf_expand_label(hmac_tfm,
+				nvme_label, strlen(nvme_label),
+				ctx, strlen(ctx),
+				tls_key, psk_len);
+	if (ret) {
+		kfree_sensitive(tls_key);
+		goto out_old_ctx;
+	}
+	*ret_psk = tls_key;
+out_old_ctx:
+	kfree(ctx);
+out_old_prk:
+	kfree_sensitive(prk);
+out_old_shash:
+	crypto_free_shash(hmac_tfm);
+#else
+	return -EOPNOTSUPP;
+#endif
 	return ret;
 }
 EXPORT_SYMBOL_GPL(nvme_auth_derive_tls_psk);
 
+#endif /* HAVE_NVME_AUTH_TRANSFORM_KEY_DHCHAP */
