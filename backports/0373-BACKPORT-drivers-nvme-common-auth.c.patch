 int nvme_auth_augmented_challenge(u8 hmac_id, const u8 *skey, size_t skey_len,
 				  const u8 *challenge, u8 *aug, size_t hlen)
 {
+#ifdef HAVE_HMAC_SHA256_INIT_USINGRAWKEY
 	return nvme_auth_hmac(hmac_id, skey, skey_len, challenge, hlen, aug);
+#else
+	struct crypto_shash *tfm;
+	u8 *hashed_key;
+	const char *hmac_name;
+	int ret;
+
+	hashed_key = kmalloc(hlen, GFP_KERNEL);
+	if (!hashed_key)
+		return -ENOMEM;
+	const char *digest_name = nvme_auth_digest_name(hmac_id);
+	struct crypto_shash *digest_tfm;
+
+	if (!digest_name) {
+		ret = -EINVAL;
+		goto out_free_key;
+	}
+	digest_tfm = crypto_alloc_shash(digest_name, 0, 0);
+	if (IS_ERR(digest_tfm)) {
+		ret = PTR_ERR(digest_tfm);
+		goto out_free_key;
+	}
+	ret = crypto_shash_tfm_digest(digest_tfm, skey, skey_len, hashed_key);
+	crypto_free_shash(digest_tfm);
+	if (ret < 0)
+		goto out_free_key;
+	hmac_name = nvme_auth_hmac_name(hmac_id);
+	if (!hmac_name) {
+		ret = -EINVAL;
+		goto out_free_key;
+	}
+	tfm = crypto_alloc_shash(hmac_name, 0, 0);
+	if (IS_ERR(tfm)) {
+		ret = PTR_ERR(tfm);
+		goto out_free_key;
+	}
+	ret = crypto_shash_setkey(tfm, hashed_key, hlen);
+	if (ret)
+		goto out_free_hash;
+	ret = crypto_shash_tfm_digest(tfm, challenge, hlen, aug);
+out_free_hash:
+	crypto_free_shash(tfm);
+out_free_key:
+	kfree_sensitive(hashed_key);
+	return ret;
+#endif
 }
 EXPORT_SYMBOL_GPL(nvme_auth_augmented_challenge);
 
