From: Valentine Fatiev <valentinef@nvidia.com>
Subject: [PATCH] BACKPORT: drivers/net/ethernet/mellanox/mlx5/core/eswitch.c

---
 .../net/ethernet/mellanox/mlx5/core/eswitch.c | 185 +++++++++++++++++-
 1 file changed, 182 insertions(+), 3 deletions(-)

diff --git a/drivers/net/ethernet/mellanox/mlx5/core/eswitch.c b/drivers/net/ethernet/mellanox/mlx5/core/eswitch.c
index xxxxxxx..xxxxxxx 100644
--- a/drivers/net/ethernet/mellanox/mlx5/core/eswitch.c
+++ b/drivers/net/ethernet/mellanox/mlx5/core/eswitch.c
@@ -829,6 +829,7 @@ static int mlx5_esw_vport_caps_get(struct mlx5_eswitch *esw, struct mlx5_vport *
 	if (!MLX5_CAP_GEN_MAX(esw->dev, hca_cap_2))
 		goto out_free;
 
+#if defined(HAVE_DEVLINK_HAS_PORT_FN_ROCE_MIG) || defined(HAVE_DEVLINK_PORT_OPS)
 	memset(query_ctx, 0, query_out_sz);
 	err = mlx5_vport_get_other_func_cap(esw->dev, vport->vport, query_ctx,
 					    MLX5_CAP_GENERAL_2);
@@ -839,6 +840,7 @@ static int mlx5_esw_vport_caps_get(struct mlx5_eswitch *esw, struct mlx5_vport *
 	vport->info.mig_enabled = MLX5_GET(cmd_hca_cap_2, hca_caps, migratable);
 
 	err = mlx5_esw_ipsec_vf_offload_get(esw->dev, vport);
+#endif /* defined(HAVE_DEVLINK_HAS_PORT_FN_ROCE_MIG) || defined(HAVE_DEVLINK_PORT_OPS) */
 out_free:
 	kfree(query_ctx);
 	return err;
@@ -963,7 +965,7 @@ int mlx5_esw_vport_enable(struct mlx5_eswitch *esw, struct mlx5_vport *vport,
 			  enum mlx5_eswitch_vport_event enabled_events)
 {
 	u16 vport_num = vport->vport;
-	int ret;
+	int ret = 0;
 
 	mutex_lock(&esw->state_lock);
 	if (vport->enabled)
@@ -1533,7 +1535,11 @@ static void mlx5_eswitch_get_devlink_param(struct mlx5_eswitch *esw)
 	union devlink_param_value val;
 	int err;
 
+#ifdef HAVE_DEVL_PARAM_DRIVERINIT_VALUE_GET
 	err = devl_param_driverinit_value_get(devlink,
+#else
+	err = devlink_param_driverinit_value_get(devlink,
+#endif
 					      MLX5_DEVLINK_PARAM_ID_ESW_LARGE_GROUP_NUM,
 					      &val);
 	if (!err) {
@@ -1703,7 +1709,9 @@ int mlx5_eswitch_enable_locked(struct mlx5_eswitch *esw, int num_vfs)
 {
 	int err;
 
+#ifdef HAVE_DEVL_TRAP_GROUPS_REGISTER
 	devl_assert_locked(priv_to_devlink(esw->dev));
+#endif
 
 	if (!MLX5_CAP_ESW_FLOWTABLE_FDB(esw->dev, ft_support)) {
 		esw_warn(esw->dev, "FDB is not supported, aborting ...\n");
@@ -1766,19 +1774,38 @@ err_esw_init:
  */
 int mlx5_eswitch_enable(struct mlx5_eswitch *esw, int num_vfs)
 {
+#ifndef HAVE_DEVL_TRAP_GROUPS_REGISTER
+	struct mlxdevm *mlxdevm;
+#ifdef HAVE_DEVL_PORT_REGISTER
+	struct devlink *devlink;
+#endif
+#endif
 	bool toggle_lag;
 	int ret = 0;
 
 	if (!mlx5_esw_allowed(esw))
 		return 0;
 
+#ifndef HAVE_DEVL_TRAP_GROUPS_REGISTER
+	mlxdevm = &mlx5_devm_device_get(esw->dev)->device;
+#endif
+
+#ifdef HAVE_DEVL_TRAP_GROUPS_REGISTER
 	devl_assert_locked(priv_to_devlink(esw->dev));
+#endif
 
 	toggle_lag = !mlx5_sriov_is_enabled(esw->dev) && !is_mdev_switchdev_mode(esw->dev);
 
 	if (toggle_lag)
 		mlx5_lag_disable_change(esw->dev);
 
+#ifndef HAVE_DEVL_TRAP_GROUPS_REGISTER
+#ifdef HAVE_DEVL_PORT_REGISTER
+	devlink = priv_to_devlink(esw->dev);
+	devl_lock(devlink);
+#endif
+	devm_lock(mlxdevm);
+#endif
 	mlx5_eswitch_invalidate_wq(esw);
 	mlx5_esw_reps_block(esw);
 
@@ -1806,6 +1833,12 @@ int mlx5_eswitch_enable(struct mlx5_eswitch *esw, int num_vfs)
 
 	mlx5_esw_reps_unblock(esw);
 
+#ifndef HAVE_DEVL_TRAP_GROUPS_REGISTER
+	devm_unlock(mlxdevm);
+#ifdef HAVE_DEVL_PORT_REGISTER
+	devl_unlock(devlink);
+#endif
+#endif
 	if (toggle_lag)
 		mlx5_lag_enable_change(esw->dev);
 
@@ -1815,15 +1848,37 @@ int mlx5_eswitch_enable(struct mlx5_eswitch *esw, int num_vfs)
 /* When disabling sriov, free driver level resources. */
 void mlx5_eswitch_disable_sriov(struct mlx5_eswitch *esw, bool clear_vf)
 {
+#ifndef HAVE_DEVL_TRAP_GROUPS_REGISTER
+	struct mlxdevm *mlxdevm;
+#ifdef HAVE_DEVL_PORT_REGISTER
+	struct devlink *devlink;
+#endif
+#endif
 	if (!mlx5_esw_allowed(esw))
 		return;
 
+#ifndef HAVE_DEVL_TRAP_GROUPS_REGISTER
+	mlxdevm = &mlx5_devm_device_get(esw->dev)->device;
+#endif
+
+#ifdef HAVE_DEVL_TRAP_GROUPS_REGISTER
 	devl_assert_locked(priv_to_devlink(esw->dev));
+#else
+#ifdef HAVE_DEVL_PORT_REGISTER
+	devlink = priv_to_devlink(esw->dev);
+	devl_lock(devlink);
+#endif
+	devm_lock(mlxdevm);
+#endif
 	/* If driver is unloaded, this function is called twice by remove_one()
 	 * and mlx5_unload(). Prevent the second call.
 	 */
 	if (!esw->esw_funcs.num_vfs && !esw->esw_funcs.num_ec_vfs && !clear_vf)
-		return;
+#ifndef HAVE_DEVL_TRAP_GROUPS_REGISTER
+	goto unlock;
+#else
+	return;
+#endif
 
 	esw_info(esw->dev, "Unload vfs: mode(%s), nvfs(%d), necvfs(%d), active vports(%d)\n",
 		 esw->mode == MLX5_ESWITCH_LEGACY ? "LEGACY" : "OFFLOADS",
@@ -1852,14 +1907,53 @@ void mlx5_eswitch_disable_sriov(struct mlx5_eswitch *esw, bool clear_vf)
 		esw->esw_funcs.num_vfs = 0;
 	else
 		esw->esw_funcs.num_ec_vfs = 0;
+#ifndef HAVE_DEVL_TRAP_GROUPS_REGISTER
+unlock:
+	devm_unlock(mlxdevm);
+#ifdef HAVE_DEVL_PORT_REGISTER
+	devl_unlock(devlink);
+#endif
+#endif
+}
+
+#if defined(HAVE_DEVLINK_HAS_RATE_FUNCTIONS) && \
+	!defined(HAVE_DEVL_RATE_NODES_DESTROY_UNSETS_PARENT)
+/* Clear the parent left behind in every rate leaf by devl_rate_nodes_destroy().
+ *
+ * Kernels without upstream commit f94c1a114ac2 ("devlink: rate: Unset parent
+ * pointer in devl_rate_nodes_destroy") keep every rate leaf pointing at the node
+ * the core just freed, so the devl_rate_leaf_destroy() that runs when the vports
+ * are unloaded reads parent->name and decrements parent->refcnt on freed memory.
+ * The core has already detached the driver side and dropped the reference, so
+ * only the stale pointer is left to clear. A rate object reachable from a
+ * devlink port is always a leaf, the type check only makes that explicit.
+ */
+static void mlx5_esw_rate_leaves_null_parent(struct mlx5_eswitch *esw)
+{
+	struct mlx5_vport *vport;
+	unsigned long i;
+
+	mlx5_esw_for_each_vport(esw, i, vport) {
+		struct devlink_rate *rate;
+
+		if (!vport->dl_port)
+			continue;
+
+		rate = vport->dl_port->dl_port.devlink_rate;
+		if (rate && rate->type == DEVLINK_RATE_TYPE_LEAF)
+			rate->parent = NULL;
+	}
 }
+#endif
 
 /* Free resources for corresponding eswitch mode. It is called by devlink
  * when changing eswitch mode or modprobe when unloading driver.
  */
 void mlx5_eswitch_disable_locked(struct mlx5_eswitch *esw)
 {
+#ifdef HAVE_DEVLINK_HAS_RATE_FUNCTIONS
 	struct devlink *devlink = priv_to_devlink(esw->dev);
+#endif
 
 	/* Notify eswitch users that it is exiting from current mode.
 	 * So that it can do necessary cleanup before the eswitch is disabled.
@@ -1879,8 +1973,19 @@ void mlx5_eswitch_disable_locked(struct mlx5_eswitch *esw)
 		mlx5_devm_rate_nodes_destroy(esw->dev);
 #endif
 
+#ifdef HAVE_DEVLINK_HAS_RATE_FUNCTIONS
 	if (esw->mode == MLX5_ESWITCH_OFFLOADS)
+#ifdef HAVE_DEVL_PORT_REGISTER
 		devl_rate_nodes_destroy(devlink);
+#else
+		devlink_rate_nodes_destroy(devlink);
+#endif
+
+#ifndef HAVE_DEVL_RATE_NODES_DESTROY_UNSETS_PARENT
+	if (esw->mode == MLX5_ESWITCH_OFFLOADS)
+		mlx5_esw_rate_leaves_null_parent(esw);
+#endif
+#endif
 
 	/* Free leftover per-VF sysfs rate-group nodes. */
 	mlx5_esw_qos_sysfs_nodes_cleanup(esw);
@@ -1897,17 +2002,42 @@ void mlx5_eswitch_disable_locked(struct mlx5_eswitch *esw)
 
 void mlx5_eswitch_disable(struct mlx5_eswitch *esw)
 {
+#ifndef HAVE_DEVL_TRAP_GROUPS_REGISTER
+	struct mlxdevm *mlxdevm;
+#ifdef HAVE_DEVL_PORT_REGISTER
+	struct devlink *devlink;
+#endif
+#endif
+
 	if (!mlx5_esw_allowed(esw))
 		return;
 
+#ifndef HAVE_DEVL_TRAP_GROUPS_REGISTER
+	mlxdevm = &mlx5_devm_device_get(esw->dev)->device;
+#endif
+
+#ifdef HAVE_DEVL_TRAP_GROUPS_REGISTER
 	devl_assert_locked(priv_to_devlink(esw->dev));
+#endif
 	mlx5_lag_disable_change(esw->dev);
-
+#ifndef HAVE_DEVL_TRAP_GROUPS_REGISTER
+#ifdef HAVE_DEVL_PORT_REGISTER
+	devlink = priv_to_devlink(esw->dev);
+	devl_lock(devlink);
+#endif
+	devm_lock(mlxdevm);
+#endif
 	mlx5_esw_reps_block(esw);
 	mlx5_eswitch_disable_locked(esw);
 	mlx5_esw_reps_unblock(esw);
 
 	esw->mode = MLX5_ESWITCH_LEGACY;
+#ifndef HAVE_DEVL_TRAP_GROUPS_REGISTER
+	devm_unlock(mlxdevm);
+#ifdef HAVE_DEVL_PORT_REGISTER
+	devl_unlock(devlink);
+#endif
+#endif
 	mlx5_lag_enable_change(esw->dev);
 }
 
@@ -2084,9 +2214,14 @@ err:
 	return err;
 }
 
+#if defined(HAVE_DEVLINK_PARAMS_PUBLISHED) || defined(HAVE_DEVLINK_REGISTER_GET_1_PARAMS)
 static int mlx5_devlink_esw_multiport_set(struct devlink *devlink, u32 id,
+#ifdef HAVE_DEVLINK_PARAM_SET_FUNCTION_POINTER_HAS_EXTACK
 					  struct devlink_param_gset_ctx *ctx,
 					  struct netlink_ext_ack *extack)
+#else
+					  struct devlink_param_gset_ctx *ctx)
+#endif
 {
 	struct mlx5_core_dev *dev = devlink_priv(devlink);
 
@@ -2101,8 +2236,12 @@ static int mlx5_devlink_esw_multiport_set(struct devlink *devlink, u32 id,
 }
 
 static int mlx5_devlink_esw_multiport_get(struct devlink *devlink, u32 id,
+#ifdef HAVE_DEVLINK_PARAM_GET_FUNCTION_POINTER_HAS_EXTACK
 					  struct devlink_param_gset_ctx *ctx,
 					  struct netlink_ext_ack *extack)
+#else
+					  struct devlink_param_gset_ctx *ctx)
+#endif
 {
 	struct mlx5_core_dev *dev = devlink_priv(devlink);
 
@@ -2117,6 +2256,22 @@ static const struct devlink_param mlx5_eswitch_params[] = {
 			     mlx5_devlink_esw_multiport_get,
 			     mlx5_devlink_esw_multiport_set, NULL),
 };
+#endif
+
+#if (defined(HAVE_DEVLINK_PARAMS_PUBLISHED) || defined(HAVE_DEVLINK_REGISTER_GET_1_PARAMS)) && !defined(HAVE_DEVL_PARAM_DRIVERINIT_VALUE_GET)
+int mlx5_register_eswitch_params(struct mlx5_core_dev *dev)
+{
+
+	return  devlink_params_register(priv_to_devlink(dev), mlx5_eswitch_params,
+					ARRAY_SIZE(mlx5_eswitch_params));
+}
+
+void mlx5_unregister_eswitch_params(struct mlx5_core_dev *dev)
+{
+	devlink_params_unregister(priv_to_devlink(dev), mlx5_eswitch_params,
+				  ARRAY_SIZE(mlx5_eswitch_params));
+}
+#endif
 
 static int mlx5_devm_esw_multiport_set(struct mlxdevm *mlxdevm, u32 id,
 				       struct mlxdevm_param_gset_ctx *ctx,
@@ -2183,13 +2338,21 @@ int mlx5_eswitch_init(struct mlx5_core_dev *dev)
 	if (!esw)
 		return -ENOMEM;
 
+#ifdef HAVE_DEVL_PARAM_DRIVERINIT_VALUE_GET
 	err = devl_params_register(priv_to_devlink(dev), mlx5_eswitch_params,
 				   ARRAY_SIZE(mlx5_eswitch_params));
 	if (err)
 		goto free_esw;
+#endif
 
+#ifndef HAVE_DEVL_TRAP_GROUPS_REGISTER
+	devm_lock(&mlx5_devm_device_get(dev)->device);
+#endif
 	err = devm_params_register(&mlx5_devm_device_get(dev)->device, mlx5_devm_eswitch_params,
 				   ARRAY_SIZE(mlx5_devm_eswitch_params));
+#ifndef HAVE_DEVL_TRAP_GROUPS_REGISTER
+	devm_unlock(&mlx5_devm_device_get(dev)->device);
+#endif
 	if (err)
 		goto err_mlxdevm_params;
 
@@ -2254,12 +2417,20 @@ abort:
 	if (esw->work_queue)
 		destroy_workqueue(esw->work_queue);
 	debugfs_remove_recursive(esw->debugfs_root);
+#ifndef HAVE_DEVL_TRAP_GROUPS_REGISTER
+	devm_lock(&mlx5_devm_device_get(dev)->device);
+#endif
 	devm_params_unregister(&mlx5_devm_device_get(dev)->device, mlx5_devm_eswitch_params,
 			       ARRAY_SIZE(mlx5_devm_eswitch_params));
+#ifndef HAVE_DEVL_TRAP_GROUPS_REGISTER
+	devm_unlock(&mlx5_devm_device_get(dev)->device);
+#endif
 err_mlxdevm_params:
+#ifdef HAVE_DEVL_PARAM_DRIVERINIT_VALUE_GET
 	devl_params_unregister(priv_to_devlink(dev), mlx5_eswitch_params,
 			       ARRAY_SIZE(mlx5_eswitch_params));
 free_esw:
+#endif /* HAVE_DEVL_PARAM_DRIVERINIT_VALUE_GET */
 	dev->priv.eswitch = NULL;
 	kfree(esw);
 	return err;
@@ -2331,10 +2502,18 @@ void mlx5_eswitch_cleanup(struct mlx5_eswitch *esw)
 	esw->dev->priv.eswitch = NULL;
 	mlx5_esw_vports_cleanup(esw);
 	debugfs_remove_recursive(esw->debugfs_root);
+#ifndef HAVE_DEVL_TRAP_GROUPS_REGISTER
+	devm_lock(&mlx5_devm_device_get(esw->dev)->device);
+#endif
 	devm_params_unregister(&mlx5_devm_device_get(esw->dev)->device, mlx5_devm_eswitch_params,
 			       ARRAY_SIZE(mlx5_devm_eswitch_params));
+#ifndef HAVE_DEVL_TRAP_GROUPS_REGISTER
+	devm_unlock(&mlx5_devm_device_get(esw->dev)->device);
+#endif
+#ifdef HAVE_DEVL_PARAM_DRIVERINIT_VALUE_GET
 	devl_params_unregister(priv_to_devlink(esw->dev), mlx5_eswitch_params,
 			       ARRAY_SIZE(mlx5_eswitch_params));
+#endif
 	kfree(esw);
 }
 
