@@ -835,22 +856,45 @@ static void ipoib_napi_enable(struct net
 {
 	struct ipoib_dev_priv *priv = ipoib_priv(dev);
 
+#ifdef HAVE_NETDEV_LOCK_OPS_TO_FULL
+	/* Newer kernels (6.15+): netdev instance locking API */
 	netdev_lock_ops_to_full(dev);
+#endif
+#ifdef HAVE_NETDEV_LOCK_OPS_TO_FULL
+	/* Newer kernels (6.15+): napi enable with lock held */
 	napi_enable_locked(&priv->recv_napi);
 	napi_enable_locked(&priv->send_napi);
+#else
+	/* Older kernels: regular napi enable */
+	napi_enable(&priv->recv_napi);
+	napi_enable(&priv->send_napi);
+#endif
+#ifdef HAVE_NETDEV_LOCK_OPS_TO_FULL
 	netdev_unlock_full_to_ops(dev);
+#endif
 }
 
 static void ipoib_napi_disable(struct net_device *dev)
 {
 	struct ipoib_dev_priv *priv = ipoib_priv(dev);
 
+#ifdef HAVE_NETDEV_LOCK_OPS_TO_FULL
+	/* Newer kernels (6.15+): netdev instance locking API */
 	netdev_lock_ops_to_full(dev);
+#endif
+#ifdef HAVE_NETDEV_LOCK_OPS_TO_FULL
+	/* Newer kernels (6.15+): napi disable with lock held */
 	napi_disable_locked(&priv->recv_napi);
 	napi_disable_locked(&priv->send_napi);
+#else
+	/* Older kernels: regular napi disable */
+	napi_disable(&priv->recv_napi);
+	napi_disable(&priv->send_napi);
+#endif
+#ifdef HAVE_NETDEV_LOCK_OPS_TO_FULL
 	netdev_unlock_full_to_ops(dev);
+#endif
 }
