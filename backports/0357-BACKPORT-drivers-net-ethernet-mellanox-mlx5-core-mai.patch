From: Valentine Fatiev <valentinef@nvidia.com>
Subject: [PATCH] BACKPORT: drivers/net/ethernet/mellanox/mlx5/core/main.c

Change-Id: I5f1d73d02a755b23f8e745418830ce52d2b9a239
---
 .../net/ethernet/mellanox/mlx5/core/main.c    | 210 ++++++++++++++++--
 1 file changed, 197 insertions(+), 13 deletions(-)

diff --git a/drivers/net/ethernet/mellanox/mlx5/core/main.c b/drivers/net/ethernet/mellanox/mlx5/core/main.c
index xxxxxxx..xxxxxxx 100644
--- a/drivers/net/ethernet/mellanox/mlx5/core/main.c
+++ b/drivers/net/ethernet/mellanox/mlx5/core/main.c
@@ -621,13 +621,18 @@ set:
 	return err;
 }
 
+#ifdef HAVE_DEVLINK_PARAM_GENERIC_ID_ENABLE_ETH
 static int max_uc_list_get_devlink_param(struct mlx5_core_dev *dev)
 {
 	struct devlink *devlink = priv_to_devlink(dev);
 	union devlink_param_value val;
 	int err;
 
+#ifdef HAVE_DEVL_PARAM_DRIVERINIT_VALUE_GET
 	err = devl_param_driverinit_value_get(devlink,
+#else
+        err = devlink_param_driverinit_value_get(devlink,
+#endif
 					      DEVLINK_PARAM_GENERIC_ID_MAX_MACS,
 					      &val);
 	if (!err)
@@ -635,14 +640,20 @@ static int max_uc_list_get_devlink_param(struct mlx5_core_dev *dev)
 	mlx5_core_dbg(dev, "Failed to get param. err = %d\n", err);
 	return err;
 }
+#endif
 
 bool mlx5_is_roce_on(struct mlx5_core_dev *dev)
 {
+#if defined(HAVE_DEVLINK_PARAM_GENERIC_ID_ENABLE_ROCE)
 	struct devlink *devlink = priv_to_devlink(dev);
 	union devlink_param_value val;
 	int err;
 
+#ifdef HAVE_DEVL_PARAM_DRIVERINIT_VALUE_GET
 	err = devl_param_driverinit_value_get(devlink,
+#else
+	err = devlink_param_driverinit_value_get(devlink,
+#endif
 					      DEVLINK_PARAM_GENERIC_ID_ENABLE_ROCE,
 					      &val);
 
@@ -651,6 +662,9 @@ bool mlx5_is_roce_on(struct mlx5_core_dev *dev)
 
 	mlx5_core_dbg(dev, "Failed to get param. err = %d\n", err);
 	return MLX5_CAP_GEN(dev, roce);
+#else
+	return MLX5_CAP_GEN(dev, roce) && dev->roce.enabled;
+#endif
 }
 EXPORT_SYMBOL(mlx5_is_roce_on);
 
@@ -690,7 +704,9 @@ static int handle_hca_cap(struct mlx5_core_dev *dev, void *set_ctx)
 {
 	struct mlx5_profile *prof = &dev->profile;
 	void *set_hca_cap;
+#ifdef HAVE_DEVLINK_PARAM_GENERIC_ID_ENABLE_ETH
 	int max_uc_list;
+#endif
 	int err;
 
 	err = mlx5_core_get_caps(dev, MLX5_CAP_GENERAL);
@@ -771,18 +787,24 @@ static int handle_hca_cap(struct mlx5_core_dev *dev, void *set_ctx)
 
 	mlx5_vhca_state_cap_handle(dev, set_hca_cap);
 
+#ifdef HAVE_SRIOV_GET_SET_MSIX_VEC_COUNT
 	if (MLX5_CAP_GEN_MAX(dev, num_total_dynamic_vf_msix))
 		MLX5_SET(cmd_hca_cap, set_hca_cap, num_total_dynamic_vf_msix,
 			 MLX5_CAP_GEN_MAX(dev, num_total_dynamic_vf_msix));
+#endif
 
+#if defined(HAVE_DEVLINK_PARAM_GENERIC_ID_ENABLE_ROCE)
 	if (MLX5_CAP_GEN(dev, roce_rw_supported) && MLX5_CAP_GEN_MAX(dev, roce))
 		MLX5_SET(cmd_hca_cap, set_hca_cap, roce,
 			 mlx5_is_roce_on(dev));
+#endif
 
+#ifdef HAVE_DEVLINK_PARAM_GENERIC_ID_ENABLE_ETH
 	max_uc_list = max_uc_list_get_devlink_param(dev);
 	if (max_uc_list > 0)
 		MLX5_SET(cmd_hca_cap, set_hca_cap, log_max_current_uc_list,
 			 ilog2(max_uc_list));
+#endif
 
 	/* enable absolute native port num */
 	if (MLX5_CAP_GEN_MAX(dev, abs_native_port_num))
@@ -807,8 +829,12 @@ static int handle_hca_cap(struct mlx5_core_dev *dev, void *set_ctx)
  */
 static bool is_roce_fw_disabled(struct mlx5_core_dev *dev)
 {
+#if defined(HAVE_DEVLINK_PARAM_GENERIC_ID_ENABLE_ROCE)
 	return (MLX5_CAP_GEN(dev, roce_rw_supported) && !mlx5_is_roce_on(dev)) ||
 		(!MLX5_CAP_GEN(dev, roce_rw_supported) && !MLX5_CAP_GEN(dev, roce));
+#else
+	return !MLX5_CAP_GEN(dev, roce);
+#endif
 }
 
 static int handle_hca_cap_roce(struct mlx5_core_dev *dev, void *set_ctx)
@@ -1028,6 +1054,9 @@ static ssize_t mlx5_roce_enable_show_enabled(struct device *device,
 	struct mlx5_core_dev *dev = pci_get_drvdata(pdev);
 	int ret;
 
+#if defined(HAVE_DEVLINK_PARAM_GENERIC_ID_ENABLE_ROCE)
+	return -EOPNOTSUPP;
+#endif
 	mutex_lock(&dev->roce.state_lock);
 	ret = dev->roce.enabled;
 	mutex_unlock(&dev->roce.state_lock);
@@ -1041,11 +1070,12 @@ static ssize_t mlx5_roce_enable_set_enabled(struct device *device,
 {
 	struct pci_dev *pdev = container_of(device, struct pci_dev, dev);
 	struct mlx5_core_dev *dev = pci_get_drvdata(pdev);
-	struct devlink *devlink = priv_to_devlink(dev);
-	union devlink_param_value value;
 	int ret;
 	bool val;
 
+#if defined(HAVE_DEVLINK_PARAM_GENERIC_ID_ENABLE_ROCE)
+	return -EOPNOTSUPP;
+#endif
 	ret = kstrtobool(buf, &val);
 	if (ret)
 		return -EINVAL;
@@ -1053,15 +1083,13 @@ static ssize_t mlx5_roce_enable_set_enabled(struct device *device,
 	if (val && !MLX5_CAP_GEN(dev, roce))
 		return -EOPNOTSUPP;
 
+	if (mlx5_core_is_mp_slave(dev) || mlx5_lag_is_active(dev))
+		return -EOPNOTSUPP;
+
 	mutex_lock(&dev->roce.state_lock);
 	dev->roce.enabled = val;
-	value.vbool = val;
-	devl_param_driverinit_value_set(devlink,
-			DEVLINK_PARAM_GENERIC_ID_ENABLE_ROCE,
-			value);
 	mutex_unlock(&dev->roce.state_lock);
-
-	return count;
+	return (ret != 0 ? ret : count);
 }
 
 static DEVICE_ATTR(roce_enable, 0644, mlx5_roce_enable_show_enabled,
@@ -1115,7 +1143,13 @@ static int mlx5_pci_init(struct mlx5_core_dev *dev, struct pci_dev *pdev,
 
 	mlx5_pci_vsc_init(dev);
 
+#ifdef HAVE_PCI_ENABLE_PTM_GET_1_PARAM
+/* Newer kernels (7.1+): granularity parameter removed */
+	pci_enable_ptm(pdev);
+#else
+/* Older kernels: granularity parameter */
 	pci_enable_ptm(pdev, NULL);
+#endif
 
 	return 0;
 
@@ -1146,7 +1180,9 @@ static void mlx5_pci_close(struct mlx5_core_dev *dev)
 static int mlx5_init_once(struct mlx5_core_dev *dev)
 {
 	int err;
+#ifdef HAVE_DEVL_TRAP_GROUPS_REGISTER
 	struct mlxdevm *devm;
+#endif
 
 	dev->priv.devc = mlx5_devcom_register_device(dev);
 	if (!dev->priv.devc)
@@ -1180,8 +1216,10 @@ static int mlx5_init_once(struct mlx5_core_dev *dev)
 	if (err)
 		goto err_devm;
 
+#ifdef HAVE_DEVL_TRAP_GROUPS_REGISTER
 	devm = &mlx5_devm_device_get(dev)->device;
 	devm_lock(devm);
+#endif
 
 	err = mlx5_fw_reset_init(dev);
 	if (err) {
@@ -1320,7 +1358,9 @@ err_devcom:
 
 static void mlx5_cleanup_once(struct mlx5_core_dev *dev)
 {
+#ifdef HAVE_DEVL_TRAP_GROUPS_REGISTER
 	struct mlxdevm *devm = &mlx5_devm_device_get(dev)->device;
+#endif
 	mlx5_rsc_dump_destroy(dev);
 	mlx5_hv_vhca_destroy(dev->hv_vhca);
 	mlx5_fw_tracer_destroy(dev->tracer);
@@ -1343,7 +1383,9 @@ static void mlx5_cleanup_once(struct mlx5_core_dev *dev)
 	mlx5_cleanup_reserved_gids(dev);
 	mlx5_cq_debugfs_cleanup(dev);
 	mlx5_fw_reset_cleanup(dev);
+#ifdef HAVE_DEVL_TRAP_GROUPS_REGISTER
 	devm_unlock(devm);
+#endif
 	mlx5_devm_unregister(dev);
 	mlx5_events_cleanup(dev);
 	mlx5_eq_table_cleanup(dev);
@@ -1677,10 +1719,18 @@ static void mlx5_unload(struct mlx5_core_dev *dev)
 	mlx5_free_bfreg(dev, &dev->priv.bfreg);
 }
 
+#ifdef HAVE_DEVL_TRAP_GROUPS_REGISTER
 int mlx5_init_one_devl_locked(struct mlx5_core_dev *dev)
+#else
+int mlx5_init_one(struct mlx5_core_dev *dev)
+#endif
 {
+#if defined(HAVE_LIGHT_SFS)
 	bool light_probe = mlx5_dev_is_lightweight(dev);
+#endif
+#ifdef HAVE_DEVL_TRAP_GROUPS_REGISTER
 	struct mlxdevm *devm;
+#endif
 	int err = 0;
 
 	mutex_lock(&dev->intf_state_mutex);
@@ -1700,13 +1750,30 @@ int mlx5_init_one_devl_locked(struct mlx5_core_dev *dev)
 	/* In case of light_probe, mlx5_devlink is already registered.
 	 * Hence, don't register devlink again.
 	 */
+#if defined(HAVE_LIGHT_SFS)
 	if (!light_probe) {
+#endif
+#ifdef HAVE_DEVLINK_REGISTER_GET_1_PARAMS
 		err = mlx5_devlink_params_register(priv_to_devlink(dev));
+#else
+		err = mlx5_devlink_params_register(priv_to_devlink(dev), dev->device);
+#endif
 		if (err)
 			goto err_devlink_params_reg;
+#if defined(HAVE_LIGHT_SFS)
 	}
+#endif
 
+#ifdef HAVE_DEVLINK_SET_FEATURES
+	devlink_set_features(priv_to_devlink(dev), DEVLINK_F_RELOAD);
+#endif
+#ifndef HAVE_DEVL_TRAP_GROUPS_REGISTER
+	devm_lock(&mlx5_devm_device_get(dev)->device);
+#endif
 	err = mlx5_devm_params_register(&mlx5_devm_device_get(dev)->device);
+#ifndef HAVE_DEVL_TRAP_GROUPS_REGISTER
+	devm_unlock(&mlx5_devm_device_get(dev)->device);
+#endif
 	if (err)
 		goto err_mlxdevm_params_reg;
 
@@ -1714,8 +1781,11 @@ int mlx5_init_one_devl_locked(struct mlx5_core_dev *dev)
 	if (err)
 		goto err_load;
 
+#ifdef HAVE_DEVL_TRAP_GROUPS_REGISTER
 	devm = &mlx5_devm_device_get(dev)->device;
 	devm_unlock(devm);
+#endif
+
 	set_bit(MLX5_INTERFACE_STATE_UP, &dev->intf_state);
 
 	err = mlx5_register_device(dev);
@@ -1739,7 +1809,9 @@ err_register:
 err_load:
 	mlx5_devm_params_unregister(&mlx5_devm_device_get(dev)->device);
 err_mlxdevm_params_reg:
+#if defined(HAVE_LIGHT_SFS)
 	if (!light_probe)
+#endif
 		mlx5_devlink_params_unregister(priv_to_devlink(dev));
 err_devlink_params_reg:
 	mlx5_cleanup_once(dev);
@@ -1751,28 +1823,38 @@ err_function:
 	return err;
 }
 
+#ifdef HAVE_DEVL_TRAP_GROUPS_REGISTER
 int mlx5_init_one(struct mlx5_core_dev *dev)
 {
 	struct devlink *devlink = priv_to_devlink(dev);
 	int err;
 
 	devl_lock(devlink);
+#if defined(HAVE_DEVL_REGISTER)
 	devl_register(devlink);
+#endif
 	err = mlx5_init_one_devl_locked(dev);
+#if defined(HAVE_DEVL_REGISTER)
 	if (err)
 		devl_unregister(devlink);
+#endif
 	devl_unlock(devlink);
 	return err;
 }
+#endif
 
 void mlx5_uninit_one(struct mlx5_core_dev *dev)
 {
 	struct mlxdevm *devm = &mlx5_devm_device_get(dev)->device;
+#ifdef HAVE_DEVL_TRAP_GROUPS_REGISTER
 	struct devlink *devlink = priv_to_devlink(dev);
 
 	devl_lock(devlink);
+#endif
 	mutex_lock(&dev->intf_state_mutex);
+#ifdef HAVE_DEVL_TRAP_GROUPS_REGISTER
 	devm_lock(devm);
+#endif
 
 	mlx5_hwmon_dev_unregister(dev);
 	mlx5_crdump_disable(dev);
@@ -1781,7 +1863,13 @@ void mlx5_uninit_one(struct mlx5_core_dev *dev)
 	if (!test_bit(MLX5_INTERFACE_STATE_UP, &dev->intf_state)) {
 		mlx5_core_warn(dev, "%s: interface is down, NOP\n",
 			       __func__);
+#ifndef HAVE_DEVL_TRAP_GROUPS_REGISTER
+		devm_lock(devm);
+#endif
 		mlx5_devm_params_unregister(&mlx5_devm_device_get(dev)->device);
+#ifndef HAVE_DEVL_TRAP_GROUPS_REGISTER
+		devm_unlock(devm);
+#endif
 		mlx5_devlink_params_unregister(priv_to_devlink(dev));
 		mlx5_cleanup_once(dev);
 		goto out;
@@ -1789,23 +1877,41 @@ void mlx5_uninit_one(struct mlx5_core_dev *dev)
 
 	clear_bit(MLX5_INTERFACE_STATE_UP, &dev->intf_state);
 	mlx5_unload(dev);
+#ifndef HAVE_DEVL_TRAP_GROUPS_REGISTER
+	devm_lock(devm);
+#endif
 	mlx5_devm_params_unregister(&mlx5_devm_device_get(dev)->device);
+#ifndef HAVE_DEVL_TRAP_GROUPS_REGISTER
+	devm_unlock(devm);
+#endif
 	mlx5_devlink_params_unregister(priv_to_devlink(dev));
 	mlx5_cleanup_once(dev);
 	mlx5_function_teardown(dev, true);
 out:
 	mutex_unlock(&dev->intf_state_mutex);
+#if defined(HAVE_DEVL_REGISTER)
 	devl_unregister(devlink);
+#endif
+#ifdef HAVE_DEVL_TRAP_GROUPS_REGISTER
 	devl_unlock(devlink);
+#endif
 }
 
+#ifdef HAVE_DEVL_TRAP_GROUPS_REGISTER
 int mlx5_load_one_devl_locked(struct mlx5_core_dev *dev, bool recovery)
+#else
+int mlx5_load_one(struct mlx5_core_dev *dev, bool recovery)
+#endif
 {
+#ifdef HAVE_DEVL_TRAP_GROUPS_REGISTER
 	struct mlxdevm *devm;
+#endif
 	int err = 0;
 	u64 timeout;
 
+#ifdef HAVE_DEVL_TRAP_GROUPS_REGISTER
 	devl_assert_locked(priv_to_devlink(dev));
+#endif
 	mutex_lock(&dev->intf_state_mutex);
 	if (test_bit(MLX5_INTERFACE_STATE_UP, &dev->intf_state)) {
 		mlx5_core_warn(dev, "interface is up, NOP\n");
@@ -1822,10 +1928,14 @@ int mlx5_load_one_devl_locked(struct mlx5_core_dev *dev, bool recovery)
 	if (err)
 		goto err_function;
 
+#ifdef HAVE_DEVL_TRAP_GROUPS_REGISTER
 	devm = &mlx5_devm_device_get(dev)->device;
 	devm_lock(devm);
+#endif
 	err = mlx5_load(dev);
+#ifdef HAVE_DEVL_TRAP_GROUPS_REGISTER
 	devm_unlock(devm);
+#endif
 	if (err)
 		goto err_load;
 
@@ -1850,6 +1960,7 @@ out:
 	return err;
 }
 
+#ifdef HAVE_DEVL_TRAP_GROUPS_REGISTER
 int mlx5_load_one(struct mlx5_core_dev *dev, bool recovery)
 {
 	struct devlink *devlink = priv_to_devlink(dev);
@@ -1860,11 +1971,18 @@ int mlx5_load_one(struct mlx5_core_dev *dev, bool recovery)
 	devl_unlock(devlink);
 	return ret;
 }
-
+#endif
+ 
+#ifdef HAVE_DEVL_TRAP_GROUPS_REGISTER
 void mlx5_unload_one_devl_locked(struct mlx5_core_dev *dev, bool suspend)
+#else
+void mlx5_unload_one(struct mlx5_core_dev *dev, bool suspend)
+#endif
 {
+#ifdef HAVE_DEVL_TRAP_GROUPS_REGISTER
 	struct mlxdevm *devm;
 	devl_assert_locked(priv_to_devlink(dev));
+#endif
 	mutex_lock(&dev->intf_state_mutex);
 
 	mlx5_detach_device(dev, suspend);
@@ -1876,15 +1994,20 @@ void mlx5_unload_one_devl_locked(struct mlx5_core_dev *dev, bool suspend)
 	}
 
 	clear_bit(MLX5_INTERFACE_STATE_UP, &dev->intf_state);
+#ifdef HAVE_DEVL_TRAP_GROUPS_REGISTER
 	devm = &mlx5_devm_device_get(dev)->device;
 	devm_lock(devm);
+#endif
 	mlx5_unload(dev);
+#ifdef HAVE_DEVL_TRAP_GROUPS_REGISTER
 	devm_unlock(devm);
+#endif
 	mlx5_function_teardown(dev, false);
 out:
 	mutex_unlock(&dev->intf_state_mutex);
 }
 
+#ifdef HAVE_DEVL_TRAP_GROUPS_REGISTER
 void mlx5_unload_one(struct mlx5_core_dev *dev, bool suspend)
 {
 	struct devlink *devlink = priv_to_devlink(dev);
@@ -1893,7 +2016,9 @@ void mlx5_unload_one(struct mlx5_core_dev *dev, bool suspend)
 	mlx5_unload_one_devl_locked(dev, suspend);
 	devl_unlock(devlink);
 }
+#endif
 
+#if defined(HAVE_LIGHT_SFS)
 /* In case of light probe, we don't need a full query of hca_caps, but only the bellow caps.
  * A full query of hca_caps will be done when the device will reload.
  */
@@ -1933,11 +2058,17 @@ static int mlx5_query_hca_caps_light(struct mlx5_core_dev *dev)
 
 int mlx5_init_one_light(struct mlx5_core_dev *dev)
 {
+#ifdef HAVE_DEVL_TRAP_GROUPS_REGISTER
 	struct devlink *devlink = priv_to_devlink(dev);
+#endif
 	int err;
 
+#ifdef HAVE_DEVL_TRAP_GROUPS_REGISTER
 	devl_lock(devlink);
+#endif
+#if defined(HAVE_DEVL_REGISTER)
 	devl_register(devlink);
+#endif
 	dev->state = MLX5_DEVICE_STATE_UP;
 	err = mlx5_function_enable(dev, true, mlx5_tout_ms(dev, FW_PRE_INIT_TIMEOUT));
 	if (err) {
@@ -1951,32 +2082,48 @@ int mlx5_init_one_light(struct mlx5_core_dev *dev)
 		goto query_hca_caps_err;
 	}
 
+#ifdef HAVE_DEVLINK_REGISTER_GET_1_PARAMS
 	err = mlx5_devlink_params_register(priv_to_devlink(dev));
+#else
+	err = mlx5_devlink_params_register(priv_to_devlink(dev), dev->device);
+#endif
 	if (err) {
 		mlx5_core_warn(dev, "mlx5_devlink_param_reg err = %d\n", err);
 		goto query_hca_caps_err;
 	}
 
+#ifdef HAVE_DEVL_TRAP_GROUPS_REGISTER
 	devl_unlock(devlink);
+#endif
 	return 0;
 
 query_hca_caps_err:
 	mlx5_function_disable(dev, true);
 out:
 	dev->state = MLX5_DEVICE_STATE_INTERNAL_ERROR;
+#if defined(HAVE_DEVL_REGISTER)
 	devl_unregister(devlink);
+#endif
+#ifdef HAVE_DEVL_TRAP_GROUPS_REGISTER
 	devl_unlock(devlink);
+#endif
 	return err;
 }
 
 void mlx5_uninit_one_light(struct mlx5_core_dev *dev)
 {
+#ifdef HAVE_DEVL_TRAP_GROUPS_REGISTER
 	struct devlink *devlink = priv_to_devlink(dev);
 
 	devl_lock(devlink);
+#endif
 	mlx5_devlink_params_unregister(priv_to_devlink(dev));
+#if defined(HAVE_DEVL_REGISTER)
 	devl_unregister(devlink);
+#endif
+#ifdef HAVE_DEVL_TRAP_GROUPS_REGISTER
 	devl_unlock(devlink);
+#endif
 	if (dev->state != MLX5_DEVICE_STATE_UP)
 		return;
 	mlx5_function_disable(dev, true);
@@ -1994,6 +2141,7 @@ void mlx5_unload_one_light(struct mlx5_core_dev *dev)
 	mlx5_function_disable(dev, false);
 	dev->state = MLX5_DEVICE_STATE_INTERNAL_ERROR;
 }
+#endif
 
 static const int types[] = {
 	MLX5_CAP_GENERAL,
@@ -2180,8 +2328,11 @@ void mlx5_mdev_uninit(struct mlx5_core_dev *dev)
 
 static int probe_one(struct pci_dev *pdev, const struct pci_device_id *id)
 {
-	struct mlx5_core_dev *dev;
+	struct mlx5_core_dev *dev = NULL;
 	struct devlink *devlink;
+#ifdef HAVE_BASECODE_EXTRAS
+	struct mlx5_priv *priv;
+#endif
 	int err;
 
 	devlink = mlx5_devlink_alloc(&pdev->dev);
@@ -2191,10 +2342,13 @@ static int probe_one(struct pci_dev *pdev, const struct pci_device_id *id)
 	}
 
 	err = device_create_file(&pdev->dev, mlx5_roce_enable_dev_attrs);
-	if (err) 
+	if (err)
 		goto remove_roce_file;
 
 	dev = devlink_priv(devlink);
+#ifdef HAVE_BASECODE_EXTRAS
+	priv = &dev->priv;
+#endif
 	dev->device = &pdev->dev;
 	dev->pdev = pdev;
 
@@ -2234,6 +2388,13 @@ static int probe_one(struct pci_dev *pdev, const struct pci_device_id *id)
 	mlx5_vhca_debugfs_init(dev);
 
 	pci_save_state(pdev);
+#if defined(HAVE_DEVLINK_REGISTER_GET_1_PARAMS) && !defined(HAVE_DEVL_REGISTER)
+	devlink_register(devlink);
+#endif
+#if defined(HAVE_DEVLINK_RELOAD_ENABLE) && !defined(HAVE_DEVLINK_SET_FEATURES)
+       if (!mlx5_core_is_mp_slave(dev))
+	       devlink_reload_enable(devlink);
+#endif
 	return 0;
 
 err_init_one:
@@ -2254,12 +2415,23 @@ remove_roce_file:
 
 static void remove_one(struct pci_dev *pdev)
 {
-	struct mlx5_core_dev *dev  = pci_get_drvdata(pdev);
-	struct devlink *devlink = priv_to_devlink(dev);
+	struct mlx5_core_dev *dev;
+	struct devlink *devlink;
+	struct mlx5_priv *priv;
+
+	dev  = pci_get_drvdata(pdev);
+	devlink = priv_to_devlink(dev);
+	priv = &dev->priv;
 
 	set_bit(MLX5_BREAK_FW_WAIT, &dev->intf_state);
 	mlx5_drain_fw_reset(dev);
 	mlx5_drain_health_wq(dev);
+#if defined(HAVE_DEVLINK_RELOAD_DISABLE) && !defined(HAVE_DEVLINK_SET_FEATURES)
+	devlink_reload_disable(devlink);
+#endif
+#if defined(HAVE_DEVLINK_REGISTER_GET_1_PARAMS) && !defined(HAVE_DEVL_REGISTER)
