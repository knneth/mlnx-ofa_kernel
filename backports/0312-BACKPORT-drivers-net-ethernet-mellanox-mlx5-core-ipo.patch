From: Valentine Fatiev <valentinef@nvidia.com>
Subject: [PATCH] BACKPORT:
 drivers/net/ethernet/mellanox/mlx5/core/ipoib/ethtool.c

Change-Id: Idba266bb8468633c0e1bc1a6181ba681b4fc4d92
---
 .../mellanox/mlx5/core/ipoib/ethtool.c        | 72 +++++++++++++++++--
 1 file changed, 68 insertions(+), 4 deletions(-)

diff --git a/drivers/net/ethernet/mellanox/mlx5/core/ipoib/ethtool.c b/drivers/net/ethernet/mellanox/mlx5/core/ipoib/ethtool.c
index xxxxxxx..xxxxxxx 100644
--- a/drivers/net/ethernet/mellanox/mlx5/core/ipoib/ethtool.c
+++ b/drivers/net/ethernet/mellanox/mlx5/core/ipoib/ethtool.c
@@ -40,7 +40,7 @@ static void mlx5i_get_drvinfo(struct net_device *dev,
 	struct mlx5e_priv *priv = mlx5i_epriv(dev);
 
 	mlx5e_ethtool_get_drvinfo(priv, drvinfo);
-	strscpy(drvinfo->driver, KBUILD_MODNAME "[ib_ipoib]",
+        strscpy(drvinfo->driver, KBUILD_MODNAME "[ib_ipoib]",
 		sizeof(drvinfo->driver));
 }
 
@@ -68,23 +68,42 @@ static void mlx5i_get_ethtool_stats(struct net_device *dev,
 }
 
 static int mlx5i_set_ringparam(struct net_device *dev,
+#ifdef HAVE_GET_RINGPARAM_GET_4_PARAMS
 			       struct ethtool_ringparam *param,
 			       struct kernel_ethtool_ringparam *kernel_param,
 			       struct netlink_ext_ack *extack)
+#else
+			       struct ethtool_ringparam *param)
+#endif
 {
 	struct mlx5e_priv *priv = mlx5i_epriv(dev);
 
+#ifdef HAVE_GET_RINGPARAM_GET_4_PARAMS
 	return mlx5e_ethtool_set_ringparam(priv, param, extack);
+#else
+	return mlx5e_ethtool_set_ringparam(priv, param, NULL);
+#endif
 }
 
 static void mlx5i_get_ringparam(struct net_device *dev,
+#ifdef HAVE_GET_RINGPARAM_GET_4_PARAMS
 				struct ethtool_ringparam *param,
+#ifdef HAVE_STRUCT_KERNEL_ETHTOOL_RINGPARAM
 				struct kernel_ethtool_ringparam *kernel_param,
+#else
+				struct ethtool_ringparam *param,
+#endif
 				struct netlink_ext_ack *extack)
+#else
+				struct ethtool_ringparam *param)
+#endif
 {
 	struct mlx5e_priv *priv = mlx5i_epriv(dev);
-
+#if defined(HAVE_STRUCT_KERNEL_ETHTOOL_RINGPARAM) && defined(HAVE_GET_RINGPARAM_GET_4_PARAMS)
 	mlx5e_ethtool_get_ringparam(priv, param, kernel_param);
+#else
+	mlx5e_ethtool_get_ringparam(priv, param);
+#endif
 }
 
 static int mlx5i_set_channels(struct net_device *dev,
@@ -116,27 +135,49 @@ static void mlx5i_get_channels(struct net_device *dev,
 }
 
 static int mlx5i_set_coalesce(struct net_device *netdev,
+#ifdef HAVE_NDO_GET_COALESCE_GET_4_PARAMS
 			      struct ethtool_coalesce *coal,
 			      struct kernel_ethtool_coalesce *kernel_coal,
 			      struct netlink_ext_ack *extack)
+#else
+ 			      struct ethtool_coalesce *coal)
+#endif
 {
 	struct mlx5e_priv *priv = mlx5i_epriv(netdev);
 
-	return mlx5e_ethtool_set_coalesce(priv, coal, kernel_coal, extack);
+	return mlx5e_ethtool_set_coalesce(priv,
+#ifdef HAVE_NDO_GET_COALESCE_GET_4_PARAMS
+					  coal, kernel_coal, extack);
+#else
+					  coal);
+#endif
 }
 
 static int mlx5i_get_coalesce(struct net_device *netdev,
+#ifdef HAVE_NDO_GET_COALESCE_GET_4_PARAMS
 			      struct ethtool_coalesce *coal,
 			      struct kernel_ethtool_coalesce *kernel_coal,
 			      struct netlink_ext_ack *extack)
+#else
+ 			      struct ethtool_coalesce *coal)
+#endif
 {
 	struct mlx5e_priv *priv = mlx5i_epriv(netdev);
 
-	return mlx5e_ethtool_get_coalesce(priv, coal, kernel_coal, extack);
+	return mlx5e_ethtool_get_coalesce(priv,
+#ifdef HAVE_NDO_GET_COALESCE_GET_4_PARAMS
+					  coal, kernel_coal, extack);
+#else
+					  coal);
+#endif
 }
 
 static int mlx5i_get_ts_info(struct net_device *netdev,
+#ifdef HAVE_STRUCT_KERNEL_ETHTOOL_TS_INFO
 			     struct kernel_ethtool_ts_info *info)
+#else
+			     struct ethtool_ts_info *info)
+#endif
 {
 	struct mlx5e_priv *priv = mlx5i_epriv(netdev);
 
@@ -238,6 +279,7 @@ static u32 mlx5i_flow_type_mask(u32 flow_type)
 	return flow_type & ~(FLOW_EXT | FLOW_MAC_EXT | FLOW_RSS);
 }
 
+#ifdef HAVE_ETHTOOL_GET_RXFH_FIELDS
 static int mlx5i_set_rxfh_fields(struct net_device *dev,
 				 const struct ethtool_rxfh_fields *cmd,
 				 struct netlink_ext_ack *extack)
@@ -254,6 +296,7 @@ static int mlx5i_get_rxfh_fields(struct net_device *dev,
 
 	return mlx5e_ethtool_get_rxfh_fields(priv, info);
 }
+#endif
 
 static int mlx5i_set_rxnfc(struct net_device *dev, struct ethtool_rxnfc *cmd)
 {
@@ -266,11 +309,21 @@ static int mlx5i_set_rxnfc(struct net_device *dev, struct ethtool_rxnfc *cmd)
 	return mlx5e_ethtool_set_rxnfc(priv, cmd);
 }
 
+#ifdef HAVE_ETHTOOL_OPS_GET_RX_RING_COUNT
+static u32 mlx5i_get_rx_ring_count(struct net_device *dev)
+{
+	struct mlx5e_priv *priv = mlx5i_epriv(dev);
+
+	return priv->channels.params.num_channels;
+}
+#endif
+
 static int mlx5i_get_rxnfc(struct net_device *dev, struct ethtool_rxnfc *info,
 			   u32 *rule_locs)
 {
 	struct mlx5e_priv *priv = mlx5i_epriv(dev);
 
+#ifndef HAVE_ETHTOOL_OPS_GET_RX_RING_COUNT
 	/* ETHTOOL_GRXRINGS is needed by ethtool -x which is not part
 	 * of rxnfc. We keep this logic out of mlx5e_ethtool_get_rxnfc,
 	 * to avoid breaking "ethtool -x" when mlx5e_ethtool_get_rxnfc
@@ -280,14 +333,17 @@ static int mlx5i_get_rxnfc(struct net_device *dev, struct ethtool_rxnfc *info,
 		info->data = priv->channels.params.num_channels;
 		return 0;
 	}
+#endif
 
 	return mlx5e_ethtool_get_rxnfc(priv, info, rule_locs);
 }
 
 const struct ethtool_ops mlx5i_ethtool_ops = {
+#ifdef HAVE_SUPPORTED_COALESCE_PARAM
 	.supported_coalesce_params = ETHTOOL_COALESCE_USECS |
 				     ETHTOOL_COALESCE_MAX_FRAMES |
 				     ETHTOOL_COALESCE_USE_ADAPTIVE,
+#endif
 	.get_drvinfo        = mlx5i_get_drvinfo,
 	.get_strings        = mlx5i_get_strings,
 	.get_sset_count     = mlx5i_get_sset_count,
@@ -300,10 +356,17 @@ const struct ethtool_ops mlx5i_ethtool_ops = {
 	.get_coalesce       = mlx5i_get_coalesce,
 	.set_coalesce       = mlx5i_set_coalesce,
 	.get_ts_info        = mlx5i_get_ts_info,
+#ifdef HAVE_ETHTOOL_GET_RXFH_FIELDS
+	/* Newer kernels (6.17+): dedicated RXFH fields callbacks */
 	.get_rxfh_fields    = mlx5i_get_rxfh_fields,
 	.set_rxfh_fields    = mlx5i_set_rxfh_fields,
+#endif
 	.get_rxnfc          = mlx5i_get_rxnfc,
 	.set_rxnfc          = mlx5i_set_rxnfc,
+#ifdef HAVE_ETHTOOL_OPS_GET_RX_RING_COUNT
+	/* Newer kernels (6.19+): dedicated get_rx_ring_count callbacks */
+	.get_rx_ring_count  = mlx5i_get_rx_ring_count,
+#endif
 	.get_link_ksettings = mlx5i_get_link_ksettings,
 	.get_link           = ethtool_op_get_link,
 };
@@ -312,4 +375,5 @@ const struct ethtool_ops mlx5i_pkey_ethtool_ops = {
 	.get_drvinfo        = mlx5i_get_drvinfo,
 	.get_link           = ethtool_op_get_link,
 	.get_ts_info        = mlx5i_get_ts_info,
+	.get_link_ksettings = mlx5i_get_link_ksettings,
 };
