+#ifndef HAVE_NETLINK_RANGE_VALIDATION
+/* Older kernels (< 5.10): struct netlink_range_validation, NLA_POLICY_FULL_RANGE,
+ * and NLA_UINT missing. Provide compat shims that degrade full-range validation
+ * to a plain U32 type check.
+ */
+struct netlink_range_validation {
+	u64 min;
+	u64 max;
+};
+#ifndef NLA_UINT
+#define NLA_UINT NLA_U32
+#endif
+#ifndef NLA_POLICY_FULL_RANGE
+#define NLA_POLICY_FULL_RANGE(tp, _range) { .type = NLA_U32 }
+#endif
+#endif
+
 /* Integer value ranges */
+#ifdef HAVE_NLA_POLICY_RANGE_CONST
+/* Newer kernels: struct nla_policy .range accepts const pointer */
 static const struct netlink_range_validation mlxdevm_attr_index_range = {
+#else
+/* Older kernels: .range takes non-const pointer (or struct is shimmed above) */
+static struct netlink_range_validation __maybe_unused mlxdevm_attr_index_range = {
+#endif
 	.max	= U32_MAX,
 };
 
