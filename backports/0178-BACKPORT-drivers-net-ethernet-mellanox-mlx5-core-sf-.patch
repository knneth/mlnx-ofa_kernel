From: Valentine Fatiev <valentinef@nvidia.com>
Subject: [PATCH] BACKPORT:
 drivers/net/ethernet/mellanox/mlx5/core/sf/diag/sf_tracepoint.h

---
 .../mlx5/core/sf/diag/sf_tracepoint.h         | 32 +++++++++++++++++++
 1 file changed, 32 insertions(+)

diff --git a/drivers/net/ethernet/mellanox/mlx5/core/sf/diag/sf_tracepoint.h b/drivers/net/ethernet/mellanox/mlx5/core/sf/diag/sf_tracepoint.h
index xxxxxxx..xxxxxxx 100644
--- a/drivers/net/ethernet/mellanox/mlx5/core/sf/diag/sf_tracepoint.h
+++ b/drivers/net/ethernet/mellanox/mlx5/core/sf/diag/sf_tracepoint.h
@@ -15,7 +15,11 @@ TRACE_EVENT(mlx5_sf_host_pf_disabled,
 	    TP_PROTO(const struct mlx5_core_dev *dev),
 	    TP_ARGS(dev),
 	    TP_STRUCT__entry(__string(devname, dev_name(dev->device))),
+#ifdef HAVE_ASSIGN_STR_1_PARAM
 	    TP_fast_assign(__assign_str(devname);),
+#else
+ 	    TP_fast_assign(__assign_str(devname, dev_name(dev->device));),
+#endif
 	    TP_printk("(%s)\n", __get_str(devname))
 );
 
@@ -32,7 +36,11 @@ TRACE_EVENT(mlx5_sf_add,
 			     __field(u16, hw_fn_id)
 			     __field(u32, sfnum)
 			    ),
+#ifdef HAVE_ASSIGN_STR_1_PARAM
 	    TP_fast_assign(__assign_str(devname);
+#else
+ 	    TP_fast_assign(__assign_str(devname, dev_name(dev->device));
+#endif
 		    __entry->port_index = port_index;
 		    __entry->controller = controller;
 		    __entry->hw_fn_id = hw_fn_id;
@@ -54,7 +62,11 @@ TRACE_EVENT(mlx5_sf_free,
 			     __field(u32, controller)
 			     __field(u16, hw_fn_id)
 			    ),
+#ifdef HAVE_ASSIGN_STR_1_PARAM
 	    TP_fast_assign(__assign_str(devname);
+#else
+ 	    TP_fast_assign(__assign_str(devname, dev_name(dev->device));
+#endif
 		    __entry->port_index = port_index;
 		    __entry->controller = controller;
 		    __entry->hw_fn_id = hw_fn_id;
@@ -75,7 +87,11 @@ TRACE_EVENT(mlx5_sf_hwc_alloc,
 			     __field(u16, hw_fn_id)
 			     __field(u32, sfnum)
 			    ),
+#ifdef HAVE_ASSIGN_STR_1_PARAM
 	    TP_fast_assign(__assign_str(devname);
+#else
+ 	    TP_fast_assign(__assign_str(devname, dev_name(dev->device));
+#endif
 		    __entry->controller = controller;
 		    __entry->hw_fn_id = hw_fn_id;
 		    __entry->sfnum = sfnum;
@@ -92,7 +108,11 @@ TRACE_EVENT(mlx5_sf_hwc_free,
 	    TP_STRUCT__entry(__string(devname, dev_name(dev->device))
 			     __field(u16, hw_fn_id)
 			    ),
+#ifdef HAVE_ASSIGN_STR_1_PARAM
 	    TP_fast_assign(__assign_str(devname);
+#else
+ 	    TP_fast_assign(__assign_str(devname, dev_name(dev->device));
+#endif
 		    __entry->hw_fn_id = hw_fn_id;
 	    ),
 	    TP_printk("(%s) hw_id=0x%x\n", __get_str(devname), __entry->hw_fn_id)
@@ -105,7 +125,11 @@ TRACE_EVENT(mlx5_sf_hwc_deferred_free,
 	    TP_STRUCT__entry(__string(devname, dev_name(dev->device))
 			     __field(u16, hw_fn_id)
 			    ),
+#ifdef HAVE_ASSIGN_STR_1_PARAM
 	    TP_fast_assign(__assign_str(devname);
+#else
+	    TP_fast_assign(__assign_str(devname, dev_name(dev->device));
+#endif
 		    __entry->hw_fn_id = hw_fn_id;
 	    ),
 	    TP_printk("(%s) hw_id=0x%x\n", __get_str(devname), __entry->hw_fn_id)
@@ -121,7 +145,11 @@ DECLARE_EVENT_CLASS(mlx5_sf_state_template,
 				     __field(unsigned int, port_index)
 				     __field(u32, controller)
 				     __field(u16, hw_fn_id)),
+#ifdef HAVE_ASSIGN_STR_1_PARAM
 		    TP_fast_assign(__assign_str(devname);
+#else
+		    TP_fast_assign(__assign_str(devname, dev_name(dev->device));
+#endif
 				   __entry->port_index = port_index;
 				   __entry->controller = controller;
 				   __entry->hw_fn_id = hw_fn_id;
@@ -160,7 +188,11 @@ TRACE_EVENT(mlx5_sf_update_state,
 			     __field(u16, hw_fn_id)
 			     __field(u8, state)
 			    ),
+#ifdef HAVE_ASSIGN_STR_1_PARAM
 	    TP_fast_assign(__assign_str(devname);
+#else
+	    TP_fast_assign(__assign_str(devname, dev_name(dev->device));
+#endif
 		    __entry->port_index = port_index;
 		    __entry->controller = controller;
 		    __entry->hw_fn_id = hw_fn_id;
