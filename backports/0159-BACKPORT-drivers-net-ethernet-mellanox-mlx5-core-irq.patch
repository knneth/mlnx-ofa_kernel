From: Valentine Fatiev <valentinef@nvidia.com>
Subject: [PATCH] BACKPORT:
 drivers/net/ethernet/mellanox/mlx5/core/irq_affinity.c

---
 .../ethernet/mellanox/mlx5/core/irq_affinity.c    | 15 +++++++++++++++
 1 file changed, 15 insertions(+)

diff --git a/drivers/net/ethernet/mellanox/mlx5/core/irq_affinity.c b/drivers/net/ethernet/mellanox/mlx5/core/irq_affinity.c
index xxxxxxx..xxxxxxx 100644
--- a/drivers/net/ethernet/mellanox/mlx5/core/irq_affinity.c
+++ b/drivers/net/ethernet/mellanox/mlx5/core/irq_affinity.c
@@ -119,6 +119,7 @@ irq_pool_request_irq(struct mlx5_irq_pool *pool, struct irq_affinity_desc *af_de
  * If pool is sf_ctrl_pool, then all IRQs have the same mask, so any IRQ will
  * fit. And since mask is subset of itself, we will pass the first if bellow.
  */
+
 static struct mlx5_irq *
 irq_pool_find_least_loaded(struct mlx5_irq_pool *pool, const struct cpumask *req_mask)
 {
@@ -135,7 +136,11 @@ irq_pool_find_least_loaded(struct mlx5_irq_pool *pool, const struct cpumask *req
 		const struct cpumask *iter_mask;
 		int dyn_msix;
 
+#ifdef HAVE_PCI_MSIX_CAN_ALLOC_DYN
 		dyn_msix = pci_msix_can_alloc_dyn(pool->dev->pdev);
+#else
+		dyn_msix = false;
+#endif
 		if (dyn_msix)
 			iter_mask = irq_get_effective_affinity_mask(mlx5_irq_get_irq(iter));
 		else
@@ -207,8 +212,13 @@ out:
 unlock:
 	mutex_unlock(&pool->lock);
 	if (mlx5_irq_pool_is_sf_pool(pool)) {
+#if defined(HAVE_AUX_DEV_IRQS_SYSFS_UNBIND_BIND_FIX) || defined(CONFIG_AUXILIARY_BUS)
 		ret = auxiliary_device_sysfs_irq_add(mlx5_sf_coredev_to_adev(dev),
 						     mlx5_irq_get_irq(least_loaded_irq));
+#else
+		ret = mlx5_compat_sf_auxiliary_device_sysfs_irq_add(mlx5_sf_coredev_to_adev(dev),
+								mlx5_irq_get_irq(least_loaded_irq));
+#endif
 		if (ret) {
 			mlx5_core_err(dev, "Failed to create sysfs entry for irq %d, ret = %d\n",
 				      mlx5_irq_get_irq(least_loaded_irq), ret);
@@ -228,8 +238,13 @@ void mlx5_irq_affinity_irq_release(struct mlx5_core_dev *dev, struct mlx5_irq *i
 	synchronize_irq(pci_irq_vector(pool->dev->pdev,
 				       mlx5_irq_get_index(irq)));
 	if (mlx5_irq_pool_is_sf_pool(pool))
+#if defined(HAVE_AUX_DEV_IRQS_SYSFS_UNBIND_BIND_FIX) || defined(CONFIG_AUXILIARY_BUS)
 		auxiliary_device_sysfs_irq_remove(mlx5_sf_coredev_to_adev(dev),
 						  mlx5_irq_get_irq(irq));
+#else
+ 		mlx5_compat_sf_auxiliary_device_sysfs_irq_remove(mlx5_sf_coredev_to_adev(dev),
+ 								 mlx5_irq_get_irq(irq));
+#endif
 	if (mlx5_irq_put(irq))
 		if (pool->irqs_per_cpu)
 			cpu_put(pool, cpu);
