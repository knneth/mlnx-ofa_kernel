From: Valentine Fatiev <valentinef@nvidia.com>
Subject: [PATCH] BACKPORT: drivers/net/ethernet/mellanox/mlx5/core/dpll.c

---
 .../net/ethernet/mellanox/mlx5/core/dpll.c    | 96 +++++++++++++++++--
 1 file changed, 88 insertions(+), 8 deletions(-)

diff --git a/drivers/net/ethernet/mellanox/mlx5/core/dpll.c b/drivers/net/ethernet/mellanox/mlx5/core/dpll.c
index xxxxxxx..xxxxxxx 100644
--- a/drivers/net/ethernet/mellanox/mlx5/core/dpll.c
+++ b/drivers/net/ethernet/mellanox/mlx5/core/dpll.c
@@ -9,7 +9,14 @@
  */
 struct mlx5_dpll {
 	struct dpll_device *dpll;
+#ifdef HAVE_DPLL_DEVICE_PUT_TRACKER
+/* Newer kernels (7.0+): reference count tracking added */
+	dpll_tracker dpll_tracker;
+#endif
 	struct dpll_pin *dpll_pin;
+#ifdef HAVE_DPLL_DEVICE_PUT_TRACKER
+	dpll_tracker pin_tracker;
+#endif
 	struct mlx5_core_dev *mdev;
 	struct workqueue_struct *wq;
 	struct delayed_work work;
@@ -40,9 +47,11 @@ struct mlx5_dpll_synce_status {
 	enum mlx5_msees_admin_status admin_status;
 	enum mlx5_msees_oper_status oper_status;
 	bool ho_acq;
+#ifdef HAVE_DPLL_PIN_OPS_HAS_FFO_GET
 	bool oper_freq_measure;
-	enum mlx5_msees_failure_reason failure_reason;
 	s32 frequency_diff;
+#endif
+	enum mlx5_msees_failure_reason failure_reason;
 };
 
 static int
@@ -60,9 +69,11 @@ mlx5_dpll_synce_status_get(struct mlx5_core_dev *mdev,
 	synce_status->admin_status = MLX5_GET(msees_reg, out, admin_status);
 	synce_status->oper_status = MLX5_GET(msees_reg, out, oper_status);
 	synce_status->ho_acq = MLX5_GET(msees_reg, out, ho_acq);
+#ifdef HAVE_DPLL_PIN_OPS_HAS_FFO_GET
 	synce_status->oper_freq_measure = MLX5_GET(msees_reg, out, oper_freq_measure);
-	synce_status->failure_reason = MLX5_GET(msees_reg, out, failure_reason);
 	synce_status->frequency_diff = MLX5_GET(msees_reg, out, frequency_diff);
+#endif
+	synce_status->failure_reason = MLX5_GET(msees_reg, out, failure_reason);
 	return 0;
 }
 
@@ -75,10 +86,14 @@ mlx5_dpll_synce_status_set(struct mlx5_core_dev *mdev,
 
 	MLX5_SET(msees_reg, in, field_select,
 		 MLX5_MSEES_FIELD_SELECT_ENABLE |
+#ifdef HAVE_DPLL_PIN_OPS_HAS_FFO_GET
 		 MLX5_MSEES_FIELD_SELECT_ADMIN_FREQ_MEASURE |
+#endif
 		 MLX5_MSEES_FIELD_SELECT_ADMIN_STATUS);
 	MLX5_SET(msees_reg, in, admin_status, admin_status);
+#ifdef HAVE_DPLL_PIN_OPS_HAS_FFO_GET
 	MLX5_SET(msees_reg, in, admin_freq_measure, true);
+#endif
 	return mlx5_core_access_reg(mdev, in, sizeof(in), out, sizeof(out),
 				    MLX5_REG_MSEES, 0, 1);
 }
@@ -101,6 +116,7 @@ mlx5_dpll_lock_status_get(struct mlx5_dpll_synce_status *synce_status)
 	}
 }
 
+#ifdef HAVE_NDO_LOCK_STATUS_GET_GET_ERROR_STATUS
 static enum dpll_lock_status_error
 mlx5_dpll_lock_status_error_get(struct mlx5_dpll_synce_status *synce_status)
 {
@@ -120,6 +136,7 @@ mlx5_dpll_lock_status_error_get(struct mlx5_dpll_synce_status *synce_status)
 		return DPLL_LOCK_STATUS_ERROR_NONE;
 	}
 }
+#endif
 
 static enum dpll_pin_state
 mlx5_dpll_pin_state_get(struct mlx5_dpll_synce_status *synce_status)
@@ -130,6 +147,7 @@ mlx5_dpll_pin_state_get(struct mlx5_dpll_synce_status *synce_status)
 	       DPLL_PIN_STATE_CONNECTED : DPLL_PIN_STATE_DISCONNECTED;
 }
 
+#ifdef HAVE_DPLL_PIN_OPS_HAS_FFO_GET
 static int
 mlx5_dpll_pin_ffo_get(struct mlx5_dpll_synce_status *synce_status,
 		      s64 *ffo)
@@ -139,12 +157,20 @@ mlx5_dpll_pin_ffo_get(struct mlx5_dpll_synce_status *synce_status,
 	*ffo = synce_status->frequency_diff;
 	return 0;
 }
+#endif
 
+#ifdef HAVE_NDO_LOCK_STATUS_GET_GET_ERROR_STATUS
 static int
 mlx5_dpll_device_lock_status_get(const struct dpll_device *dpll, void *priv,
 				 enum dpll_lock_status *status,
 				 enum dpll_lock_status_error *status_error,
 				 struct netlink_ext_ack *extack)
+#else
+static int mlx5_dpll_device_lock_status_get(const struct dpll_device *dpll,
+					    void *priv,
+					    enum dpll_lock_status *status,
+					    struct netlink_ext_ack *extack)
+#endif
 {
 	struct mlx5_dpll_synce_status synce_status;
 	struct mlx5_dpll *mdpll = priv;
@@ -154,7 +180,9 @@ mlx5_dpll_device_lock_status_get(const struct dpll_device *dpll, void *priv,
 	if (err)
 		return err;
 	*status = mlx5_dpll_lock_status_get(&synce_status);
+#ifdef HAVE_NDO_LOCK_STATUS_GET_GET_ERROR_STATUS
 	*status_error = mlx5_dpll_lock_status_error_get(&synce_status);
+#endif
 	return 0;
 }
 
@@ -166,6 +194,7 @@ static int mlx5_dpll_device_mode_get(const struct dpll_device *dpll,
 	return 0;
 }
 
+#ifdef HAVE_CLOCK_QUALITY_LEVEL_GET
 enum {
 	MLX5_DPLL_SSM_CODE_PRC = 0b0010,
 	MLX5_DPLL_SSM_CODE_SSU_A = 0b0100,
@@ -245,11 +274,14 @@ errout:
 	NL_SET_ERR_MSG_MOD(extack, "Invalid clock quality level obtained from firmware");
 	return -EINVAL;
 }
+#endif
 
 static const struct dpll_device_ops mlx5_dpll_device_ops = {
 	.lock_status_get = mlx5_dpll_device_lock_status_get,
 	.mode_get = mlx5_dpll_device_mode_get,
+#ifdef HAVE_CLOCK_QUALITY_LEVEL_GET
 	.clock_quality_level_get = mlx5_dpll_clock_quality_level_get,
+#endif
 };
 
 static int mlx5_dpll_pin_direction_get(const struct dpll_pin *pin,
@@ -296,6 +328,7 @@ static int mlx5_dpll_state_on_dpll_set(const struct dpll_pin *pin,
 					  MLX5_MSEES_ADMIN_STATUS_FREE_RUNNING);
 }
 
+#ifdef HAVE_DPLL_PIN_OPS_HAS_FFO_GET
 static int mlx5_dpll_ffo_get(const struct dpll_pin *pin, void *pin_priv,
 			     const struct dpll_device *dpll, void *dpll_priv,
 			     s64 *ffo, struct netlink_ext_ack *extack)
@@ -309,12 +342,15 @@ static int mlx5_dpll_ffo_get(const struct dpll_pin *pin, void *pin_priv,
 		return err;
 	return mlx5_dpll_pin_ffo_get(&synce_status, ffo);
 }
+#endif
 
 static const struct dpll_pin_ops mlx5_dpll_pins_ops = {
 	.direction_get = mlx5_dpll_pin_direction_get,
 	.state_on_dpll_get = mlx5_dpll_state_on_dpll_get,
 	.state_on_dpll_set = mlx5_dpll_state_on_dpll_set,
+#ifdef HAVE_DPLL_PIN_OPS_HAS_FFO_GET
 	.ffo_get = mlx5_dpll_ffo_get,
+#endif
 };
 
 static const struct dpll_pin_properties mlx5_dpll_pin_properties = {
@@ -366,7 +402,12 @@ static void mlx5_dpll_netdev_dpll_pin_set(struct mlx5_dpll *mdpll,
 {
 	if (mdpll->tracking_netdev)
 		return;
+
+#ifdef HAVE_DPLL_NETDEV_PIN_SET
 	dpll_netdev_pin_set(netdev, mdpll->dpll_pin);
+#else
+	netdev_dpll_pin_set(netdev, mdpll->dpll_pin);
+#endif
 	mdpll->tracking_netdev = netdev;
 }
 
@@ -374,7 +415,11 @@ static void mlx5_dpll_netdev_dpll_pin_clear(struct mlx5_dpll *mdpll)
 {
 	if (!mdpll->tracking_netdev)
 		return;
+#ifdef HAVE_DPLL_NETDEV_PIN_SET
 	dpll_netdev_pin_clear(mdpll->tracking_netdev);
+#else
+	netdev_dpll_pin_clear(mdpll->tracking_netdev);
+#endif
 	mdpll->tracking_netdev = NULL;
 }
 
@@ -438,7 +483,12 @@ static int mlx5_dpll_probe(struct auxiliary_device *adev,
 	auxiliary_set_drvdata(adev, mdpll);
 
 	/* Multiple mdev instances might share one DPLL device. */
-	mdpll->dpll = dpll_device_get(clock_id, 0, THIS_MODULE);
+	mdpll->dpll = dpll_device_get(clock_id, 0, THIS_MODULE
+#ifdef HAVE_DPLL_DEVICE_PUT_TRACKER
+/* Newer kernels (7.0+): tracker argument added */
+				      , &mdpll->dpll_tracker
+#endif
+				      );
 	if (IS_ERR(mdpll->dpll)) {
 		err = PTR_ERR(mdpll->dpll);
 		goto err_free_mdpll;
@@ -451,7 +501,12 @@ static int mlx5_dpll_probe(struct auxiliary_device *adev,
 
 	/* Multiple mdev instances might share one DPLL pin. */
 	mdpll->dpll_pin = dpll_pin_get(clock_id, mlx5_get_dev_index(mdev),
-				       THIS_MODULE, &mlx5_dpll_pin_properties);
+				       THIS_MODULE, &mlx5_dpll_pin_properties
+#ifdef HAVE_DPLL_DEVICE_PUT_TRACKER
+/* Newer kernels (7.0+): tracker argument added */
+				       , &mdpll->pin_tracker
+#endif
+				       );
 	if (IS_ERR(mdpll->dpll_pin)) {
 		err = PTR_ERR(mdpll->dpll_pin);
 		goto err_unregister_dpll_device;
@@ -479,11 +534,21 @@ err_unregister_dpll_pin:
 	dpll_pin_unregister(mdpll->dpll, mdpll->dpll_pin,
 			    &mlx5_dpll_pins_ops, mdpll);
 err_put_dpll_pin:
-	dpll_pin_put(mdpll->dpll_pin);
+	dpll_pin_put(mdpll->dpll_pin
+#ifdef HAVE_DPLL_DEVICE_PUT_TRACKER
+/* Newer kernels (7.0+): tracker argument added */
+		     , &mdpll->pin_tracker
+#endif
+		     );
 err_unregister_dpll_device:
 	dpll_device_unregister(mdpll->dpll, &mlx5_dpll_device_ops, mdpll);
 err_put_dpll_device:
-	dpll_device_put(mdpll->dpll);
+	dpll_device_put(mdpll->dpll
+#ifdef HAVE_DPLL_DEVICE_PUT_TRACKER
+/* Newer kernels (7.0+): tracker argument added */
+		       , &mdpll->dpll_tracker
+#endif
+		       );
 err_free_mdpll:
 	kfree(mdpll);
 	return err;
@@ -499,9 +564,19 @@ static void mlx5_dpll_remove(struct auxiliary_device *adev)
 	destroy_workqueue(mdpll->wq);
 	dpll_pin_unregister(mdpll->dpll, mdpll->dpll_pin,
 			    &mlx5_dpll_pins_ops, mdpll);
-	dpll_pin_put(mdpll->dpll_pin);
+	dpll_pin_put(mdpll->dpll_pin
+#ifdef HAVE_DPLL_DEVICE_PUT_TRACKER
+/* Newer kernels (7.0+): tracker argument added */
+		     , &mdpll->pin_tracker
+#endif
+		     );
 	dpll_device_unregister(mdpll->dpll, &mlx5_dpll_device_ops, mdpll);
-	dpll_device_put(mdpll->dpll);
+	dpll_device_put(mdpll->dpll
+#ifdef HAVE_DPLL_DEVICE_PUT_TRACKER
+/* Newer kernels (7.0+): tracker argument added */
+		       , &mdpll->dpll_tracker
+#endif
+		       );
 	kfree(mdpll);
 
 	mlx5_dpll_synce_status_set(mdev,
@@ -523,7 +598,12 @@ static const struct auxiliary_device_id mlx5_dpll_id_table[] = {
 	{},
 };
 
+/* Only use MODULE_ALIAS on kernels ≥ 6.19 */
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(6, 19, 0)
+MODULE_ALIAS("auxiliary:mlx5_core.dpll");
+#else
 MODULE_DEVICE_TABLE(auxiliary, mlx5_dpll_id_table);
+#endif
 
 static struct auxiliary_driver mlx5_dpll_driver = {
 	.name = "dpll",
