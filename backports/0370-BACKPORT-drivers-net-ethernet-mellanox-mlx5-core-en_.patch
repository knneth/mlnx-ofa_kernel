@@ -57,5 +57,5 @@ static inline void mlx5e_psp_register(st
 static inline void mlx5e_psp_unregister(struct mlx5e_priv *priv) { }
 static inline int mlx5e_psp_init(struct mlx5e_priv *priv) { return 0; }
