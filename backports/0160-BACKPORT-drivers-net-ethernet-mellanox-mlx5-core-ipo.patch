From: Valentine Fatiev <valentinef@nvidia.com>
Subject: [PATCH] BACKPORT:
 drivers/net/ethernet/mellanox/mlx5/core/ipoib/ipoib_vlan.c

---
 .../mellanox/mlx5/core/ipoib/ipoib_vlan.c         | 15 +++++++++++++++
 1 file changed, 15 insertions(+)

diff --git a/drivers/net/ethernet/mellanox/mlx5/core/ipoib/ipoib_vlan.c b/drivers/net/ethernet/mellanox/mlx5/core/ipoib/ipoib_vlan.c
index xxxxxxx..xxxxxxx 100644
--- a/drivers/net/ethernet/mellanox/mlx5/core/ipoib/ipoib_vlan.c
+++ b/drivers/net/ethernet/mellanox/mlx5/core/ipoib/ipoib_vlan.c
@@ -140,7 +140,9 @@ static int mlx5i_pkey_close(struct net_device *netdev);
 static int mlx5i_pkey_dev_init(struct net_device *dev);
 static void mlx5i_pkey_dev_cleanup(struct net_device *netdev);
 static int mlx5i_pkey_change_mtu(struct net_device *netdev, int new_mtu);
+#ifndef HAVE_NDO_HWTSTAMP_GET_SET
 static int mlx5i_pkey_ioctl(struct net_device *dev, struct ifreq *ifr, int cmd);
+#endif
 
 static const struct net_device_ops mlx5i_pkey_netdev_ops = {
 	.ndo_open                = mlx5i_pkey_open,
@@ -149,7 +151,18 @@ static const struct net_device_ops mlx5i_pkey_netdev_ops = {
 	.ndo_get_stats64         = mlx5i_get_stats,
 	.ndo_uninit              = mlx5i_pkey_dev_cleanup,
 	.ndo_change_mtu          = mlx5i_pkey_change_mtu,
+
+#ifdef HAVE_NDO_HWTSTAMP_GET_SET
+	.ndo_hwtstamp_get        = mlx5i_hwtstamp_get,
+	.ndo_hwtstamp_set        = mlx5i_hwtstamp_set,
+#else
+#ifdef HAVE_NDO_ETH_IOCTL
 	.ndo_eth_ioctl            = mlx5i_pkey_ioctl,
+#else
+	.ndo_do_ioctl		  = mlx5i_pkey_ioctl,
+#endif
+#endif	/* HAVE_NDO_HWTSTAMP_GET_SET */
+
 };
 
 /* Child NDOs */
@@ -184,10 +197,12 @@ static int mlx5i_pkey_dev_init(struct net_device *dev)
 	return mlx5i_dev_init(dev);
 }
 
+#ifndef HAVE_NDO_HWTSTAMP_GET_SET
 static int mlx5i_pkey_ioctl(struct net_device *dev, struct ifreq *ifr, int cmd)
 {
 	return mlx5i_ioctl(dev, ifr, cmd);
 }
+#endif
 
 static void mlx5i_pkey_dev_cleanup(struct net_device *netdev)
 {
