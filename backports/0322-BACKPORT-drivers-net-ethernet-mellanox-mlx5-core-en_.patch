-
 	if (!an_disable_admin)
 		ethtool_link_ksettings_add_link_mode(link_ksettings,
 						     advertising, Autoneg);
@@ -1481,6 +1648,31 @@ static bool ext_link_mode_requested(const unsigned long *adver)
 	return bitmap_intersects(modes, adver, __ETHTOOL_LINK_MODE_MASK_NBITS);
 }
 
+/* True when every ethtool link mode bit of @info's speed sits at or above
+ * __ETHTOOL_LINK_MODE_MASK_NBITS, so none of them reaches the supported
+ * bitmap. Matched on the speed alone; @info->lanes may be inherited.
+ */
+static bool mlx5e_speed_beyond_link_mode_mask(struct mlx5_core_dev *mdev,
+					      struct mlx5_link_info *info)
+{
+	struct mlx5_link_info sinfo = { .speed = info->speed };
+	u32 modes = mlx5_port_info2linkmodes(mdev, &sinfo, false);
+	int i;
+
+	if (!modes)
+		return false;
+
+	for (i = 0; i < MLX5E_EXT_LINK_MODES_NUMBER; i++) {
+		if (!(modes & MLX5E_PROT_MASK(i)))
+			continue;
+		if (!bitmap_empty(ptys2ext_ethtool_table[i].advertised,
+				  __ETHTOOL_LINK_MODE_MASK_NBITS))
+			return false;
+	}
+
+	return true;
+}
+
 static int mlx5e_ethtool_set_link_ksettings(struct mlx5e_priv *priv,
 					    const struct ethtool_link_ksettings *link_ksettings)
 {
@@ -1505,7 +1697,9 @@ static int mlx5e_ethtool_set_link_ksettings(struct mlx5e_priv *priv,
 	adver = link_ksettings->link_modes.advertising;
 	autoneg = link_ksettings->base.autoneg;
 	info.speed = link_ksettings->base.speed;
+#ifdef HAVE_ETHTOOL_LINK_KSETTINGS_HAS_LANES
 	info.lanes = link_ksettings->lanes;
+#endif
 
 	ext_supported = mlx5_ptys_ext_supported(mdev);
 	ext_requested = ext_link_mode_requested(adver);
@@ -1524,6 +1718,46 @@ static int mlx5e_ethtool_set_link_ksettings(struct mlx5e_priv *priv,
 	link_modes = autoneg == AUTONEG_ENABLE ? ethtool2ptys_adver_func(adver) :
 		mlx5_port_info2linkmodes(mdev, &info, !ext);
 
+	/* This kernel cannot represent the requested speed, so advertising
+	 * carries no bit that maps to a PTYS mode. Take the modes from the
+	 * speed instead. An empty adver means the user cleared it outright,
+	 * which has to keep failing.
+	 */
+	if (!link_modes && autoneg == AUTONEG_ENABLE &&
+	    info.speed != SPEED_UNKNOWN && ext_supported &&
+	    !bitmap_empty(adver, __ETHTOOL_LINK_MODE_MASK_NBITS) &&
+	    mlx5e_speed_beyond_link_mode_mask(mdev, &info)) {
+		ext = true;
+		err = mlx5_port_query_eth_proto(mdev, 1, ext, &eproto);
+		if (err) {
+			netdev_err(priv->netdev,
+				   "%s: query port eth proto failed: %d\n",
+				   __func__, err);
+			goto out;
+		}
+		link_modes = mlx5_port_info2linkmodes(mdev, &info, false);
+#ifdef HAVE_ETHTOOL_LINK_KSETTINGS_HAS_LANES
+		if (!link_modes && info.lanes) {
+			const struct mlx5_link_info *oper;
+
+			/* lanes was inherited from the current link, not
+			 * requested: retry on the speed alone. An explicit
+			 * lane count is left to fail.
+			 */
+			oper = mlx5_port_ptys2info(mdev, eproto.oper, false);
+			if (oper && oper->lanes == info.lanes) {
