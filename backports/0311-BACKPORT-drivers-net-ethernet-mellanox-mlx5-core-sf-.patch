From: Valentine Fatiev <valentinef@nvidia.com>
Subject: [PATCH] BACKPORT:
 drivers/net/ethernet/mellanox/mlx5/core/sf/devlink.c

---
 .../ethernet/mellanox/mlx5/core/sf/devlink.c  | 106 +++++++++++++++++-
 1 file changed, 101 insertions(+), 5 deletions(-)

diff --git a/drivers/net/ethernet/mellanox/mlx5/core/sf/devlink.c b/drivers/net/ethernet/mellanox/mlx5/core/sf/devlink.c
index xxxxxxx..xxxxxxx 100644
--- a/drivers/net/ethernet/mellanox/mlx5/core/sf/devlink.c
+++ b/drivers/net/ethernet/mellanox/mlx5/core/sf/devlink.c
@@ -34,6 +34,21 @@ struct mlx5_sf_table {
 	struct mutex sf_state_lock; /* Serializes sf state among user cmds & vhca event handler. */
 };
 
+#ifndef HAVE_DEVLINK_PORT_OPS
+static struct mlx5_sf *
+mlx5_sf_lookup_by_index(struct mlx5_sf_table *table, unsigned int port_index)
+{
+	unsigned long index;
+	struct mlx5_sf *sf;
+
+	xa_for_each(&table->function_ids, index, sf) {
+		if (sf->port_index == port_index)
+			return sf;
+	}
+	return NULL;
+}
+#endif
+
 static struct mlx5_sf *
 mlx5_sf_lookup_by_function_id(struct mlx5_sf_table *table, unsigned int fn_id)
 {
@@ -139,15 +154,30 @@ static bool mlx5_sf_is_active(const struct mlx5_sf *sf)
 {
 	return sf->hw_state == MLX5_VHCA_STATE_ACTIVE || sf->hw_state == MLX5_VHCA_STATE_IN_USE;
 }
-
-int mlx5_devlink_sf_port_fn_state_get(struct devlink_port *dl_port,
+#if defined(HAVE_PORT_FUNCTION_HW_ADDR_GET_GET_4_PARAM) || defined(HAVE_DEVLINK_PORT_OPS)
+int mlx5_devlink_sf_port_fn_state_get(
+#else
+int mlx5_devlink_sf_port_fn_state_get(struct devlink *devlink,
+#endif
+				      struct devlink_port *dl_port,
 				      enum devlink_port_fn_state *state,
 				      enum devlink_port_fn_opstate *opstate,
 				      struct netlink_ext_ack *extack)
 {
 	struct mlx5_core_dev *dev = devlink_priv(dl_port->devlink);
 	struct mlx5_sf_table *table = dev->priv.sf_table;
-	struct mlx5_sf *sf = mlx5_sf_by_dl_port(dl_port);
+	struct mlx5_sf *sf;
+
+	if (!table)
+		return -EOPNOTSUPP;
+
+#ifdef HAVE_DEVLINK_PORT_OPS
+       sf = mlx5_sf_by_dl_port(dl_port);
+#else
+       sf = mlx5_sf_lookup_by_index(table, dl_port->index);
+#endif
+       if (!sf)
+               return -EOPNOTSUPP;
 
 	mutex_lock(&table->sf_state_lock);
 	*state = mlx5_sf_to_devlink_state(sf->hw_state);
@@ -231,7 +261,12 @@ out:
 	return err;
 }
 
-int mlx5_devlink_sf_port_fn_state_set(struct devlink_port *dl_port,
+#if defined(HAVE_PORT_FUNCTION_HW_ADDR_GET_GET_4_PARAM) || defined(HAVE_DEVLINK_PORT_OPS)
+int mlx5_devlink_sf_port_fn_state_set(
+#else
+int mlx5_devlink_sf_port_fn_state_set(struct devlink *devlink,
+#endif
+				      struct devlink_port *dl_port,
 				      enum devlink_port_fn_state state,
 				      struct netlink_ext_ack *extack)
 {
@@ -245,7 +280,11 @@ int mlx5_devlink_sf_port_fn_state_set(struct devlink_port *dl_port,
 static int mlx5_sf_add(struct mlx5_core_dev *dev, struct mlx5_sf_table *table,
 		       const struct devlink_port_new_attrs *new_attr,
 		       struct netlink_ext_ack *extack,
+#ifdef HAVE_DEVLINK_PORT_OPS
 		       struct devlink_port **dl_port)
+#else
+		       unsigned int *new_port_index)
+#endif
 {
 	struct mlx5_eswitch *esw = dev->priv.eswitch;
 	struct mlx5_sf *sf;
@@ -261,7 +300,11 @@ static int mlx5_sf_add(struct mlx5_core_dev *dev, struct mlx5_sf_table *table,
 	mlx5_esw_reps_unblock(esw);
 	if (err)
 		goto esw_err;
+#ifdef HAVE_DEVLINK_PORT_OPS
 	*dl_port = &sf->dl_port.dl_port;
+#else
+	*new_port_index = sf->port_index;
+#endif
 	trace_mlx5_sf_add(dev, sf->port_index, sf->controller, sf->hw_fn_id, new_attr->sfnum);
 	return 0;
 
@@ -310,12 +353,23 @@ static bool mlx5_sf_table_supported(const struct mlx5_core_dev *dev)
 int mlx5_devlink_sf_port_new(struct devlink *devlink,
 			     const struct devlink_port_new_attrs *new_attr,
 			     struct netlink_ext_ack *extack,
+#ifdef HAVE_DEVLINK_PORT_OPS
 			     struct devlink_port **dl_port)
+#else
+			     unsigned int *new_port_index)
+#endif
 {
+#ifndef HAVE_DEVL_TRAP_GROUPS_REGISTER
+	struct mlxdevm *mlxdevm = &mlx5_devm_device_get(devlink_priv(devlink))->device;
+#endif
 	struct mlx5_core_dev *dev = devlink_priv(devlink);
 	struct mlx5_sf_table *table = dev->priv.sf_table;
 	int err;
 
+#ifndef HAVE_DEVL_TRAP_GROUPS_REGISTER
+	if (!mlxdevm->mlxdevm_flow)
+		devm_lock(mlxdevm);
+#endif
 	err = mlx5_sf_new_check_attr(dev, new_attr, extack);
 	if (err)
 		goto out;
@@ -333,9 +387,17 @@ int mlx5_devlink_sf_port_new(struct devlink *devlink,
 		goto out;
 	}
 
+#ifdef HAVE_DEVLINK_PORT_OPS
 	err = mlx5_sf_add(dev, table, new_attr, extack, dl_port);
+#else
+	err = mlx5_sf_add(dev, table, new_attr, extack, new_port_index);
+#endif
 
 out:
+#ifndef HAVE_DEVL_TRAP_GROUPS_REGISTER
+	if (!mlxdevm->mlxdevm_flow)
+		devm_unlock(mlxdevm);
+#endif
 	return err;
 }
 
@@ -376,18 +438,44 @@ static void mlx5_sf_del(struct mlx5_sf_table *table, struct mlx5_sf *sf)
 	mlx5_sf_dealloc(table, sf);
 }
 
+#ifdef HAVE_DEVLINK_PORT_OPS
 int mlx5_devlink_sf_port_del(struct devlink *devlink,
 			     struct devlink_port *dl_port,
 			     struct netlink_ext_ack *extack)
+#else
+int mlx5_devlink_sf_port_del(struct devlink *devlink, unsigned int port_index,
+			     struct netlink_ext_ack *extack)
+#endif
 {
+#ifndef HAVE_DEVL_TRAP_GROUPS_REGISTER
+	struct mlxdevm *mlxdevm = &mlx5_devm_device_get(devlink_priv(devlink))->device;
+#endif
 	struct mlx5_core_dev *dev = devlink_priv(devlink);
 	struct mlx5_sf_table *table = dev->priv.sf_table;
-	struct mlx5_sf *sf = mlx5_sf_by_dl_port(dl_port);
+	struct mlx5_sf *sf;
+
+#ifdef HAVE_DEVLINK_PORT_OPS
+	sf = mlx5_sf_by_dl_port(dl_port);
+#else
+	sf = mlx5_sf_lookup_by_index(table, port_index);
+#endif
+
+	if (!sf)
+		return -ENODEV;
+
+#ifndef HAVE_DEVL_TRAP_GROUPS_REGISTER
+	if (!mlxdevm->mlxdevm_flow)
+		devm_lock(mlxdevm);
+#endif
 
 	mlx5_esw_reps_block(dev->priv.eswitch);
 	mlx5_sf_del(table, sf);
 	mlx5_esw_reps_unblock(dev->priv.eswitch);
 
+#ifndef HAVE_DEVL_TRAP_GROUPS_REGISTER
+	if (!mlxdevm->mlxdevm_flow)
+		devm_unlock(mlxdevm);
+#endif
 	return 0;
 }
 
@@ -466,6 +554,7 @@ static int mlx5_sf_esw_event(struct notifier_block *nb, unsigned long event, voi
 	return 0;
 }
 
+#ifdef HAVE_DEVLINK_INSTANCES_RELATIONSHIPS_EXPOSURE
 static int mlx5_sf_mdev_event(struct notifier_block *nb, unsigned long event, void *data)
 {
 	struct mlx5_core_dev *dev = container_of(nb, struct mlx5_core_dev,
@@ -491,6 +580,7 @@ out:
 	mutex_unlock(&table->sf_state_lock);
 	return ret;
 }
+#endif
 
 static int mlx5_sf_mlxdevm_mdev_event(struct notifier_block *nb, unsigned long event, void *data)
 {
@@ -536,8 +626,10 @@ int mlx5_sf_notifiers_init(struct mlx5_core_dev *dev)
 	if (err)
 		goto vhca_err;
 
+#ifdef HAVE_DEVLINK_INSTANCES_RELATIONSHIPS_EXPOSURE
 	dev->priv.sf_table_mdev_nb.notifier_call = mlx5_sf_mdev_event;
 	err = mlx5_blocking_notifier_register(dev, &dev->priv.sf_table_mdev_nb);
+#endif
 	if (err)
 		goto mdev_err;
 
@@ -548,7 +640,9 @@ int mlx5_sf_notifiers_init(struct mlx5_core_dev *dev)
 
 	return 0;
 mlxdevm_mdev_err:
+#ifdef HAVE_DEVLINK_INSTANCES_RELATIONSHIPS_EXPOSURE
 	mlx5_blocking_notifier_unregister(dev, &dev->priv.sf_table_mdev_nb);
+#endif
 mdev_err:
 	mlx5_vhca_event_notifier_unregister(dev, &dev->priv.sf_table_vhca_nb);
 vhca_err:
@@ -581,7 +675,9 @@ void mlx5_sf_notifiers_cleanup(struct mlx5_core_dev *dev)
 		return;
 
 	mlx5_blocking_notifier_unregister(dev, &dev->priv.sf_table_mlxdevm_mdev_nb);
+#ifdef HAVE_DEVLINK_INSTANCES_RELATIONSHIPS_EXPOSURE
 	mlx5_blocking_notifier_unregister(dev, &dev->priv.sf_table_mdev_nb);
+#endif
 	mlx5_vhca_event_notifier_unregister(dev, &dev->priv.sf_table_vhca_nb);
 	mlx5_esw_event_notifier_unregister(dev, &dev->priv.sf_table_esw_nb);
 }
