@@ -302,7 +346,6 @@ static int ipoib_change_mtu(struct net_device *dev, int new_mtu)
 
 		/* notify lower level on the real mtu */
 		ret = priv->rn_ops->ndo_change_mtu(dev, new_mtu);
-
 		if (carrier_status)
 			netif_carrier_on(dev);
 	} else {
@@ -339,9 +382,15 @@ static bool ipoib_is_dev_match_addr_rcu(const struct sockaddr *addr,
 		if (!in_dev)
 			return false;
 
+#ifdef HAVE_INET_CONFIRM_ADDR_EXPORTED
 		ret_addr = inet_confirm_addr(net, in_dev, 0,
 					     addr_in->sin_addr.s_addr,
 					     RT_SCOPE_HOST);
+#else
+		ret_addr = confirm_addr_indev(in_dev, 0,
+					      addr_in->sin_addr.s_addr,
+					      RT_SCOPE_HOST);
+#endif
 		in_dev_put(in_dev);
 		if (ret_addr)
 			return true;
@@ -387,9 +436,17 @@ struct ipoib_walk_data {
 };
 
 static int ipoib_upper_walk(struct net_device *upper,
-			    struct netdev_nested_priv *priv)
+#ifdef HAVE_NETDEV_NESTED_PRIV_STRUCT
+				struct netdev_nested_priv *priv)
+#else
+				void *_data)
+#endif
 {
+#ifdef HAVE_NETDEV_NESTED_PRIV_STRUCT
 	struct ipoib_walk_data *data = (struct ipoib_walk_data *)priv->data;
+#else
+	struct ipoib_walk_data *data = _data;
+#endif
 	int ret = 0;
 
 	if (ipoib_is_dev_match_addr_rcu(data->addr, upper)) {
@@ -414,12 +471,16 @@ static int ipoib_upper_walk(struct net_device *upper,
 static struct net_device *ipoib_get_net_dev_match_addr(
 		const struct sockaddr *addr, struct net_device *dev)
 {
+#ifdef HAVE_NETDEV_NESTED_PRIV_STRUCT
 	struct netdev_nested_priv priv;
+#endif
 	struct ipoib_walk_data data = {
 		.addr = addr,
 	};
 
+#ifdef HAVE_NETDEV_NESTED_PRIV_STRUCT
 	priv.data = (void *)&data;
+#endif
 	rcu_read_lock();
 	if (ipoib_is_dev_match_addr_rcu(addr, dev)) {
 		dev_hold(dev);
@@ -427,7 +488,13 @@ static struct net_device *ipoib_get_net_dev_match_addr(
 		goto out;
 	}
 
-	netdev_walk_all_upper_dev_rcu(dev, ipoib_upper_walk, &priv);
+	netdev_walk_all_upper_dev_rcu(dev, ipoib_upper_walk,
+#ifdef HAVE_NETDEV_NESTED_PRIV_STRUCT
+					&priv);
+#else
+					&data);
+#endif
+
 out:
 	rcu_read_unlock();
 	return data.result;
@@ -471,7 +538,13 @@ static int ipoib_match_gid_pkey_addr(struct ipoib_dev_priv *priv,
 		return matches;
 
 	/* Check child interfaces */
+#ifdef HAVE_NETDEVICE_NETDEV_LOCK
+	/* upstream commit 463e51769697: replaced vlan_rwsem with netdev lock */
 	netdev_lock(priv->dev);
+#else
+	/* Before commit 463e51769697: used vlan_rwsem with nesting parameter */
+	down_read_nested(&priv->vlan_rwsem, nesting);
+#endif
 	list_for_each_entry(child_priv, &priv->child_intfs, list) {
 		matches += ipoib_match_gid_pkey_addr(child_priv, gid,
 						     pkey_index, addr,
@@ -480,7 +553,13 @@ static int ipoib_match_gid_pkey_addr(struct ipoib_dev_priv *priv,
 		if (matches > 1)
 			break;
 	}
+#ifdef HAVE_NETDEVICE_NETDEV_LOCK
+	/* upstream commit 463e51769697: replaced vlan_rwsem with netdev lock */
 	netdev_unlock(priv->dev);
+#else
+	/* Before commit 463e51769697: used vlan_rwsem with nesting parameter */
+	up_read(&priv->vlan_rwsem);
+#endif
 
 	return matches;
 }
@@ -578,11 +657,19 @@ int ipoib_set_mode(struct net_device *dev, const char *buf)
 
 	if (!strcmp(buf, "datagram\n")) {
 		clear_bit(IPOIB_FLAG_ADMIN_CM, &priv->flags);
+#ifdef HAVE_NETDEV_LOCK_OPS
 		netdev_lock_ops(dev);
+#endif
