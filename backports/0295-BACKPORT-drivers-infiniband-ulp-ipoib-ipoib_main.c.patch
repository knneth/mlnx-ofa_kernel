+#ifdef HAVE_NETDEV_LOCK_OPS
 		netif_set_mtu(dev, min(priv->mcast_mtu, dev->mtu));
+#else
+		dev_set_mtu(dev, min(priv->mcast_mtu, dev->mtu));
+#endif
 		netif_set_real_num_tx_queues(dev, dev->num_tx_queues);
+#ifdef HAVE_NETDEV_LOCK_OPS
 		netdev_unlock_ops(dev);
+#endif
