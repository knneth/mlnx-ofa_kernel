+#ifdef HAVE_NETDEV_LOCK_OPS
 	netdev_lock_ops(priv->dev);
+#endif
 
 	if (!test_bit(IPOIB_FLAG_ADMIN_UP, &priv->flags))
 		goto unlock;
@@ -1346,7 +1445,9 @@ void ipoib_ib_tx_timeout_work(struct work_struct *work)
 
