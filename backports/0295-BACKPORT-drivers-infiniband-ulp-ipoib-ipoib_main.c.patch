+#include <net/net_trackers.h>
+#endif
 
 MODULE_AUTHOR("Roland Dreier");
 MODULE_DESCRIPTION("IP-over-InfiniBand net driver");
@@ -164,7 +167,11 @@ static void ipoib_ifupdown_task(struct work_struct *work)
 	if (dev->flags != flags)
 		dev_change_flags(dev, flags, NULL);
 	rtnl_unlock();
+#ifdef HAVE_NETDEV_PUT_AND_HOLD
 	netdev_put(dev, &pwork->dev_tracker);
+#else
+	dev_put(dev);
+#endif
 	kfree(pwork);
 }
 
@@ -180,7 +187,11 @@ static void ipoib_schedule_ifupdown_task(struct net_device *dev, bool up)
 	if (!work)
 		return;
 	work->dev = dev;
+#ifdef HAVE_NETDEV_PUT_AND_HOLD
 	netdev_hold(dev, &work->dev_tracker, GFP_KERNEL);
+#else
+	dev_hold(dev);
+#endif
 	work->up = up;
 	INIT_WORK(&work->work, ipoib_ifupdown_task);
 	queue_work(ipoib_workqueue, &work->work);
@@ -208,10 +219,27 @@ int ipoib_open(struct net_device *dev)
 		struct ipoib_dev_priv *cpriv;
 
 		/* Bring up any child interfaces too */
+#ifdef HAVE_NETDEV_LOCK_OPS_TO_FULL
+		/* Newer kernels (6.15+): netdev instance locking API */
 		netdev_lock_ops_to_full(dev);
+#elif defined(HAVE_NETDEVICE_NETDEV_LOCK)
+		/* Upstream commit 463e51769697 (6.12+): replaced vlan_rwsem with netdev lock */
+		netdev_lock(dev);
+#else
+		/* Before commit 463e51769697 (<=v6.12): used vlan_rwsem */
+		down_read(&priv->vlan_rwsem);
+#endif
 		list_for_each_entry(cpriv, &priv->child_intfs, list)
 			ipoib_schedule_ifupdown_task(cpriv->dev, true);
+#ifdef HAVE_NETDEV_LOCK_OPS_TO_FULL
 		netdev_unlock_full_to_ops(dev);
+#elif defined(HAVE_NETDEVICE_NETDEV_LOCK)
+		/* Upstream commit 463e51769697 (6.12+): replaced vlan_rwsem with netdev lock */
+		netdev_unlock(dev);
+#else
+		/* Before commit 463e51769697 (<=v6.12): used vlan_rwsem */
+		up_read(&priv->vlan_rwsem);
+#endif
 	} else if (priv->parent) {
 		struct ipoib_dev_priv *ppriv = ipoib_priv(priv->parent);
 
@@ -246,10 +274,27 @@ static int ipoib_stop(struct net_device *dev)
 		struct ipoib_dev_priv *cpriv;
 
 		/* Bring down any child interfaces too */
+#ifdef HAVE_NETDEV_LOCK_OPS_TO_FULL
+		/* Newer kernels (6.15+): netdev instance locking API */
 		netdev_lock_ops_to_full(dev);
+#elif defined(HAVE_NETDEVICE_NETDEV_LOCK)
+		/* Upstream commit 463e51769697 (6.12+): replaced vlan_rwsem with netdev lock */
+		netdev_lock(dev);
+#else
+		/* Before commit 463e51769697 (<=v6.12): used vlan_rwsem */
+		down_read(&priv->vlan_rwsem);
+#endif
 		list_for_each_entry(cpriv, &priv->child_intfs, list)
 			ipoib_schedule_ifupdown_task(cpriv->dev, false);
+#ifdef HAVE_NETDEV_LOCK_OPS_TO_FULL
 		netdev_unlock_full_to_ops(dev);
+#elif defined(HAVE_NETDEVICE_NETDEV_LOCK)
+		/* Upstream commit 463e51769697 (6.12+): replaced vlan_rwsem with netdev lock */
+		netdev_unlock(dev);
+#else
+		/* Before commit 463e51769697 (<=v6.12): used vlan_rwsem */
+		up_read(&priv->vlan_rwsem);
+#endif
 	}
 
 	return 0;
@@ -294,7 +339,6 @@ static int ipoib_change_mtu(struct net_device *dev, int new_mtu)
 				"link layer MTU - 4 (%u)\n", priv->mcast_mtu);
 
 	new_mtu = min(priv->mcast_mtu, priv->admin_mtu);
-
 	if (priv->rn_ops->ndo_change_mtu) {
