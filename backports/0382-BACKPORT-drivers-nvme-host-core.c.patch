 blk_status_t nvme_fail_nonready_command(struct nvme_ctrl *ctrl,
 		struct request *rq)
 {
-	enum nvme_ctrl_state state = nvme_ctrl_state(ctrl);
 
+	enum nvme_ctrl_state state = nvme_ctrl_state(ctrl);
+#ifdef CONFIG_NVME_MULTIPATH
 	if (state != NVME_CTRL_DELETING_NOIO &&
 	    state != NVME_CTRL_DELETING &&
