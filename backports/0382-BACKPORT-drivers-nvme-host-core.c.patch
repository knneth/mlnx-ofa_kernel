 static inline blk_status_t nvme_setup_rw(struct nvme_ns *ns,
 		struct request *req, struct nvme_command *cmnd,
@@ -1002,20 +1091,28 @@ static inline blk_status_t nvme_setup_rw(struct nvme_ns *ns,
 	if (req->cmd_flags & REQ_RAHEAD)
 		dsmgmt |= NVME_RW_DSM_FREQ_PREFETCH;
 
+#ifdef HAVE_QUEUE_LIMITS_MAX_WRITE_STREAMS
 	if (op == nvme_cmd_write && ns->head->nr_plids) {
 		u16 write_stream = req->bio->bi_write_stream;
 
 		if (WARN_ON_ONCE(write_stream > ns->head->nr_plids))
+#ifdef HAVE_BLK_STS_INVAL
 			return BLK_STS_INVAL;
+#else
+			return BLK_STS_IOERR
+#endif
 
 		if (write_stream) {
 			dsmgmt |= ns->head->plids[write_stream - 1] << 16;
 			control |= NVME_RW_DTYPE_DPLCMT;
 		}
 	}
+#endif
 
+#ifdef HAVE_QUEUE_ATOMIC_WRITE_BOUNDARY_BYTES
 	if (req->cmd_flags & REQ_ATOMIC && !nvme_valid_atomic_write(req))
 		return BLK_STS_INVAL;
+#endif
 
 	cmnd->rw.opcode = op;
 	cmnd->rw.flags = 0;
@@ -1042,21 +1139,44 @@ static inline blk_status_t nvme_setup_rw(struct nvme_ns *ns,
 			if (WARN_ON_ONCE(!nvme_ns_has_pi(ns->head)))
