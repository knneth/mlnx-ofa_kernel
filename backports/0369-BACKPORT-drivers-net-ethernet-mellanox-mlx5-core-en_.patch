+++ b/drivers/net/ethernet/mellanox/mlx5/core/en_accel/ipsec_offload.c
@@ -2,6 +2,38 @@
 /* Copyright (c) 2017, Mellanox Technologies inc. All rights reserved. */
 
 #include <linux/iopoll.h>
+#ifndef HAVE_READ_POLL_TIMEOUT_ATOMIC
+/* Older kernels (< 5.9): read_poll_timeout_atomic missing, provide backport */
+#include <linux/ktime.h>
+#include <linux/delay.h>
+#define read_poll_timeout_atomic(op, val, cond, delay_us, timeout_us,	\
+				 delay_before_read, args...)		\
+({									\
+	u64 __timeout_us = (timeout_us);				\
+	unsigned long __delay_us = (delay_us);				\
+	ktime_t __timeout = ktime_add_us(ktime_get(), __timeout_us);	\
+	int __read_poll_ret;						\
+	if ((delay_before_read) && __delay_us)				\
+		udelay(__delay_us);					\
+	for (;;) {							\
+		(val) = op(args);					\
+		if (cond) {						\
+			__read_poll_ret = 0;				\
+			break;						\
+		}							\
+		if (__timeout_us &&					\
+		    ktime_compare(ktime_get(), __timeout) > 0) {	\
+			(val) = op(args);				\
+			__read_poll_ret = (cond) ? 0 : -ETIMEDOUT;	\
+			break;						\
+		}							\
+		if (__delay_us)						\
+			udelay(__delay_us);				\
+		cpu_relax();						\
+	}								\
+	__read_poll_ret;						\
+})
+#endif
 
 #include "mlx5_core.h"
 #include "en.h"
@@ -595,7 +627,7 @@ int mlx5e_ipsec_aso_query(struct mlx5e_ipsec_sa_entry *sa_entry,
 	struct mlx5e_hw_objs *res;
 	struct mlx5_aso_wqe *wqe;
 	u8 ds_cnt;
-	int ret;
+	int ret = -ETIMEDOUT;
 
 	lockdep_assert_held(&sa_entry->x->lock);
 	res = &mdev->mlx5e_res.hw_objs;
