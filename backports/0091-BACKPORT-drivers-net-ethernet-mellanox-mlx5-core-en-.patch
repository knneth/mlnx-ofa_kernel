 }
 
+#ifdef HAVE_TC_SETUP_FT
 static int mlx5e_rep_indr_setup_ft_cb(enum tc_setup_type type,
 				      void *type_data, void *indr_priv)
 {
@@ -422,6 +437,7 @@ static int mlx5e_rep_indr_setup_ft_cb(enum tc_setup_type type,
