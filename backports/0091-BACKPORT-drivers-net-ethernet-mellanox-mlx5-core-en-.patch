@@ -241,6 +251,7 @@ static int mlx5e_rep_setup_ft_cb(enum tc_setup_type type, void *type_data,
 		return -EOPNOTSUPP;
 	}
 }
+#endif
 
 static LIST_HEAD(mlx5e_rep_block_tc_cb_list);
 static LIST_HEAD(mlx5e_rep_block_ft_cb_list);
@@ -248,8 +259,8 @@ int mlx5e_rep_setup_tc(struct net_device *dev, enum tc_setup_type type,
 		       void *type_data)
 {
 	struct mlx5e_priv *priv = netdev_priv(dev);
-	struct flow_block_offload *f = type_data;
 
+	struct flow_block_offload *f = type_data;
 	f->unlocked_driver_cb = true;
 
 	switch (type) {
@@ -258,16 +269,19 @@ int mlx5e_rep_setup_tc(struct net_device *dev, enum tc_setup_type type,
 						  &mlx5e_rep_block_tc_cb_list,
 						  mlx5e_rep_setup_tc_cb,
 						  priv, priv, true);
+#ifdef HAVE_TC_SETUP_FT
 	case TC_SETUP_FT:
 		return flow_block_cb_setup_simple(type_data,
 						  &mlx5e_rep_block_ft_cb_list,
 						  mlx5e_rep_setup_ft_cb,
 						  priv, priv, true);
+#endif /* HAVE_TC_SETUP_FT */
 	default:
 		return -EOPNOTSUPP;
 	}
 }
 
+
 int mlx5e_rep_tc_init(struct mlx5e_rep_priv *rpriv)
 {
