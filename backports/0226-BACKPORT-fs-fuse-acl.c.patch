From: Valentine Fatiev <valentinef@nvidia.com>
Subject: [PATCH] BACKPORT: fs/fuse/acl.c

---
 fs/fuse/acl.c | 21 ++++++++++++++++++++-
 1 file changed, 20 insertions(+), 1 deletion(-)

--- a/fs/fuse/acl.c
+++ b/fs/fuse/acl.c
@@ -122,6 +122,20 @@ int fuse_set_acl(struct mnt_idmap *idmap
 		 * them to be refreshed the next time they are used,
 		 * and it also updates i_ctime.
 		 */
+#ifdef HAVE_POSIX_ACL_TO_XATTR_RETURNS_VOID_PTR
+/* Newer kernels (7.0+): posix_acl_to_xattr allocates the buffer itself */
+		size_t size;
+		void *value;
+
+		value = posix_acl_to_xattr(fc->user_ns, acl, &size, GFP_KERNEL);
+		if (!value)
+			return -ENOMEM;
+
+		if (size > PAGE_SIZE) {
+			kfree(value);
+			return -E2BIG;
+		}
+#else
 		size_t size = posix_acl_xattr_size(acl->a_count);
 		void *value;
 
@@ -137,15 +151,20 @@ int fuse_set_acl(struct mnt_idmap *idmap
 			kfree(value);
 			return ret;
 		}
-
+#endif
 		/*
 		 * Fuse daemons without FUSE_POSIX_ACL never changed the passed
 		 * through POSIX ACLs. Such daemons don't expect setgid bits to
 		 * be stripped.
 		 */
 		if (fc->posix_acl &&
+#ifdef HAVE_IN_GROUP_OR_CAPABLE
 		    !in_group_or_capable(idmap, inode,
 					 i_gid_into_vfsgid(idmap, inode)))
+#else
+			!vfsgid_in_group_p(i_gid_into_vfsgid(&nop_mnt_idmap, inode)) &&
+			!capable_wrt_inode_uidgid(&nop_mnt_idmap, inode, CAP_FSETID))
+#endif
 			extra_flags |= FUSE_SETXATTR_ACL_KILL_SGID;
 
 		ret = fuse_setxattr(inode, name, value, size, 0, extra_flags);
