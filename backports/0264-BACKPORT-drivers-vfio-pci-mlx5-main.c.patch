From: Valentine Fatiev <valentinef@nvidia.com>
Subject: [PATCH] BACKPORT: drivers/vfio/pci/mlx5/main.c

---
 drivers/vfio/pci/mlx5/main.c | 44 ++++++++++++++++++++++++++++++++++++
 1 file changed, 44 insertions(+)

diff --git a/drivers/vfio/pci/mlx5/main.c b/drivers/vfio/pci/mlx5/main.c
index xxxxxxx..xxxxxxx 100644
--- a/drivers/vfio/pci/mlx5/main.c
+++ b/drivers/vfio/pci/mlx5/main.c
@@ -3,6 +3,7 @@
  * Copyright (c) 2021-2022, NVIDIA CORPORATION & AFFILIATES. All rights reserved
  */
 
+#ifdef HAVE_VFIO_SUPPORT
 #include <linux/device.h>
 #include <linux/eventfd.h>
 #include <linux/file.h>
@@ -470,10 +471,26 @@ static long mlx5vf_precopy_ioctl(struct file *filp, unsigned int cmd,
 	bool end_of_data;
 	int ret;
 
+#ifdef HAVE_VFIO_CHECK_PRECOPY_IOCTL
+	/* Newer kernels (7.1+): core helper centralizes ioctl validation */
 	ret = vfio_check_precopy_ioctl(&mvdev->core_device.vdev, cmd, arg,
 				       &info);
 	if (ret)
 		return ret;
+#else
+	/* Older kernels (7.0): inline the same validation logic */
+	{
+		unsigned long minsz;
+
+		if (cmd != VFIO_MIG_GET_PRECOPY_INFO)
+			return -ENOTTY;
+		minsz = offsetofend(struct vfio_precopy_info, dirty_bytes);
+		if (copy_from_user(&info, (void __user *)arg, minsz))
+			return -EFAULT;
+		if (info.argsz < minsz)
+			return -EINVAL;
+	}
+#endif
 
 	mutex_lock(&mvdev->state_mutex);
 	if (mvdev->mig_state != VFIO_DEVICE_STATE_PRE_COPY &&
@@ -510,8 +527,14 @@ static long mlx5vf_precopy_ioctl(struct file *filp, unsigned int cmd,
 	 * opt-in for VFIO_DEVICE_FEATURE_MIG_PRECOPY_INFOv2 serves
 	 * as opt-in for VFIO_PRECOPY_INFO_REINIT as well
 	 */
+#ifdef HAVE_VFIO_DEVICE_PRECOPY_INFO_V2
+	/* Newer kernels (7.1+): precopy_info_v2 opt-in available */
 	reinit_state = mvdev->core_device.vdev.precopy_info_v2 &&
 			migration_state == MLX5_QUERY_VHCA_MIG_STATE_OPER_MIGRATION_INIT;
+#else
+	/* Older/vendor kernels: no precopy_info_v2 field, never reinit */
+	reinit_state = false;
+#endif
 	end_of_data = !(migf->max_pos - *pos);
 	if (reinit_state) {
 		/*
@@ -522,7 +545,10 @@ static long mlx5vf_precopy_ioctl(struct file *filp, unsigned int cmd,
 		migf->pre_copy_initial_bytes_start = *pos;
 		migf->pre_copy_initial_bytes = migf->max_pos - *pos;
 		info.initial_bytes = migf->pre_copy_initial_bytes + inc_length;
+#ifdef HAVE_VFIO_DEVICE_PRECOPY_INFO_V2
+		/* Newer kernels (7.1+): VFIO_PRECOPY_INFO_REINIT flag exists */
 		info.flags |= VFIO_PRECOPY_INFO_REINIT;
+#endif
 	} else {
 		if (migf->pre_copy_initial_bytes_start +
 		    migf->pre_copy_initial_bytes > *pos) {
@@ -587,6 +613,9 @@ static const struct file_operations mlx5vf_save_fops = {
 	.unlocked_ioctl = mlx5vf_precopy_ioctl,
 	.compat_ioctl = compat_ptr_ioctl,
 	.release = mlx5vf_release_file,
+#ifdef HAVE_NO_LLSEEK
+	.llseek = no_llseek,
+#endif
 };
 
 static int mlx5vf_pci_save_device_inc_data(struct mlx5vf_pci_core_device *mvdev)
@@ -1004,6 +1033,9 @@ static const struct file_operations mlx5vf_resume_fops = {
 	.owner = THIS_MODULE,
 	.write = mlx5vf_resume_write,
 	.release = mlx5vf_release_file,
+#ifdef HAVE_NO_LLSEEK
+	.llseek = no_llseek,
+#endif
 };
 
 static struct mlx5_vf_migration_file *
@@ -1390,18 +1422,27 @@ static const struct vfio_device_ops mlx5vf_pci_ops = {
 	.open_device = mlx5vf_pci_open_device,
 	.close_device = mlx5vf_pci_close_device,
 	.ioctl = vfio_pci_core_ioctl,
+#ifdef HAVE_VFIO_DEVICE_OPS_GET_REGION_INFO_CAPS
 	.get_region_info_caps = vfio_pci_ioctl_get_region_info,
+#endif
 	.device_feature = vfio_pci_core_ioctl_feature,
 	.read = vfio_pci_core_read,
 	.write = vfio_pci_core_write,
 	.mmap = vfio_pci_core_mmap,
 	.request = vfio_pci_core_request,
 	.match = vfio_pci_core_match,
+#ifdef HAVE_VFIO_DEVICE_OPS_MATCH_TOKEN_UUID
+/* Newer kernels: match_token_uuid field added for VF token validation */
 	.match_token_uuid = vfio_pci_core_match_token_uuid,
+#endif
+#ifdef HAVE_SUPPORT_IOMMUFD_VFIO_PHYS_DEVICES
 	.bind_iommufd = vfio_iommufd_physical_bind,
 	.unbind_iommufd = vfio_iommufd_physical_unbind,
 	.attach_ioas = vfio_iommufd_physical_attach_ioas,
+#endif
+#ifdef HAVE_DETACH_IOAS_NDO
 	.detach_ioas = vfio_iommufd_physical_detach_ioas,
+#endif
 };
 
 static int mlx5vf_pci_probe(struct pci_dev *pdev,
@@ -1452,10 +1493,13 @@ static struct pci_driver mlx5vf_pci_driver = {
 	.probe = mlx5vf_pci_probe,
 	.remove = mlx5vf_pci_remove,
 	.err_handler = &mlx5vf_err_handlers,
+#ifdef HAVE_PCI_DRIVER_MANAGED_DMA
 	.driver_managed_dma = true,
+#endif
 };
 
 module_pci_driver(mlx5vf_pci_driver);
+#endif /* HAVE_VFIO_SUPPORT */
 
 MODULE_IMPORT_NS("IOMMUFD");
 MODULE_LICENSE("GPL");
