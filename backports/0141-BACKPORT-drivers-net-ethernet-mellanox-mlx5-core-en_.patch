From: Valentine Fatiev <valentinef@nvidia.com>
Subject: [PATCH] BACKPORT:
 drivers/net/ethernet/mellanox/mlx5/core/en_accel/ktls_rx.c

---
 .../mellanox/mlx5/core/en_accel/ktls_rx.c     | 137 +++++++++++++++++-
 1 file changed, 136 insertions(+), 1 deletion(-)

--- a/drivers/net/ethernet/mellanox/mlx5/core/en_accel/ktls_rx.c
+++ b/drivers/net/ethernet/mellanox/mlx5/core/en_accel/ktls_rx.c
@@ -1,6 +1,7 @@
 // SPDX-License-Identifier: GPL-2.0 OR Linux-OpenIB
 // Copyright (c) 2019 Mellanox Technologies.
 
+#ifdef HAVE_KTLS_RX_SUPPORT
 #include <net/inet6_hashtables.h>
 #include "en_accel/en_accel.h"
 #include "en_accel/ktls.h"
@@ -34,7 +35,9 @@ enum {
 };
 
 struct mlx5e_ktls_rx_resync_ctx {
+#ifdef HAVE_TLS_OFFLOAD_RESYNC_ASYNC_STRUCT
 	struct tls_offload_resync_async core;
+#endif
 	struct work_struct work;
 	struct mlx5e_priv *priv;
 	refcount_t refcnt;
@@ -50,7 +53,11 @@ struct mlx5e_ktls_offload_context_rx {
 	struct mlx5e_tls_sw_stats *sw_stats;
 	struct completion add_ctx;
 	struct mlx5e_tir tir;
+#ifdef HAVE_TLS_OFFLOAD_DESTRUCT_WORK
 	struct mlx5_crypto_dek *dek;
+#else
+	u32 key_id;
+#endif
 	u32 rxq;
 	DECLARE_BITMAP(flags, MLX5E_NUM_PRIV_RX_FLAGS);
 
@@ -148,7 +155,11 @@ post_static_params(struct mlx5e_icosq *s
 	wqe = MLX5E_TLS_FETCH_SET_STATIC_PARAMS_WQE(sq, pi);
 	mlx5e_ktls_build_static_params(wqe, sq->pc, sq->sqn, &priv_rx->crypto_info,
 				       mlx5e_tir_get_tirn(&priv_rx->tir),
+#ifdef HAVE_TLS_OFFLOAD_DESTRUCT_WORK
 				       mlx5_crypto_dek_get_id(priv_rx->dek),
+#else
+				       priv_rx->key_id,
+#endif
 				       priv_rx->resync.seq, false,
 				       TLS_OFFLOAD_CTX_DIR_RX);
 	wi = (struct mlx5e_icosq_wqe_info) {
@@ -320,7 +331,9 @@ err_dma_unmap:
 err_free:
 	kfree(buf);
 err_out:
+#ifndef HAVE_TLS_OFFLOAD_RX_RESYNC_ASYNC_REQUEST_FUNCS_TAKE_ASYNC /* 6.18 forwardport 426e9da3b284 c15d5c62ab31 */
 	priv_rx->rq_stats->tls_resync_req_skip++;
+#endif
 	return err;
 }
 
@@ -339,14 +352,26 @@ static void resync_handle_work(struct wo
 
 	if (unlikely(test_bit(MLX5E_PRIV_RX_FLAG_DELETING, priv_rx->flags))) {
 		mlx5e_ktls_priv_rx_put(priv_rx);
+#ifdef HAVE_TLS_OFFLOAD_RX_RESYNC_ASYNC_REQUEST_FUNCS_TAKE_ASYNC /* 6.18 forwardport 426e9da3b284 c15d5c62ab31 */
+		priv_rx->rq_stats->tls_resync_req_skip++;
+		tls_offload_rx_resync_async_request_cancel(&resync->core);
+#endif
 		return;
 	}
 
 	c = resync->priv->channels.c[priv_rx->rxq];
 	sq = &c->async_icosq;
 
+#ifdef HAVE_TLS_OFFLOAD_RX_RESYNC_ASYNC_REQUEST_FUNCS_TAKE_ASYNC /* 6.18 forwardport 426e9da3b284 c15d5c62ab31 */
+	if (resync_post_get_progress_params(sq, priv_rx)) {
+		priv_rx->rq_stats->tls_resync_req_skip++;
+		tls_offload_rx_resync_async_request_cancel(&resync->core);
+		mlx5e_ktls_priv_rx_put(priv_rx);
+	}
+#else
 	if (resync_post_get_progress_params(sq, priv_rx))
 		mlx5e_ktls_priv_rx_put(priv_rx);
+#endif
 }
 
 static void resync_init(struct mlx5e_ktls_rx_resync_ctx *resync,
@@ -382,6 +407,7 @@ static void resync_handle_seq_match(stru
 		       sizeof(info->rec_seq));
 		break;
 	}
+#ifdef HAVE_TLS_CIPHER_AES_GCM_256
 	case TLS_CIPHER_AES_GCM_256: {
 		struct tls12_crypto_info_aes_gcm_256 *info =
 			&priv_rx->crypto_info.crypto_info_256;
@@ -390,6 +416,7 @@ static void resync_handle_seq_match(stru
 		       sizeof(info->rec_seq));
 		break;
 	}
+#endif
 	default:
 		WARN_ONCE(1, "Unsupported cipher type %u\n",
 			  priv_rx->crypto_info.crypto_info.cipher_type);
@@ -425,14 +452,30 @@ void mlx5e_ktls_handle_get_psv_completio
 {
 	struct mlx5e_ktls_rx_resync_buf *buf = wi->tls_get_params.buf;
 	struct mlx5e_ktls_offload_context_rx *priv_rx;
+#ifdef HAVE_TLS_OFFLOAD_RX_RESYNC_ASYNC_REQUEST_FUNCS_TAKE_ASYNC /* 6.18 forwardport 426e9da3b284 c15d5c62ab31 */
+	struct tls_offload_resync_async *async_resync;
+	struct tls_offload_context_rx *rx_ctx;
+#endif
 	u8 tracker_state, auth_state, *ctx;
 	struct device *dev;
+#ifdef HAVE_TLS_OFFLOAD_RX_RESYNC_ASYNC_REQUEST_START
 	u32 hw_seq;
+#endif
 
 	priv_rx = buf->priv_rx;
 	dev = mlx5_core_dma_dev(sq->channel->mdev);
+#ifdef HAVE_TLS_OFFLOAD_RX_RESYNC_ASYNC_REQUEST_FUNCS_TAKE_ASYNC /* 6.18 forwardport 426e9da3b284 c15d5c62ab31 */
+	rx_ctx = tls_offload_ctx_rx(tls_get_ctx(priv_rx->sk));
+	async_resync = rx_ctx->resync_async;
+	if (unlikely(test_bit(MLX5E_PRIV_RX_FLAG_DELETING, priv_rx->flags))) {
+		priv_rx->rq_stats->tls_resync_req_skip++;
+		tls_offload_rx_resync_async_request_cancel(async_resync);
+		goto out;
+	}
+#else
 	if (unlikely(test_bit(MLX5E_PRIV_RX_FLAG_DELETING, priv_rx->flags)))
 		goto out;
+#endif
 
 	dma_sync_single_for_cpu(dev, buf->dma_addr, PROGRESS_PARAMS_PADDED_SIZE,
 				DMA_FROM_DEVICE);
@@ -443,12 +486,25 @@ void mlx5e_ktls_handle_get_psv_completio
 	if (tracker_state != MLX5E_TLS_PROGRESS_PARAMS_RECORD_TRACKER_STATE_TRACKING ||
 	    auth_state != MLX5E_TLS_PROGRESS_PARAMS_AUTH_STATE_NO_OFFLOAD) {
 		priv_rx->rq_stats->tls_resync_req_skip++;
+#ifdef HAVE_TLS_OFFLOAD_RX_RESYNC_ASYNC_REQUEST_FUNCS_TAKE_ASYNC /* 6.18 forwardport 426e9da3b284 c15d5c62ab31 */
+		tls_offload_rx_resync_async_request_cancel(async_resync);
+#endif
 		goto out;
 	}
 
+#ifdef HAVE_TLS_OFFLOAD_RX_RESYNC_ASYNC_REQUEST_START
 	hw_seq = MLX5_GET(tls_progress_params, ctx, hw_resync_tcp_sn);
+#ifdef HAVE_TLS_OFFLOAD_RX_RESYNC_ASYNC_REQUEST_FUNCS_TAKE_ASYNC /* 6.18 forwardport 426e9da3b284 c15d5c62ab31 */
+	tls_offload_rx_resync_async_request_end(async_resync,
+						cpu_to_be32(hw_seq));
+#else
 	tls_offload_rx_resync_async_request_end(priv_rx->sk, cpu_to_be32(hw_seq));
+#endif
 	priv_rx->rq_stats->tls_resync_req_end++;
+#else
+	tls_offload_rx_force_resync_request(priv_rx->sk);
+#endif
+
 out:
 	mlx5e_ktls_priv_rx_put(priv_rx);
 	dma_unmap_single(dev, buf->dma_addr, PROGRESS_PARAMS_PADDED_SIZE, DMA_FROM_DEVICE);
@@ -472,8 +528,15 @@ static bool resync_queue_get_psv(struct
 
 	resync = &priv_rx->resync;
 	mlx5e_ktls_priv_rx_get(priv_rx);
+#ifdef HAVE_TLS_OFFLOAD_RX_RESYNC_ASYNC_REQUEST_FUNCS_TAKE_ASYNC /* 6.18 forwardport 426e9da3b284 c15d5c62ab31 */
+	if (unlikely(!queue_work(resync->priv->tls->rx_wq, &resync->work))) {
+		mlx5e_ktls_priv_rx_put(priv_rx);
+		return false;
+	}
+#else
 	if (unlikely(!queue_work(resync->priv->tls->rx_wq, &resync->work)))
 		mlx5e_ktls_priv_rx_put(priv_rx);
+#endif
 
 	return true;
 }
@@ -482,13 +545,18 @@ static bool resync_queue_get_psv(struct
 static void resync_update_sn(struct mlx5e_rq *rq, struct sk_buff *skb)
 {
 	struct ethhdr *eth = (struct ethhdr *)(skb->data);
+#ifdef HAVE_TLS_OFFLOAD_RX_RESYNC_ASYNC_REQUEST_FUNCS_TAKE_ASYNC /* 6.18 forwardport 426e9da3b284 c15d5c62ab31 */
+	struct tls_offload_resync_async *resync_async;
+#endif
 	struct net_device *netdev = rq->netdev;
 	struct net *net = dev_net(netdev);
 	struct sock *sk = NULL;
+#ifdef HAVE_TLS_OFFLOAD_RX_RESYNC_ASYNC_REQUEST_START
 	unsigned int datalen;
+	__be32 seq;
+#endif
 	struct iphdr *iph;
 	struct tcphdr *th;
-	__be32 seq;
 	int depth = 0;
 
 	__vlan_get_protocol(skb, eth->h_proto, &depth);
@@ -498,9 +566,20 @@ static void resync_update_sn(struct mlx5
 		depth += sizeof(struct iphdr);
 		th = (void *)iph + sizeof(struct iphdr);
 
+#ifdef HAVE_INET_LOOKUP_ESTABLISHED_NO_HASHINFO
+		/* Newer kernels (6.18+): hashinfo fetched internally */
+		sk = inet_lookup_established(net, iph->saddr, th->source,
+				iph->daddr, th->dest,
+				netdev->ifindex);
+#else /* HAVE_INET_LOOKUP_ESTABLISHED_NO_HASHINFO */
+#ifdef HAVE_IPV4_NOT_POINTER_TCP_DEATH_ROW
 		sk = inet_lookup_established(net, net->ipv4.tcp_death_row.hashinfo,
+#else
+		sk = inet_lookup_established(net, &tcp_hashinfo,
+#endif
 					     iph->saddr, th->source, iph->daddr,
 					     th->dest, netdev->ifindex);
+#endif /* HAVE_INET_LOOKUP_ESTABLISHED_NO_HASHINFO */
 #if IS_ENABLED(CONFIG_IPV6)
 	} else {
 		struct ipv6hdr *ipv6h = (struct ipv6hdr *)iph;
@@ -508,10 +587,21 @@ static void resync_update_sn(struct mlx5
 		depth += sizeof(struct ipv6hdr);
 		th = (void *)ipv6h + sizeof(struct ipv6hdr);
 
+#ifdef HAVE_INET_LOOKUP_ESTABLISHED_NO_HASHINFO
+		/* Newer kernels (6.18+): hashinfo fetched internally */
+		sk = __inet6_lookup_established(net, &ipv6h->saddr, th->source,
+				&ipv6h->daddr, ntohs(th->dest),
+				netdev->ifindex, 0);
+#else /* HAVE_INET_LOOKUP_ESTABLISHED_NO_HASHINFO */
+#ifdef HAVE_IPV4_NOT_POINTER_TCP_DEATH_ROW
 		sk = __inet6_lookup_established(net, net->ipv4.tcp_death_row.hashinfo,
+#else
+		sk = __inet6_lookup_established(net, &tcp_hashinfo,
+#endif
 						&ipv6h->saddr, th->source,
 						&ipv6h->daddr, ntohs(th->dest),
 						netdev->ifindex, 0);
+#endif /* HAVE_INET_LOOKUP_ESTABLISHED_NO_HASHINFO */
 #endif
 	}
 
@@ -526,10 +616,19 @@ static void resync_update_sn(struct mlx5
 	if (unlikely(!resync_queue_get_psv(sk)))
 		goto unref;
 
+#ifdef HAVE_TLS_OFFLOAD_RX_RESYNC_ASYNC_REQUEST_START
 	seq = th->seq;
 	datalen = skb->len - depth;
+#ifdef HAVE_TLS_OFFLOAD_RX_RESYNC_ASYNC_REQUEST_FUNCS_TAKE_ASYNC /* 6.18 forwardport 426e9da3b284 c15d5c62ab31 */
+	resync_async = tls_offload_ctx_rx(tls_get_ctx(sk))->resync_async;
+	tls_offload_rx_resync_async_request_start(resync_async, seq, datalen);
+#else
 	tls_offload_rx_resync_async_request_start(sk, seq, datalen);
+#endif
 	rq->stats->tls_resync_req_start++;
+#else
+	tls_offload_rx_force_resync_request(sk);
+#endif
 
 unref:
 	sock_gen_put(sk);
@@ -557,6 +656,20 @@ void mlx5e_ktls_rx_resync(struct net_dev
 	resync_handle_seq_match(priv_rx, c);
 }
 
+#ifdef HAVE_TLS_OFFLOAD_RX_RESYNC_ASYNC_REQUEST_FUNCS_TAKE_ASYNC /* 6.18 forwardport 426e9da3b284 c15d5c62ab31 */
+void
+mlx5e_ktls_rx_resync_async_request_cancel(struct mlx5e_icosq_wqe_info *wi)
+{
+	struct mlx5e_ktls_offload_context_rx *priv_rx;
+	struct mlx5e_ktls_rx_resync_buf *buf;
+
+	buf = wi->tls_get_params.buf;
+	priv_rx = buf->priv_rx;
+	priv_rx->rq_stats->tls_resync_req_skip++;
+	tls_offload_rx_resync_async_request_cancel(&priv_rx->resync.core);
+}
+#endif
+
 /* End of resync section */
 
 void mlx5e_ktls_handle_rx_skb(struct mlx5e_rq *rq, struct sk_buff *skb,
@@ -609,7 +722,9 @@ int mlx5e_ktls_add_rx(struct net_device
 	struct mlx5e_ktls_offload_context_rx *priv_rx;
 	struct mlx5e_ktls_rx_resync_ctx *resync;
 	struct tls_context *tls_ctx;
+#ifdef HAVE_TLS_OFFLOAD_DESTRUCT_WORK
 	struct mlx5_crypto_dek *dek;
+#endif
 	struct mlx5e_priv *priv;
 	int rxq, err;
 
@@ -624,10 +739,12 @@ int mlx5e_ktls_add_rx(struct net_device
 		priv_rx->crypto_info.crypto_info_128 =
 			*(struct tls12_crypto_info_aes_gcm_128 *)crypto_info;
 		break;
+#ifdef HAVE_TLS_CIPHER_AES_GCM_256
 	case TLS_CIPHER_AES_GCM_256:
 		priv_rx->crypto_info.crypto_info_256 =
 			*(struct tls12_crypto_info_aes_gcm_256 *)crypto_info;
 		break;
+#endif
 	default:
 		WARN_ONCE(1, "Unsupported cipher type %u\n",
 			  crypto_info->cipher_type);
@@ -635,12 +752,19 @@ int mlx5e_ktls_add_rx(struct net_device
 		goto err_cipher_type;
 	}
 
+#ifdef HAVE_TLS_OFFLOAD_DESTRUCT_WORK
 	dek = mlx5_ktls_create_key(priv->tls->dek_pool, crypto_info);
 	if (IS_ERR(dek)) {
 		err = PTR_ERR(dek);
 		goto err_cipher_type;
 	}
 	priv_rx->dek = dek;
+#else
+	err = mlx5_ktls_create_key(priv->mdev, crypto_info, &priv_rx->key_id);
+	if (err)
+		goto err_cipher_type;
+#endif
+
 
 	INIT_LIST_HEAD(&priv_rx->list);
 	spin_lock_init(&priv_rx->lock);
@@ -662,8 +786,10 @@ int mlx5e_ktls_add_rx(struct net_device
 	accel_rule_init(&priv_rx->rule, priv);
 	resync = &priv_rx->resync;
 	resync_init(resync, priv);
+#ifdef HAVE_TLS_OFFLOAD_RESYNC_ASYNC_STRUCT
 	tls_offload_ctx_rx(tls_ctx)->resync_async = &resync->core;
 	tls_offload_rx_resync_set_type(sk, TLS_OFFLOAD_SYNC_TYPE_DRIVER_REQ_ASYNC);
+#endif
 
 	err = post_rx_param_wqes(priv->channels.c[rxq], priv_rx, start_offload_tcp_sn);
 	if (err)
@@ -676,7 +802,11 @@ int mlx5e_ktls_add_rx(struct net_device
 err_post_wqes:
 	mlx5e_tir_destroy(&priv_rx->tir);
 err_create_tir:
+#ifdef HAVE_TLS_OFFLOAD_DESTRUCT_WORK
 	mlx5_ktls_destroy_key(priv->tls->dek_pool, priv_rx->dek);
+#else
+	mlx5_ktls_destroy_key(priv->mdev, priv_rx->key_id);
+#endif
 err_cipher_type:
 	kfree(priv_rx);
 	return err;
@@ -708,7 +838,11 @@ void mlx5e_ktls_del_rx(struct net_device
 		mlx5e_accel_fs_del_sk(priv_rx->rule.rule);
 
 	mlx5e_tir_destroy(&priv_rx->tir);
+#ifdef HAVE_TLS_OFFLOAD_DESTRUCT_WORK
 	mlx5_ktls_destroy_key(priv->tls->dek_pool, priv_rx->dek);
+#else
+	mlx5_ktls_destroy_key(priv->mdev, priv_rx->key_id);
+#endif
 	/* priv_rx should normally be freed here, but if there is an outstanding
 	 * GET_PSV, deallocation will be delayed until the CQE for GET_PSV is
 	 * processed.
@@ -781,3 +915,4 @@ bool mlx5e_ktls_rx_handle_resync_list(st
 
 	return i == budget;
 }
+#endif /* HAVE_KTLS_RX_SUPPORT */
