From: Valentine Fatiev <valentinef@nvidia.com>
Subject: [PATCH] BACKPORT: drivers/net/ethernet/mellanox/mlx5/core/en_fs.c

---
 .../net/ethernet/mellanox/mlx5/core/en_fs.c   | 26 +++++++++++++++----
 1 file changed, 21 insertions(+), 5 deletions(-)

diff --git a/drivers/net/ethernet/mellanox/mlx5/core/en_fs.c b/drivers/net/ethernet/mellanox/mlx5/core/en_fs.c
index xxxxxxx..xxxxxxx 100644
--- a/drivers/net/ethernet/mellanox/mlx5/core/en_fs.c
+++ b/drivers/net/ethernet/mellanox/mlx5/core/en_fs.c
@@ -483,9 +483,15 @@ static int mlx5e_vlan_rx_add_svid(struct mlx5e_flow_steering *fs,
 	}
 
 	/* Need to fix some features.. */
+#ifdef HAVE_NETDEVICE_NETDEV_LOCK
+	/* Upstream commit 8f7b00307bf1: added lock (no lock before) */
 	netdev_lock(netdev);
+#endif
 	netdev_update_features(netdev);
+#ifdef HAVE_NETDEVICE_NETDEV_LOCK
+	/* Upstream commit 8f7b00307bf1: added unlock (no lock before) */
 	netdev_unlock(netdev);
+#endif
 	return err;
 }
 
@@ -522,9 +528,15 @@ int mlx5e_fs_vlan_rx_kill_vid(struct mlx5e_flow_steering *fs,
 	} else if (be16_to_cpu(proto) == ETH_P_8021AD) {
 		clear_bit(vid, fs->vlan->active_svlans);
 		mlx5e_fs_del_vlan_rule(fs, MLX5E_VLAN_RULE_TYPE_MATCH_STAG_VID, vid);
+#ifdef HAVE_NETDEVICE_NETDEV_LOCK
+		/* Upstream commit 8f7b00307bf1: added lock (no lock before) */
 		netdev_lock(netdev);
+#endif
 		netdev_update_features(netdev);
+#ifdef HAVE_NETDEVICE_NETDEV_LOCK
+		/* Upstream commit 8f7b00307bf1: added unlock (no lock before) */
 		netdev_unlock(netdev);
+#endif
 	}
 
 	return 0;
@@ -835,11 +847,6 @@ void mlx5e_fs_set_rx_mode_work(struct mlx5e_flow_steering *fs,
 	struct mlx5e_priv *priv = netdev_priv(netdev);
 	struct mlx5e_l2_table *ea = &fs->l2;
 
-	if (mlx5e_is_uplink_rep(priv)) {
-		mlx5e_handle_netdev_addr(fs, netdev, uc, mc);
-		goto update_vport_context;
-	}
-
 	bool rx_mode_enable  = fs->state_destroy;
 	bool promisc_enabled   = rx_mode_enable && (netdev->flags & IFF_PROMISC);
 	bool allmulti_enabled  = rx_mode_enable && (netdev->flags & IFF_ALLMULTI);
@@ -853,6 +860,11 @@ void mlx5e_fs_set_rx_mode_work(struct mlx5e_flow_steering *fs,
 	bool disable_broadcast =  ea->broadcast_enabled && !broadcast_enabled;
 	int err;
 
+	if (mlx5e_is_uplink_rep(priv)) {
+		mlx5e_handle_netdev_addr(fs, netdev, uc, mc);
+		goto update_vport_context;
+	}
+
 	if (enable_promisc) {
 		err = mlx5e_create_promisc_table(fs);
 		if (err)
@@ -935,9 +947,13 @@ static void mlx5e_set_inner_ttc_params(struct mlx5e_flow_steering *fs,
 
 static bool mlx5e_ipsec_rss_supported(struct mlx5_core_dev *mdev)
 {
+#ifdef HAVE_RSS_CRYPTO_OFFLOAD_ENABLED
 	return MLX5_CAP_NIC_RX_FT_FIELD_SUPPORT_2(mdev, ipsec_next_header) &&
 	       MLX5_CAP_NIC_RX_FT_FIELD_SUPPORT_2(mdev, outer_l4_type_ext) &&
 	       MLX5_CAP_NIC_RX_FT_FIELD_SUPPORT_2(mdev, inner_l4_type_ext);
+#else
+	return false;
+#endif
 }
 
 void mlx5e_set_ttc_params(struct mlx5e_flow_steering *fs,
