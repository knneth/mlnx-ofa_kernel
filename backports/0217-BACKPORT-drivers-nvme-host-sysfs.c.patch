From: Valentine Fatiev <valentinef@nvidia.com>
Subject: [PATCH] BACKPORT: drivers/nvme/host/sysfs.c

---
 drivers/nvme/host/sysfs.c | 30 ++++++++++++++++++++++++++++++
 1 file changed, 30 insertions(+)

diff --git a/drivers/nvme/host/sysfs.c b/drivers/nvme/host/sysfs.c
index xxxxxxx..xxxxxxx 100644
--- a/drivers/nvme/host/sysfs.c
+++ b/drivers/nvme/host/sysfs.c
@@ -5,7 +5,9 @@
  * Copyright (c) 2011-2014, Intel Corporation.
  */
 
+#ifdef HAVE_NVME_AUTH_TRANSFORM_KEY_DHCHAP
 #include <linux/nvme-auth.h>
+#endif
 
 #include "nvme.h"
 #include "fabrics.h"
@@ -312,6 +314,7 @@ static const struct attribute_group nvme_ns_attr_group = {
 	.is_visible	= nvme_ns_attrs_are_visible,
 };
 
+#ifdef HAVE_GD_ADDED
 #ifdef CONFIG_NVME_MULTIPATH
 /*
  * NOTE: The dummy attribute does not appear in sysfs. It exists solely to allow
@@ -329,6 +332,7 @@ static struct attribute *nvme_ns_mpath_attrs[] = {
 	NULL,
 };
 
+#ifdef HAVE_SYSFS_GROUP_INVISIBLE
 static bool multipath_sysfs_group_visible(struct kobject *kobj)
 {
 	struct device *dev = container_of(kobj, struct device, kobj);
@@ -343,18 +347,33 @@ static bool multipath_sysfs_attr_visible(struct kobject *kobj,
 }
 
 DEFINE_SYSFS_GROUP_VISIBLE(multipath_sysfs)
+#else
+static umode_t nvme_ns_mpath_attr_is_visible(struct kobject *kobj,
+		struct attribute *attr, int n)
+{
+	return 0;
+}
+#endif
 
 const struct attribute_group nvme_ns_mpath_attr_group = {
 	.name           = "multipath",
 	.attrs		= nvme_ns_mpath_attrs,
+
+#ifdef HAVE_SYSFS_GROUP_INVISIBLE
 	.is_visible     = SYSFS_GROUP_VISIBLE(multipath_sysfs),
+#else
+	.is_visible     = nvme_ns_mpath_attr_is_visible,
+#endif
 };
 #endif
+#endif
 
 const struct attribute_group *nvme_ns_attr_groups[] = {
 	&nvme_ns_attr_group,
+#ifdef HAVE_GD_ADDED
 #ifdef CONFIG_NVME_MULTIPATH
 	&nvme_ns_mpath_attr_group,
+#endif
 #endif
 	NULL,
 };
@@ -401,6 +420,7 @@ static ssize_t nvme_sysfs_delete(struct device *dev,
 		nvme_delete_ctrl_sync(ctrl);
 	return count;
 }
+
 static DEVICE_ATTR(delete_controller, S_IWUSR, NULL, nvme_sysfs_delete);
 
 static ssize_t nvme_sysfs_show_transport(struct device *dev,
@@ -636,7 +656,12 @@ static ssize_t nvme_ctrl_dhchap_secret_store(struct device *dev,
 		struct nvme_dhchap_key *key, *host_key;
 		int ret;
 
+#ifdef HAVE_NVME_AUTH_PARSE_KEY
+		/* Newer kernels (7.1+): function renamed to nvme_auth_parse_key */
+		ret = nvme_auth_parse_key(dhchap_secret, &key);
+#else
 		ret = nvme_auth_generate_key(dhchap_secret, &key);
+#endif
 		if (ret) {
 			kfree(dhchap_secret);
 			return ret;
@@ -694,7 +719,12 @@ static ssize_t nvme_ctrl_dhchap_ctrl_secret_store(struct device *dev,
 		struct nvme_dhchap_key *key, *ctrl_key;
 		int ret;
 
+#ifdef HAVE_NVME_AUTH_PARSE_KEY
+		/* Newer kernels (7.1+): function renamed to nvme_auth_parse_key */
+		ret = nvme_auth_parse_key(dhchap_secret, &key);
+#else
 		ret = nvme_auth_generate_key(dhchap_secret, &key);
+#endif
 		if (ret) {
 			kfree(dhchap_secret);
 			return ret;
