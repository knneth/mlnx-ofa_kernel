From: Valentine Fatiev <valentinef@nvidia.com>
Subject: [PATCH] BACKPORT: drivers/net/ethernet/mellanox/mlx5/core/en_dcbnl.c

---
 drivers/net/ethernet/mellanox/mlx5/core/en_dcbnl.c | 14 +++++++++++++-
 1 file changed, 13 insertions(+), 1 deletion(-)

--- a/drivers/net/ethernet/mellanox/mlx5/core/en_dcbnl.c
+++ b/drivers/net/ethernet/mellanox/mlx5/core/en_dcbnl.c
@@ -76,6 +76,7 @@ static const struct {
 				   MLX5_CAP_QCAM_REG(mdev, qpts) && \
 				   MLX5_CAP_QCAM_REG(mdev, qpdpm))
 
+#ifdef CONFIG_MLX5_CORE_EN_DCB
 static int mlx5e_set_trust_state(struct mlx5e_priv *priv, u8 trust_state);
 static int mlx5e_set_dscp2prio(struct mlx5e_priv *priv, u8 dscp, u8 prio);
 
@@ -1185,7 +1186,10 @@ static int mlx5e_set_trust_state(struct
 	bool reset = true;
 	int err;
 
+#ifdef HAVE_NETDEVICE_NETDEV_LOCK
+	/* Upstream commit 8f7b00307bf1: added lock (no lock before) */
 	netdev_lock(priv->netdev);
+#endif
 	mutex_lock(&priv->state_lock);
 	mqprio.mode = priv->channels.params.mqprio.mode;
 	if (mqprio.mode != TC_MQPRIO_MODE_DCB) {
@@ -1209,12 +1213,16 @@ static int mlx5e_set_trust_state(struct
 unlock:
 	mutex_unlock(&priv->state_lock);
 	if (err) {
+#ifdef HAVE_NETDEVICE_NETDEV_LOCK
+	/* Upstream commit 8f7b00307bf1: added unlock (no lock before) */
 		netdev_unlock(priv->netdev);
+#endif
 		return err;
 	}
 
 	/* In DSCP trust state, we need 8 send queues per channel */
-	if (priv->dcbx_dp.trust_state == MLX5_QPTS_TRUST_DSCP) {
+	if (priv->dcbx_dp.trust_state == MLX5_QPTS_TRUST_DSCP)
+	{
 		mutex_lock(&priv->state_lock);
 		mlx5e_setup_tc_mqprio(priv, &mqprio);
 		mutex_unlock(&priv->state_lock);
@@ -1225,7 +1233,10 @@ unlock:
 		mutex_unlock(&priv->state_lock);
 	}
 
+#ifdef HAVE_NETDEVICE_NETDEV_LOCK
+	/* Upstream commit 8f7b00307bf1: added unlock (no lock before) */
 	netdev_unlock(priv->netdev);
+#endif
 	return 0;
 }
 
@@ -1329,3 +1340,4 @@ void mlx5e_dcbnl_initialize(struct mlx5e
 
 	mlx5e_ets_init(priv);
 }
+#endif
