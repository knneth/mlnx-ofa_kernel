From: Oren Sidi <osidi@nvidia.com>
Subject: [PATCH] BACKPORT: drivers/net/ethernet/mellanox/mlx5/core/wc.c

Change-Id: Icdbe2ee72285a9454349597a75f3b2e3764119cb
---
 drivers/net/ethernet/mellanox/mlx5/core/wc.c | 9 +++++++++
 1 file changed, 9 insertions(+)

--- a/drivers/net/ethernet/mellanox/mlx5/core/wc.c
+++ b/drivers/net/ethernet/mellanox/mlx5/core/wc.c
@@ -264,7 +264,12 @@ static void mlx5_iowrite64_copy(struct m
 {
 #if IS_ENABLED(CONFIG_KERNEL_MODE_NEON) && IS_ENABLED(CONFIG_ARM64)
 	if (cpu_has_neon()) {
+#ifdef HAVE_KERNEL_NEON_BEGIN_END_1_PARAM 
+		struct user_fpsimd_state efi_fpsimd_state;
+		kernel_neon_begin(&efi_fpsimd_state);
+#else
 		kernel_neon_begin();
+#endif
 		asm volatile
 		(".arch_extension simd\n\t"
 		"ld1 {v0.16b, v1.16b, v2.16b, v3.16b}, [%0]\n\t"
@@ -272,7 +277,11 @@ static void mlx5_iowrite64_copy(struct m
 		:
 		: "r"(mmio_wqe), "r"(sq->bfreg.map + offset)
 		: "memory", "v0", "v1", "v2", "v3");
+#ifdef HAVE_KERNEL_NEON_BEGIN_END_1_PARAM 
+		kernel_neon_end(&efi_fpsimd_state);
+#else
 		kernel_neon_end();
+#endif
 		return;
 	}
 #endif
