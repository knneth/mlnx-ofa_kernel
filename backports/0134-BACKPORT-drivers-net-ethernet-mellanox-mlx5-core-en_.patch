From: Valentine Fatiev <valentinef@nvidia.com>
Subject: [PATCH] BACKPORT:
 drivers/net/ethernet/mellanox/mlx5/core/en_accel/psp.c

---
 .../net/ethernet/mellanox/mlx5/core/en_accel/psp.c  | 13 +++++++++++++
 1 file changed, 13 insertions(+)

diff --git a/drivers/net/ethernet/mellanox/mlx5/core/en_accel/psp.c b/drivers/net/ethernet/mellanox/mlx5/core/en_accel/psp.c
index xxxxxxx..xxxxxxx 100644
--- a/drivers/net/ethernet/mellanox/mlx5/core/en_accel/psp.c
+++ b/drivers/net/ethernet/mellanox/mlx5/core/en_accel/psp.c
@@ -1,14 +1,17 @@
 // SPDX-License-Identifier: GPL-2.0 OR Linux-OpenIB
 /* Copyright (c) 2023, NVIDIA CORPORATION & AFFILIATES. All rights reserved. */
 #include <linux/mlx5/device.h>
+#if defined(CONFIG_MLX5_EN_PSP) && defined(HAVE_NET_PSP_H)
 #include <net/psp.h>
 #include <linux/psp.h>
+#endif
 #include "mlx5_core.h"
 #include "psp.h"
 #include "lib/crypto.h"
 #include "en_accel/psp.h"
 #include "fs_core.h"
 
+#if defined(CONFIG_MLX5_EN_PSP) && defined(HAVE_NET_PSP_H)
 enum accel_fs_psp_type {
 	ACCEL_FS_PSP4,
 	ACCEL_FS_PSP6,
@@ -834,6 +837,8 @@ static int accel_psp_fs_init_tx(struct mlx5e_psp_fs *fs)
 	return 0;
 }
 
+#ifdef HAVE_PSP_DEV_STATS
+/* Newer kernels (6.19+): PSP driver-facing stats API added upstream */
 static void
 mlx5e_accel_psp_fs_get_stats_fill(struct mlx5e_priv *priv,
 				  struct mlx5e_psp_stats *stats)
@@ -867,6 +872,7 @@ mlx5e_accel_psp_fs_get_stats_fill(struct mlx5e_priv *priv,
 			      &stats->psp_rx_pkts_drop,
 			      &stats->psp_rx_bytes_drop);
 }
+#endif
 
 void mlx5_accel_psp_fs_cleanup_tx_tables(struct mlx5e_priv *priv)
 {
@@ -1042,6 +1048,8 @@ mlx5e_psp_key_rotate(struct psp_dev *psd, struct netlink_ext_ack *exack)
 	return mlx5e_psp_rotate_key(priv->mdev);
 }
 
+#ifdef HAVE_PSP_DEV_STATS
+/* Newer kernels (6.19+): get_stats callback added to psp_dev_ops */
 static void
 mlx5e_psp_get_stats(struct psp_dev *psd, struct psp_dev_stats *stats)
 {
@@ -1058,6 +1066,7 @@ mlx5e_psp_get_stats(struct psp_dev *psd, struct psp_dev_stats *stats)
 	stats->tx_bytes = nstats.psp_tx_bytes;
 	stats->tx_error = atomic_read(&priv->psp->tx_drop);
 }
+#endif
 
 static struct psp_dev_ops mlx5_psp_ops = {
 	.set_config   = mlx5e_psp_set_config,
@@ -1065,7 +1074,10 @@ static struct psp_dev_ops mlx5_psp_ops = {
 	.tx_key_add   = mlx5e_psp_assoc_add,
 	.tx_key_del   = mlx5e_psp_assoc_del,
 	.key_rotate   = mlx5e_psp_key_rotate,
+#ifdef HAVE_PSP_DEV_STATS
+/* Newer kernels (6.19+): get_stats callback required by psp_dev_create */
 	.get_stats    = mlx5e_psp_get_stats,
+#endif
 };
 
 void mlx5e_psp_unregister(struct mlx5e_priv *priv)
@@ -1165,3 +1177,4 @@ void mlx5e_psp_cleanup(struct mlx5e_priv *priv)
 	priv->psp = NULL;
 	kfree(psp);
 }
+#endif /* CONFIG_MLX5_EN_PSP && HAVE_NET_PSP_H */
