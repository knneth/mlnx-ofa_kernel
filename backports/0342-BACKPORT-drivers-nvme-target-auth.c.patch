From: Valentine Fatiev <valentinef@nvidia.com>
Subject: [PATCH] BACKPORT: drivers/nvme/target/auth.c

---
 drivers/nvme/target/auth.c | 192 +++++++++++++++++++++++++++++++++++--
 1 file changed, 186 insertions(+), 6 deletions(-)

diff --git a/drivers/nvme/target/auth.c b/drivers/nvme/target/auth.c
index xxxxxxx..xxxxxxx 100644
--- a/drivers/nvme/target/auth.c
+++ b/drivers/nvme/target/auth.c
@@ -4,6 +4,9 @@
  * Copyright (c) 2020 Hannes Reinecke, SUSE Software Solutions.
  * All rights reserved.
  */
+
+#ifdef HAVE_NVME_AUTH_TRANSFORM_KEY_DHCHAP
+
 #ifdef pr_fmt
 #undef pr_fmt
 #endif
@@ -19,6 +22,9 @@
 #include <linux/nvme-auth.h>
 #include <linux/nvme-keyring.h>
 #include <linux/unaligned.h>
+#ifndef HAVE_HMAC_SHA256_INIT_USINGRAWKEY
+#include <crypto/hash.h>
+#endif
 
 #include "nvmet.h"
 
@@ -283,7 +289,12 @@ bool nvmet_check_auth_status(struct nvmet_req *req)
 int nvmet_auth_host_hash(struct nvmet_req *req, u8 *response,
 			 unsigned int shash_len)
 {
+#ifdef HAVE_HMAC_SHA256_INIT_USINGRAWKEY
 	struct nvme_auth_hmac_ctx hmac;
+#else
+	struct crypto_shash *shash_tfm = NULL;
+	struct shash_desc *shash = NULL;
+#endif
 	struct nvmet_ctrl *ctrl = req->sq->ctrl;
 	u8 *challenge = req->sq->dhchap_c1;
 	struct nvme_dhchap_key *transformed_key;
@@ -295,10 +306,40 @@ int nvmet_auth_host_hash(struct nvmet_req *req, u8 *response,
 	if (IS_ERR(transformed_key))
 		return PTR_ERR(transformed_key);
 
+#ifdef HAVE_HMAC_SHA256_INIT_USINGRAWKEY
 	ret = nvme_auth_hmac_init(&hmac, ctrl->shash_id, transformed_key->key,
 				  transformed_key->len);
 	if (ret)
 		goto out_free_response;
+#else
+	{
+		const char *hash_name = nvme_auth_hmac_name(ctrl->shash_id);
+
+		if (!hash_name) {
+			pr_warn("Hash ID %d invalid\n", ctrl->shash_id);
+			ret = -EINVAL;
+			goto out_free_response;
+		}
+		shash_tfm = crypto_alloc_shash(hash_name, 0, 0);
+		if (IS_ERR(shash_tfm)) {
+			pr_err("failed to allocate shash %s\n", hash_name);
+			ret = PTR_ERR(shash_tfm);
+			shash_tfm = NULL;
+			goto out_free_response;
+		}
+	}
+	ret = crypto_shash_setkey(shash_tfm, transformed_key->key,
+				  transformed_key->len);
+	if (ret)
+		goto out_free_response;
+	shash = kzalloc(sizeof(*shash) + crypto_shash_descsize(shash_tfm),
+			GFP_KERNEL);
+	if (!shash) {
+		ret = -ENOMEM;
+		goto out_free_response;
+	}
+	shash->tfm = shash_tfm;
+#endif
 
 	if (shash_len != nvme_auth_hmac_hash_len(ctrl->shash_id)) {
 		pr_err("%s: hash len mismatch (len %u digest %zu)\n", __func__,
@@ -325,14 +366,12 @@ int nvmet_auth_host_hash(struct nvmet_req *req, u8 *response,
 		 ctrl->cntlid, req->sq->qid, req->sq->dhchap_s1,
 		 req->sq->dhchap_tid);
 
+#ifdef HAVE_HMAC_SHA256_INIT_USINGRAWKEY
 	nvme_auth_hmac_update(&hmac, challenge, shash_len);
-
 	put_unaligned_le32(req->sq->dhchap_s1, buf);
 	nvme_auth_hmac_update(&hmac, buf, 4);
-
 	put_unaligned_le16(req->sq->dhchap_tid, buf);
 	nvme_auth_hmac_update(&hmac, buf, 2);
-
 	*buf = req->sq->sc_c;
 	nvme_auth_hmac_update(&hmac, buf, 1);
 	nvme_auth_hmac_update(&hmac, "HostHost", 8);
@@ -350,12 +389,60 @@ out_free_response:
 	memzero_explicit(&hmac, sizeof(hmac));
 	nvme_auth_free_key(transformed_key);
 	return ret;
+#else
+	ret = crypto_shash_init(shash);
+	if (ret)
+		goto out_free_challenge;
+	ret = crypto_shash_update(shash, challenge, shash_len);
+	if (ret)
+		goto out_free_challenge;
+	put_unaligned_le32(req->sq->dhchap_s1, buf);
+	ret = crypto_shash_update(shash, buf, 4);
+	if (ret)
+		goto out_free_challenge;
+	put_unaligned_le16(req->sq->dhchap_tid, buf);
+	ret = crypto_shash_update(shash, buf, 2);
+	if (ret)
+		goto out_free_challenge;
+	*buf = req->sq->sc_c;
+	ret = crypto_shash_update(shash, buf, 1);
+	if (ret)
+		goto out_free_challenge;
+	ret = crypto_shash_update(shash, "HostHost", 8);
+	if (ret)
+		goto out_free_challenge;
+	ret = crypto_shash_update(shash, ctrl->hostnqn, strlen(ctrl->hostnqn));
+	if (ret)
+		goto out_free_challenge;
+	memset(buf, 0, 4);
+	ret = crypto_shash_update(shash, buf, 1);
+	if (ret)
+		goto out_free_challenge;
+	ret = crypto_shash_update(shash, ctrl->subsys->subsysnqn,
+				  strlen(ctrl->subsys->subsysnqn));
+	if (ret)
+		goto out_free_challenge;
+	ret = crypto_shash_final(shash, response);
+out_free_challenge:
+	if (challenge != req->sq->dhchap_c1)
+		kfree(challenge);
+out_free_response:
+	kfree(shash);
+	nvme_auth_free_key(transformed_key);
+	crypto_free_shash(shash_tfm);
+	return ret;
+#endif
 }
 
 int nvmet_auth_ctrl_hash(struct nvmet_req *req, u8 *response,
 			 unsigned int shash_len)
 {
+#ifdef HAVE_HMAC_SHA256_INIT_USINGRAWKEY
 	struct nvme_auth_hmac_ctx hmac;
+#else
+	struct crypto_shash *shash_tfm = NULL;
+	struct shash_desc *shash = NULL;
+#endif
 	struct nvmet_ctrl *ctrl = req->sq->ctrl;
 	u8 *challenge = req->sq->dhchap_c2;
 	struct nvme_dhchap_key *transformed_key;
@@ -367,10 +454,40 @@ int nvmet_auth_ctrl_hash(struct nvmet_req *req, u8 *response,
 	if (IS_ERR(transformed_key))
 		return PTR_ERR(transformed_key);
 
+#ifdef HAVE_HMAC_SHA256_INIT_USINGRAWKEY
 	ret = nvme_auth_hmac_init(&hmac, ctrl->shash_id, transformed_key->key,
 				  transformed_key->len);
 	if (ret)
 		goto out_free_response;
+#else
+	{
+		const char *hash_name = nvme_auth_hmac_name(ctrl->shash_id);
+
+		if (!hash_name) {
+			pr_warn("Hash ID %d invalid\n", ctrl->shash_id);
+			ret = -EINVAL;
+			goto out_free_response;
+		}
+		shash_tfm = crypto_alloc_shash(hash_name, 0, 0);
+		if (IS_ERR(shash_tfm)) {
+			pr_err("failed to allocate shash %s\n", hash_name);
+			ret = PTR_ERR(shash_tfm);
+			shash_tfm = NULL;
+			goto out_free_response;
+		}
+	}
+	ret = crypto_shash_setkey(shash_tfm, transformed_key->key,
+				  transformed_key->len);
+	if (ret)
+		goto out_free_response;
+	shash = kzalloc(sizeof(*shash) + crypto_shash_descsize(shash_tfm),
+			GFP_KERNEL);
+	if (!shash) {
+		ret = -ENOMEM;
+		goto out_free_response;
+	}
+	shash->tfm = shash_tfm;
+#endif
 
 	if (shash_len != nvme_auth_hmac_hash_len(ctrl->shash_id)) {
 		pr_err("%s: hash len mismatch (len %u digest %zu)\n", __func__,
@@ -394,14 +511,12 @@ int nvmet_auth_ctrl_hash(struct nvmet_req *req, u8 *response,
 			goto out_free_challenge;
 	}
 
+#ifdef HAVE_HMAC_SHA256_INIT_USINGRAWKEY
 	nvme_auth_hmac_update(&hmac, challenge, shash_len);
-
 	put_unaligned_le32(req->sq->dhchap_s2, buf);
 	nvme_auth_hmac_update(&hmac, buf, 4);
-
 	put_unaligned_le16(req->sq->dhchap_tid, buf);
 	nvme_auth_hmac_update(&hmac, buf, 2);
-
 	*buf = req->sq->sc_c;
 	nvme_auth_hmac_update(&hmac, buf, 1);
 	nvme_auth_hmac_update(&hmac, "Controller", 10);
@@ -419,6 +534,49 @@ out_free_response:
 	memzero_explicit(&hmac, sizeof(hmac));
 	nvme_auth_free_key(transformed_key);
 	return ret;
+#else
+	ret = crypto_shash_init(shash);
+	if (ret)
+		goto out_free_challenge;
+	ret = crypto_shash_update(shash, challenge, shash_len);
+	if (ret)
+		goto out_free_challenge;
+	put_unaligned_le32(req->sq->dhchap_s2, buf);
+	ret = crypto_shash_update(shash, buf, 4);
+	if (ret)
+		goto out_free_challenge;
+	put_unaligned_le16(req->sq->dhchap_tid, buf);
+	ret = crypto_shash_update(shash, buf, 2);
+	if (ret)
+		goto out_free_challenge;
+	*buf = req->sq->sc_c;
+	ret = crypto_shash_update(shash, buf, 1);
+	if (ret)
+		goto out_free_challenge;
+	ret = crypto_shash_update(shash, "Controller", 10);
+	if (ret)
+		goto out_free_challenge;
+	ret = crypto_shash_update(shash, ctrl->subsys->subsysnqn,
+			    strlen(ctrl->subsys->subsysnqn));
+	if (ret)
+		goto out_free_challenge;
+	memset(buf, 0, 4);
+	ret = crypto_shash_update(shash, buf, 1);
+	if (ret)
+		goto out_free_challenge;
+	ret = crypto_shash_update(shash, ctrl->hostnqn, strlen(ctrl->hostnqn));
+	if (ret)
+		goto out_free_challenge;
+	ret = crypto_shash_final(shash, response);
+out_free_challenge:
+	if (challenge != req->sq->dhchap_c2)
+		kfree(challenge);
+out_free_response:
+	kfree(shash);
+	nvme_auth_free_key(transformed_key);
+	crypto_free_shash(shash_tfm);
+	return ret;
+#endif
 }
 
 int nvmet_auth_ctrl_exponential(struct nvmet_req *req,
@@ -452,10 +610,15 @@ int nvmet_auth_ctrl_sesskey(struct nvmet_req *req,
 	struct nvmet_ctrl *ctrl = req->sq->ctrl;
 	int ret;
 
+#ifdef HAVE_HMAC_SHA256_INIT_USINGRAWKEY
 	req->sq->dhchap_skey_len = nvme_auth_hmac_hash_len(ctrl->shash_id);
+#else
+	req->sq->dhchap_skey_len = ctrl->dh_keysize;
+#endif
 	req->sq->dhchap_skey = kzalloc(req->sq->dhchap_skey_len, GFP_KERNEL);
 	if (!req->sq->dhchap_skey)
 		return -ENOMEM;
+#ifdef HAVE_HMAC_SHA256_INIT_USINGRAWKEY
 	ret = nvme_auth_gen_session_key(ctrl->dh_tfm,
 					pkey, pkey_size,
 					req->sq->dhchap_skey,
@@ -468,6 +631,18 @@ int nvmet_auth_ctrl_sesskey(struct nvmet_req *req,
 		pr_debug("%s: session key %*ph\n", __func__,
 			 (int)req->sq->dhchap_skey_len,
 			 req->sq->dhchap_skey);
+#endif
+#else
+	ret = nvme_auth_gen_shared_secret(ctrl->dh_tfm,
+					  pkey, pkey_size,
+					  req->sq->dhchap_skey,
+					  req->sq->dhchap_skey_len);
+	if (ret)
+		pr_debug("failed to compute shared secret, err %d\n", ret);
+	else
+		pr_debug("%s: shared secret %*ph\n", __func__,
+			 (int)req->sq->dhchap_skey_len,
+			 req->sq->dhchap_skey);
 #endif
 	return ret;
 }
@@ -476,7 +651,11 @@ void nvmet_auth_insert_psk(struct nvmet_sq *sq)
 {
 	int hash_len = nvme_auth_hmac_hash_len(sq->ctrl->shash_id);
 	u8 *psk, *tls_psk;
+#ifdef HAVE_HMAC_SHA256_INIT_USINGRAWKEY
 	char *digest;
+#else
+	u8 *digest;
+#endif
 	size_t psk_len;
 	int ret;
 #ifdef CONFIG_NVME_TARGET_TCP_TLS
@@ -528,3 +707,4 @@ out_free_digest:
 out_free_psk:
 	kfree_sensitive(psk);
 }
+#endif
