@@ -329,22 +451,39 @@ static int nvme_auth_hash_skey(int hmac_id, u8 *skey, size_t skey_len, u8 *hkey)
 	return ret;
 }
 
+#ifdef HAVE_NVME_AUTH_GENERATE_DIGEST_GET_CHAR
+/* Newer kernels (7.1+): skey and challenge are now const */
+int nvme_auth_augmented_challenge(u8 hmac_id, const u8 *skey, size_t skey_len,
+		const u8 *challenge, u8 *aug, size_t hlen)
+#else
 int nvme_auth_augmented_challenge(u8 hmac_id, u8 *skey, size_t skey_len,
 		u8 *challenge, u8 *aug, size_t hlen)
+#endif
 {
 	struct crypto_shash *tfm;
-	u8 *hashed_key;
 	const char *hmac_name;
-	int ret;
+	const u8 *hmac_key;
+	size_t hmac_key_len;
+	int ret = 0;
+#ifndef HAVE_NVME_AUTH_GEN_SESSION_KEY
+	/* Older kernels: session key is raw DH secret, hash it before use as HMAC key */
+	u8 *hashed_key;
 
 	hashed_key = kmalloc(hlen, GFP_KERNEL);
 	if (!hashed_key)
 		return -ENOMEM;
-
-	ret = nvme_auth_hash_skey(hmac_id, skey,
-				  skey_len, hashed_key);
-	if (ret < 0)
-		goto out_free_key;
+	ret = nvme_auth_hash_skey(hmac_id, skey, skey_len, hashed_key);
+	if (ret < 0) {
+		kfree_sensitive(hashed_key);
+		return ret;
+	}
+	hmac_key = hashed_key;
+	hmac_key_len = hlen;
+#else
+	/* Newer kernels (7.1+): session key is already H(g^xy mod p) */
+	hmac_key = skey;
+	hmac_key_len = skey_len;
+#endif
 
 	hmac_name = nvme_auth_hmac_name(hmac_id);
 	if (!hmac_name) {
@@ -360,7 +499,7 @@ int nvme_auth_augmented_challenge(u8 hmac_id, u8 *skey, size_t skey_len,
 		goto out_free_key;
 	}
 
-	ret = crypto_shash_setkey(tfm, hashed_key, hlen);
+	ret = crypto_shash_setkey(tfm, hmac_key, hmac_key_len);
 	if (ret)
 		goto out_free_hash;
 
@@ -368,7 +507,9 @@ int nvme_auth_augmented_challenge(u8 hmac_id, u8 *skey, size_t skey_len,
 out_free_hash:
 	crypto_free_shash(tfm);
 out_free_key:
+#ifndef HAVE_NVME_AUTH_GEN_SESSION_KEY
 	kfree_sensitive(hashed_key);
+#endif
 	return ret;
 }
 EXPORT_SYMBOL_GPL(nvme_auth_augmented_challenge);
@@ -410,8 +551,15 @@ int nvme_auth_gen_pubkey(struct crypto_kpp *dh_tfm,
 }
 EXPORT_SYMBOL_GPL(nvme_auth_gen_pubkey);
 
+#ifndef HAVE_NVME_AUTH_GEN_SESSION_KEY
+/* Older kernels: raw DH shared secret stored as session key */
 int nvme_auth_gen_shared_secret(struct crypto_kpp *dh_tfm,
+#ifdef HAVE_NVME_AUTH_GENERATE_DIGEST_GET_CHAR
+/* Newer kernels (7.1+): ctrl_key is now const */
+		const u8 *ctrl_key, size_t ctrl_key_len,
+#else
 		u8 *ctrl_key, size_t ctrl_key_len,
+#endif
 		u8 *sess_key, size_t sess_key_len)
 {
 	struct kpp_request *req;
@@ -437,8 +585,71 @@ int nvme_auth_gen_shared_secret(struct crypto_kpp *dh_tfm,
 	return ret;
 }
 EXPORT_SYMBOL_GPL(nvme_auth_gen_shared_secret);
+#else
+/* Newer kernels (7.1+): session key is H(g^xy mod p), hashed after DH computation */
+int nvme_auth_gen_session_key(struct crypto_kpp *dh_tfm,
+		const u8 *public_key, size_t public_key_len,
+		u8 *sess_key, size_t sess_key_len, u8 hash_id)
+{
+	struct kpp_request *req;
+	struct crypto_wait wait;
+	struct scatterlist src, dst;
+	u8 *dh_secret;
+	size_t dh_secret_len, hash_len;
+	int ret;
+
+	hash_len = nvme_auth_hmac_hash_len(hash_id);
+	if (!hash_len) {
+		pr_warn("%s: invalid hash algorithm %d\n", __func__, hash_id);
+		return -EINVAL;
+	}
+
+	if (sess_key_len != hash_len) {
+		pr_warn("%s: sess_key buffer missized (%zu != %zu)\n",
+			__func__, sess_key_len, hash_len);
+		return -EINVAL;
+	}
+
+	dh_secret_len = crypto_kpp_maxsize(dh_tfm);
+	dh_secret = kzalloc(dh_secret_len, GFP_KERNEL);
+	if (!dh_secret)
+		return -ENOMEM;
 
+	req = kpp_request_alloc(dh_tfm, GFP_KERNEL);
+	if (!req) {
+		ret = -ENOMEM;
+		goto out_free_secret;
+	}
+
+	crypto_init_wait(&wait);
+	sg_init_one(&src, public_key, public_key_len);
+	kpp_request_set_input(req, &src, public_key_len);
+	sg_init_one(&dst, dh_secret, dh_secret_len);
+	kpp_request_set_output(req, &dst, dh_secret_len);
+	kpp_request_set_callback(req, CRYPTO_TFM_REQ_MAY_BACKLOG,
+				 crypto_req_done, &wait);
+
+	ret = crypto_wait_req(crypto_kpp_compute_shared_secret(req), &wait);
+	kpp_request_free(req);
+
+	if (ret)
+		goto out_free_secret;
+
+	ret = nvme_auth_hash_skey(hash_id, dh_secret, dh_secret_len, sess_key);
+
+out_free_secret:
+	kfree_sensitive(dh_secret);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(nvme_auth_gen_session_key);
+#endif
