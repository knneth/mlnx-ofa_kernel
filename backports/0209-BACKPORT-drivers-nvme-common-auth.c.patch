 struct nvme_dhchap_key *nvme_auth_extract_key(unsigned char *secret,
 					      u8 key_hash)
 {
 	struct nvme_dhchap_key *key;
 	unsigned char *p;
+#endif
 	u32 crc;
 	int ret, key_len;
 	size_t allocated_len = strlen(secret);
@@ -178,7 +284,13 @@ struct nvme_dhchap_key *nvme_auth_extract_key(unsigned char *secret,
