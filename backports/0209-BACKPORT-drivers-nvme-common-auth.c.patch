  * nvme_auth_derive_tls_psk - Derive TLS PSK
@@ -763,8 +1004,15 @@ static int hkdf_expand_label(struct crypto_shash *hmac_tfm,
  * Returns 0 on success with a valid psk pointer in @ret_psk or a negative
