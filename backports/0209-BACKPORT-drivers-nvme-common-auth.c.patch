+#else
 int nvme_auth_generate_psk(u8 hmac_id, u8 *skey, size_t skey_len,
 		u8 *c1, u8 *c2, size_t hash_len, u8 **ret_psk, size_t *ret_len)
+#endif
 {
 	struct crypto_shash *tfm;
 	SHASH_DESC_ON_STACK(shash, tfm);
@@ -584,12 +806,23 @@ EXPORT_SYMBOL_GPL(nvme_auth_generate_psk);
  * Returns 0 on success with a valid digest pointer in @ret_digest, or a
  * negative error number on failure.
  */
+#ifdef HAVE_NVME_AUTH_GENERATE_DIGEST_GET_CHAR
+/* Newer kernels (7.1+): psk/subsysnqn/hostnqn now const, ret_digest is char** */
+int nvme_auth_generate_digest(u8 hmac_id, const u8 *psk, size_t psk_len,
+		const char *subsysnqn, const char *hostnqn, char **ret_digest)
+{
+	struct crypto_shash *tfm;
+	SHASH_DESC_ON_STACK(shash, tfm);
+	u8 *digest;
+	char *enc;
+#else
 int nvme_auth_generate_digest(u8 hmac_id, u8 *psk, size_t psk_len,
 		char *subsysnqn, char *hostnqn, u8 **ret_digest)
 {
 	struct crypto_shash *tfm;
 	SHASH_DESC_ON_STACK(shash, tfm);
 	u8 *digest, *enc;
+#endif
 	const char *hmac_name;
 	size_t digest_len, hmac_len;
 	int ret;
@@ -663,7 +896,13 @@ int nvme_auth_generate_digest(u8 hmac_id, u8 *psk, size_t psk_len,
 	if (ret)
 		goto out_free_digest;
 
+#ifdef HAVE_BASE64_ENCODE_5_PARAMS
+/* Newer kernels (6.19-rc6+): padding and variant parameters */
+	ret = base64_encode(digest, digest_len, enc, true, BASE64_STD);
+#else
+/* Older kernels: 3 parameters */
 	ret = base64_encode(digest, digest_len, enc);
+#endif
 	if (ret < hmac_len) {
 		ret = -ENOKEY;
 		goto out_free_digest;
@@ -698,6 +937,7 @@ EXPORT_SYMBOL_GPL(nvme_auth_generate_digest);
  * Returns 0 on success with output keying material stored in @okm,
  * or a negative errno value otherwise.
  */
+#ifdef HAVE_NVME_AUTH_DERIVE_TLS_PSK
 static int hkdf_expand_label(struct crypto_shash *hmac_tfm,
 		const u8 *label, unsigned int labellen,
 		const u8 *context, unsigned int contextlen,
@@ -735,6 +975,7 @@ static int hkdf_expand_label(struct crypto_shash *hmac_tfm,
 	kfree_sensitive(info);
 	return err;
 }
+#endif
 
