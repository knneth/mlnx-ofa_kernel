 u32 nvme_auth_get_seqnum(void)
 {
 	u32 seqnum;
@@ -178,7 +262,13 @@ struct nvme_dhchap_key *nvme_auth_extrac
 	if (!key)
 		return ERR_PTR(-ENOMEM);
 
+#ifdef HAVE_BASE64_ENCODE_5_PARAMS
+/* Newer kernels (6.19-rc6+): padding and variant parameters */
+	key_len = base64_decode(secret, allocated_len, key->key, true, BASE64_STD);
+#else
+/* Older kernels: 3 parameters */
 	key_len = base64_decode(secret, allocated_len, key->key);
+#endif
 	if (key_len < 0) {
 		pr_debug("base64 key decoding error %d\n",
 			 key_len);
@@ -663,7 +753,13 @@ int nvme_auth_generate_digest(u8 hmac_id
 	if (ret)
 		goto out_free_digest;
 
+#ifdef HAVE_BASE64_ENCODE_5_PARAMS
+/* Newer kernels (6.19-rc6+): padding and variant parameters */
+	ret = base64_encode(digest, digest_len, enc, true, BASE64_STD);
+#else
+/* Older kernels: 3 parameters */
 	ret = base64_encode(digest, digest_len, enc);
+#endif
 	if (ret < hmac_len) {
 		ret = -ENOKEY;
 		goto out_free_digest;
@@ -698,6 +794,7 @@ EXPORT_SYMBOL_GPL(nvme_auth_generate_dig
  * Returns 0 on success with output keying material stored in @okm,
  * or a negative errno value otherwise.
  */
