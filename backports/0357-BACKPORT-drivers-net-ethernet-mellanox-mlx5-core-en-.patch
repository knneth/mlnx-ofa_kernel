From: Valentine Fatiev <valentinef@nvidia.com>
Subject: [PATCH] BACKPORT: drivers/net/ethernet/mellanox/mlx5/core/en/params.c

---
 .../ethernet/mellanox/mlx5/core/en/params.c   | 132 +++++++++++++++---
 1 file changed, 114 insertions(+), 18 deletions(-)

diff --git a/drivers/net/ethernet/mellanox/mlx5/core/en/params.c b/drivers/net/ethernet/mellanox/mlx5/core/en/params.c
index xxxxxxx..xxxxxxx 100644
--- a/drivers/net/ethernet/mellanox/mlx5/core/en/params.c
+++ b/drivers/net/ethernet/mellanox/mlx5/core/en/params.c
@@ -8,9 +8,24 @@
 #include "en_accel/ipsec.h"
 #include "en_accel/psp.h"
 #include <linux/dim.h>
+#ifdef HAVE_NET_PAGE_POOL_OLD_H
+#include <net/page_pool.h>
+#endif
+#ifdef HAVE_NET_PAGE_POOL_TYPES_H
 #include <net/page_pool/types.h>
+#include <net/page_pool/helpers.h>
+#endif
+#include "en_accel/ktls.h"
+#ifdef HAVE_XDP_SOCK_DRV_H
 #include <net/xdp_sock_drv.h>
+#endif
+
+#ifndef HAVE_XDP_SOCK_DRV_H
+#define XDP_UMEM_MIN_CHUNK_SHIFT 11
+#endif
+#ifdef HAVE_NET_NETDEV_QUEUES_H
 #include <net/netdev_queues.h>
+#endif
 
 #define MLX5_MPWRQ_MAX_LOG_WQE_SZ 18
 #define MLX5_REP_MPWRQ_MAX_LOG_WQE_SZ 17
@@ -25,21 +40,36 @@ static u8 mlx5e_mpwrq_min_page_shift(struct mlx5_core_dev *mdev)
 u8 mlx5e_mpwrq_page_shift(struct mlx5_core_dev *mdev,
 			  struct mlx5e_rq_opt_param *rqo)
 {
+#ifdef HAVE_NETDEV_QUEUE_CONFIG
 	struct netdev_queue_config *qcfg = rqo ? rqo->qcfg : NULL;
+#endif
+#ifdef HAVE_XDP_SUPPORT
 	struct mlx5e_xsk_param *xsk = mlx5e_rqo_xsk_param(rqo);
+#endif
 	u8 min_page_shift = mlx5e_mpwrq_min_page_shift(mdev);
 	u8 req_page_shift;
 
+#ifdef HAVE_XDP_SUPPORT
 	if (xsk)
 		req_page_shift = order_base_2(xsk->chunk_size);
-	else if (qcfg && qcfg->rx_page_size)
+	else
+#endif
+#ifdef HAVE_NETDEV_QUEUE_CONFIG
+	if (qcfg && qcfg->rx_page_size)
 		req_page_shift = order_base_2(qcfg->rx_page_size);
 	else
+#endif
 		req_page_shift = PAGE_SHIFT;
 
 	/* Regular RQ uses order-0 pages, the NIC must be able to map them. */
+#ifdef HAVE_XDP_SUPPORT
 	if (WARN_ON_ONCE(!xsk && req_page_shift < min_page_shift))
 		min_page_shift = req_page_shift;
+#else
+	/* --without-xdp: no XSK ever; treat as the !xsk branch */
+	if (WARN_ON_ONCE(req_page_shift < min_page_shift))
+		min_page_shift = req_page_shift;
+#endif
 
 	return max(req_page_shift, min_page_shift);
 }
@@ -240,16 +270,27 @@ u8 mlx5e_mpwrq_max_log_rq_pkts(struct mlx5_core_dev *mdev, u8 page_shift,
 u16 mlx5e_get_linear_rq_headroom(struct mlx5e_params *params,
 				 struct mlx5e_rq_opt_param *rqo)
 {
-	u16 headroom;
+	u16 headroom = 0;
 
+#ifdef HAVE_XSK_BUFF_ALLOC
 	if (mlx5e_rqo_xsk_param(rqo))
 		return rqo->xsk->headroom;
+#endif
 
 	headroom = NET_IP_ALIGN;
-	if (params->xdp_prog)
+#ifdef HAVE_XDP_SUPPORT
+	if (params->xdp_prog) {
 		headroom += XDP_PACKET_HEADROOM;
-	else
+#ifndef HAVE_XSK_BUFF_ALLOC
+		if (rqo && rqo->xsk)
+			headroom += rqo->xsk->headroom;
+#endif
+	} else {
+#endif /* HAVE_XDP_SUPPORT */
 		headroom += MLX5_RX_HEADROOM;
+#ifdef HAVE_XDP_SUPPORT
+	}
+#endif
 
 	return headroom;
 }
@@ -291,16 +332,27 @@ static u32 mlx5e_rx_get_linear_stride_sz(struct mlx5_core_dev *mdev,
 			BIT(mlx5e_mpwrq_page_shift(mdev, rqo)) : PAGE_SIZE;
 	}
 
+#ifdef HAVE_XDP_SUPPORT
 	no_head_tail_room = params->xdp_prog && mpwqe &&
 			    !mlx5e_rx_is_linear_skb(mdev, params, rqo);
+#else
+	no_head_tail_room = false;
+#endif
 
 	/* When no_head_tail_room is set, headroom and tailroom are excluded from skb calculations.
 	 * no_head_tail_room should be set in the case of XDP with Striding RQ
 	 * when SKB is not linear. This is because another page is allocated for the linear part.
 	 */
-	sz = mlx5e_rx_get_linear_sz_skb(params, no_head_tail_room);
+	sz = roundup_pow_of_two(mlx5e_rx_get_linear_sz_skb(params, no_head_tail_room));
 
-	return roundup_pow_of_two(sz);
+	/* Multi-packet per page is not supported on old kernels without
+	 * page pool fragment support (Issue: 5160746).
+	 */
+#if defined(HAVE_XDP_SUPPORT) && defined(HAVE_NO_PAGE_POOL_DEFRAG_PAGE_AND_UNREF_NETMEM)
+	return params->xdp_prog && sz < PAGE_SIZE ? PAGE_SIZE : sz;
+#else
+	return sz;
+#endif
 }
 
 static u8 mlx5e_mpwqe_log_pkts_per_wqe(struct mlx5_core_dev *mdev,
@@ -473,7 +525,11 @@ u8 mlx5e_mpwqe_get_log_num_strides(struct mlx5_core_dev *mdev,
 u8 mlx5e_mpwqe_get_min_wqe_bulk(unsigned int wq_sz)
 {
 #define UMR_WQE_BULK (2)
+#ifdef HAVE_PAGE_POOL_DEFRAG_PAGE
 	return min_t(unsigned int, UMR_WQE_BULK, wq_sz / 2 - 1);
+#else
+	return UMR_WQE_BULK;
+#endif
 }
 
 u16 mlx5e_get_rq_headroom(struct mlx5_core_dev *mdev,
@@ -565,6 +621,7 @@ int mlx5e_mpwrq_validate_regular(struct mlx5_core_dev *mdev, struct mlx5e_params
 	return 0;
 }
 
+#ifdef HAVE_XSK_ZERO_COPY_SUPPORT
 int mlx5e_mpwrq_validate_xsk(struct mlx5_core_dev *mdev, struct mlx5e_params *params,
 			     struct mlx5e_rq_opt_param *rqo)
 {
@@ -598,6 +655,7 @@ int mlx5e_mpwrq_validate_xsk(struct mlx5_core_dev *mdev, struct mlx5e_params *pa
 
 	return 0;
 }
+#endif
 
 void mlx5e_init_rq_type_params(struct mlx5_core_dev *mdev,
 			       struct mlx5e_params *params)
@@ -605,6 +663,9 @@ void mlx5e_init_rq_type_params(struct mlx5_core_dev *mdev,
 	params->log_rq_mtu_frames = is_kdump_kernel() ?
 		MLX5E_PARAMS_MINIMUM_LOG_RQ_SIZE :
 		MLX5E_PARAMS_DEFAULT_LOG_RQ_SIZE;
+#ifndef HAVE_DEVLINK_PER_AUXDEV
+	mlx5e_params_print_info(mdev, params);
+#endif
 }
 
 void mlx5e_set_rq_type(struct mlx5_core_dev *mdev, struct mlx5e_params *params)
@@ -658,6 +719,7 @@ static int mlx5e_max_nonlinear_mtu(int first_frag_size, int frag_size, bool xdp)
 	return first_frag_size + (MLX5E_MAX_RX_FRAGS - 2) * frag_size + PAGE_SIZE;
 }
 
+#if defined(HAVE_PAGE_POOL_DEFRAG_PAGE) || defined(HAVE_PAGE_POOL_PUT_UNREFED_PAGE)
 static void mlx5e_rx_compute_wqe_bulk_params(struct mlx5e_params *params,
 					     struct mlx5e_rq_frags_info *info)
 {
@@ -686,8 +748,13 @@ static void mlx5e_rx_compute_wqe_bulk_params(struct mlx5e_params *params,
 	 * keep bulk size smaller to avoid filling the page_pool cache on
 	 * every bulk refill.
 	 */
-	wqe_bulk_in_bytes = min_t(u32, MAX_WQE_BULK_BYTES(params->xdp_prog),
-				  bulk_bound_rq_size_in_bytes);
+
+#ifdef HAVE_XDP_SUPPORT
+	wqe_bulk_in_bytes = min_t(u32, MAX_WQE_BULK_BYTES(params->xdp_prog)
+			,bulk_bound_rq_size_in_bytes);
+#else
+	wqe_bulk_in_bytes = bulk_bound_rq_size_in_bytes;
+#endif
 	wqe_bulk = DIV_ROUND_UP(wqe_bulk_in_bytes, sum_frag_strides);
 
 	/* Make sure that allocations don't start when the page is still used
@@ -695,10 +762,16 @@ static void mlx5e_rx_compute_wqe_bulk_params(struct mlx5e_params *params,
 	 */
 	info->wqe_bulk = max_t(u16, info->wqe_index_mask + 1, wqe_bulk);
 
-	split_factor = DIV_ROUND_UP(MAX_WQE_BULK_BYTES(params->xdp_prog),
-				    PP_ALLOC_CACHE_REFILL * PAGE_SIZE);
+	split_factor = DIV_ROUND_UP(
+#ifdef HAVE_XDP_SUPPORT
+				MAX_WQE_BULK_BYTES(params->xdp_prog)
+#else
+				(512*1024)
+#endif
+				,PP_ALLOC_CACHE_REFILL * PAGE_SIZE);
 	info->refill_unit = DIV_ROUND_UP(info->wqe_bulk, split_factor);
 }
+#endif /*HAVE_PAGE_POOL_DEFRAG_PAGE*/
 
 #define DEFAULT_FRAG_SIZE (2048)
 
@@ -711,6 +784,11 @@ static int mlx5e_build_rq_frags_info(struct mlx5_core_dev *mdev,
 	u32 byte_count = MLX5E_SW2HW_MTU(params, params->sw_mtu);
 	int frag_size_max = DEFAULT_FRAG_SIZE;
 	int first_frag_size_max;
+#ifdef HAVE_XDP_SUPPORT
+	bool xdp_prog = params->xdp_prog;
+#else
+	bool xdp_prog = false;
+#endif
 	u32 buf_size = 0;
 	u16 headroom;
 	int max_mtu;
@@ -740,13 +818,13 @@ static int mlx5e_build_rq_frags_info(struct mlx5_core_dev *mdev,
 	first_frag_size_max = SKB_WITH_OVERHEAD(frag_size_max - headroom);
 
 	max_mtu = mlx5e_max_nonlinear_mtu(first_frag_size_max, frag_size_max,
-					  params->xdp_prog);
-	if (byte_count > max_mtu || params->xdp_prog) {
+					  xdp_prog);
+	if (byte_count > max_mtu || xdp_prog) {
 		frag_size_max = PAGE_SIZE;
 		first_frag_size_max = SKB_WITH_OVERHEAD(frag_size_max - headroom);
 
 		max_mtu = mlx5e_max_nonlinear_mtu(first_frag_size_max, frag_size_max,
-						  params->xdp_prog);
+						  xdp_prog);
 		if (byte_count > max_mtu) {
 			mlx5_core_err(mdev, "MTU %u is too big for non-linear legacy RQ (max %d)\n",
 				      params->sw_mtu, max_mtu);
@@ -766,7 +844,7 @@ static int mlx5e_build_rq_frags_info(struct mlx5_core_dev *mdev,
 		info->arr[i].frag_size = frag_size;
 		buf_size += frag_size;
 
-		if (params->xdp_prog) {
+		if (xdp_prog) {
 			/* XDP multi buffer expects fragments of the same size. */
 			info->arr[i].frag_stride = frag_size_max;
 		} else {
@@ -809,6 +887,7 @@ static int mlx5e_build_rq_frags_info(struct mlx5_core_dev *mdev,
 	}
 
 out:
+#if defined(HAVE_PAGE_POOL_DEFRAG_PAGE) || defined(HAVE_PAGE_POOL_PUT_UNREFED_PAGE)
 	/* Bulking optimization to skip allocation until a large enough number
 	 * of WQEs can be allocated in a row. Bulking also influences how well
 	 * deferred page release works.
@@ -817,10 +896,20 @@ out:
 
 	mlx5_core_dbg(mdev, "%s: wqe_bulk = %u, wqe_bulk_refill_unit = %u\n",
 		      __func__, info->wqe_bulk, info->refill_unit);
+#else
+	/* Bulking optimization to skip allocation until at least 8 WQEs can be
+	 * allocated in a row. At the same time, never start allocation when
+	 * the page is still used by older WQEs.
+	 */
+
+	info->wqe_bulk = max_t(u8, info->wqe_index_mask + 1, 8);
+#endif
 
 	info->log_num_frags = order_base_2(info->num_frags);
 
+#ifdef HAVE_XDP_SUPPORT
 	*xdp_frag_size = info->num_frags > 1 && params->xdp_prog ? PAGE_SIZE : 0;
+#endif
 
 	return 0;
 }
@@ -910,10 +999,9 @@ static void mlx5e_build_rx_cq_param(struct mlx5_core_dev *mdev,
 
 static u8 rq_end_pad_mode(struct mlx5_core_dev *mdev, struct mlx5e_params *params)
 {
-	bool lro_en = params->packet_merge.type == MLX5E_PACKET_MERGE_LRO;
 	bool ro = MLX5_CAP_GEN(mdev, relaxed_ordering_write);
 
-	return ro && lro_en ?
+	return ro && (params->packet_merge.type == MLX5E_PACKET_MERGE_LRO) ?
 		MLX5_WQ_END_PAD_MODE_NONE : MLX5_WQ_END_PAD_MODE_ALIGN;
 }
 
@@ -1157,6 +1245,7 @@ static u32 mlx5e_mpwrq_total_umr_wqebbs(struct mlx5_core_dev *mdev,
 	       (1 << mlx5e_mpwqe_get_log_rq_size(mdev, params, rqo));
 }
 
+#ifdef HAVE_XDP_SUPPORT
 static u32 mlx5e_max_xsk_wqebbs(struct mlx5_core_dev *mdev,
 				struct mlx5e_params *params)
 {
@@ -1212,6 +1301,7 @@ static u32 mlx5e_max_xsk_wqebbs(struct mlx5_core_dev *mdev,
 
 	return max_xsk_wqebbs;
 }
+#endif
 
 static u8 mlx5e_build_icosq_log_wq_sz(struct mlx5_core_dev *mdev,
 				      struct mlx5e_params *params,
@@ -1226,8 +1316,9 @@ static u8 mlx5e_build_icosq_log_wq_sz(struct mlx5_core_dev *mdev,
 	/* UMR WQEs for the regular RQ. */
 	wqebbs = mlx5e_mpwrq_total_umr_wqebbs(mdev, params, NULL);
 
+#ifdef HAVE_XDP_SUPPORT
 	wqebbs += mlx5e_max_xsk_wqebbs(mdev, params);
-
+#endif
 	/* UMR WQEs don't cross the page boundary, they are padded with NOPs.
 	 * This padding is always smaller than the max WQE size. That gives us
 	 * at least (PAGE_SIZE - (max WQE size - MLX5_SEND_WQE_BB)) useful bytes
@@ -1247,7 +1338,6 @@ static u8 mlx5e_build_async_icosq_log_wq_sz(struct mlx5_core_dev *mdev)
 {
 	if (mlx5e_is_ktls_rx(mdev))
 		return MLX5E_PARAMS_DEFAULT_LOG_SQ_SIZE;
-
 	return MLX5E_PARAMS_MINIMUM_LOG_SQ_SIZE;
 }
 
@@ -1282,6 +1372,7 @@ static void mlx5e_build_async_icosq_param(struct mlx5_core_dev *mdev,
 	mlx5e_build_ico_cq_param(mdev, log_wq_size, &param->cqp);
 }
 
+#ifdef HAVE_XDP_SUPPORT
 void mlx5e_build_xdpsq_param(struct mlx5_core_dev *mdev,
 			     struct mlx5e_params *params,
 			     struct mlx5e_sq_param *param)
@@ -1294,6 +1385,7 @@ void mlx5e_build_xdpsq_param(struct mlx5_core_dev *mdev,
 	param->is_mpw = MLX5E_GET_PFLAG(params, MLX5E_PFLAG_XDP_TX_MPWQE);
 	mlx5e_build_tx_cq_param(mdev, params, &param->cqp);
 }
+#endif
 
 int mlx5e_build_channel_param(struct mlx5_core_dev *mdev,
 			      struct mlx5e_params *params,
@@ -1313,7 +1405,9 @@ int mlx5e_build_channel_param(struct mlx5_core_dev *mdev,
 	async_icosq_log_wq_sz = mlx5e_build_async_icosq_log_wq_sz(mdev);
 
 	mlx5e_build_sq_param(mdev, params, &cparam->txq_sq);
+#ifdef HAVE_XDP_SUPPORT
 	mlx5e_build_xdpsq_param(mdev, params, &cparam->xdp_sq);
+#endif
 	mlx5e_build_icosq_param(mdev, icosq_log_wq_sz, &cparam->icosq);
 	mlx5e_build_async_icosq_param(mdev, async_icosq_log_wq_sz, &cparam->async_icosq);
 
@@ -1327,5 +1421,7 @@ void mlx5e_build_xsk_channel_param(struct mlx5_core_dev *mdev,
 {
 	cparam->rq_opt.xsk = xsk;
 	mlx5e_build_rq_param(mdev, params, &cparam->rq_opt, &cparam->rq);
+#ifdef HAVE_XDP_SUPPORT
 	mlx5e_build_xdpsq_param(mdev, params, &cparam->xdp_sq);
+#endif
 }
