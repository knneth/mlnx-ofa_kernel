From: Valentine Fatiev <valentinef@nvidia.com>
Subject: [PATCH] BACKPORT: drivers/infiniband/core/uverbs_cmd.c

---
 drivers/infiniband/core/uverbs_cmd.c | 20 +++++++++++++++++++-
 1 file changed, 19 insertions(+), 1 deletion(-)

diff --git a/drivers/infiniband/core/uverbs_cmd.c b/drivers/infiniband/core/uverbs_cmd.c
index xxxxxxx..xxxxxxx 100644
--- a/drivers/infiniband/core/uverbs_cmd.c
+++ b/drivers/infiniband/core/uverbs_cmd.c
@@ -591,7 +591,11 @@ static int ib_uverbs_open_xrcd(struct uverbs_attr_bundle *attrs)
 	struct inode                   *inode = NULL;
 	int				new_xrcd = 0;
 	struct ib_device *ib_dev;
+#ifdef HAVE_FD_FILE
 	struct fd f = EMPTY_FD;
+#else
+	struct fd f = {};
+#endif
 	int ret;
 
 	ret = uverbs_request(attrs, &cmd, sizeof(cmd));
@@ -603,12 +607,20 @@ static int ib_uverbs_open_xrcd(struct uverbs_attr_bundle *attrs)
 	if (cmd.fd != -1) {
 		/* search for file descriptor */
 		f = fdget(cmd.fd);
+#ifdef HAVE_FD_FILE
 		if (fd_empty(f)) {
+#else
+		if (!f.file) {
+#endif
 			ret = -EBADF;
 			goto err_tree_mutex_unlock;
 		}
 
+#ifdef HAVE_FD_FILE
 		inode = file_inode(fd_file(f));
+#else
+		inode = file_inode(f.file);
+#endif
 		xrcd = find_xrcd(ibudev, inode);
 		if (!xrcd && !(cmd.oflags & O_CREAT)) {
 			/* no file descriptor. Need CREATE flag */
@@ -651,6 +663,9 @@ static int ib_uverbs_open_xrcd(struct uverbs_attr_bundle *attrs)
 		atomic_inc(&xrcd->usecnt);
 	}
 
+#ifndef HAVE_FD_FILE
+	if (f.file)
+#endif
 	fdput(f);
 
 	mutex_unlock(&ibudev->xrcd_tree_mutex);
@@ -666,6 +681,9 @@ err:
 	uobj_alloc_abort(&obj->uobject, attrs);
 
 err_tree_mutex_unlock:
+#ifndef HAVE_FD_FILE
+	if (f.file)
+#endif
 	fdput(f);
 
 	mutex_unlock(&ibudev->xrcd_tree_mutex);
@@ -3394,7 +3412,7 @@ static int __uverbs_create_xsrq(struct uverbs_attr_bundle *attrs,
 	struct ib_srq                   *srq;
 	struct ib_srq_init_attr          attr;
 	int ret;
-	struct ib_uobject *xrcd_uobj;
+	struct ib_uobject               *xrcd_uobj;
 	struct ib_device *ib_dev;
 
 	obj = (struct ib_usrq_object *)uobj_alloc(UVERBS_OBJECT_SRQ, attrs,
