From: Valentine Fatiev <valentinef@nvidia.com>
Subject: [PATCH] BACKPORT: drivers/net/ethernet/mellanox/mlx5/core/en/tc_tun.c

---
 .../ethernet/mellanox/mlx5/core/en/tc_tun.c   | 45 ++++++++++++++++---
 1 file changed, 40 insertions(+), 5 deletions(-)

--- a/drivers/net/ethernet/mellanox/mlx5/core/en/tc_tun.c
+++ b/drivers/net/ethernet/mellanox/mlx5/core/en/tc_tun.c
@@ -2,7 +2,9 @@
 /* Copyright (c) 2018 Mellanox Technologies. */
 
 #include <net/flow.h>
+#ifdef HAVE_NET_INET_DSCP_H
 #include <net/inet_dscp.h>
+#endif
 #include <net/vxlan.h>
 #include <net/gre.h>
 #include <net/geneve.h>
@@ -37,6 +39,11 @@ static void mlx5e_tc_tun_route_attr_clea
 
 struct mlx5e_tc_tunnel *mlx5e_get_tc_tun(struct net_device *tunnel_dev)
 {
+#if !defined(HAVE_TC_INDR_API)
+	/* in old kernels with egdev we don't pass the netdev so the filter_dev here
+	 * is actually priv->netdev. we only assume and support vxlan */
+	return &vxlan_tunnel;
+#endif
 	if (netif_is_vxlan(tunnel_dev))
 		return &vxlan_tunnel;
 	else if (netif_is_geneve(tunnel_dev))
@@ -44,8 +51,10 @@ struct mlx5e_tc_tunnel *mlx5e_get_tc_tun
 	else if (netif_is_gretap(tunnel_dev) ||
 		 netif_is_ip6gretap(tunnel_dev))
 		return &gre_tunnel;
+#if defined(HAVE_NET_BAREUDP_H) && defined(HAVE_FLOW_DISSECTOR_MPLS_LSE)
 	else if (netif_is_bareudp(tunnel_dev))
 		return &mplsoudp_tunnel;
+#endif
 	else
 		return NULL;
 }
@@ -136,7 +145,11 @@ static int mlx5e_route_lookup_ipv4_get(s
 		goto err_rt_release;
 	}
 
-	if (mlx5_lag_is_multipath(mdev) && rt->rt_gw_family != AF_INET) {
+#ifdef HAVE_RT_GW_FAMILY
+       if (mlx5_lag_is_multipath(mdev) && rt->rt_gw_family != AF_INET) {
+#else
+	if (mlx5_lag_is_multipath(mdev) && !rt->rt_uses_gateway) {
+#endif
 		ret = -ENETUNREACH;
 		goto err_rt_release;
 	}
@@ -234,7 +247,13 @@ int mlx5e_tc_tun_create_header_ipv4(stru
 	int err;
 
 	/* add the IP fields */
+#ifdef HAVE_FLOWI4_DSCP
+/* Newer kernels (6.18+): flowi4_dscp field with dscp_t type */
 	attr.fl.fl4.flowi4_dscp = inet_dsfield_to_dscp(tun_key->tos);
+#else
+/* Older kernels: flowi4_tos field with __u8 type */
+	attr.fl.fl4.flowi4_tos = tun_key->tos & ~INET_ECN_MASK;
+#endif
 	attr.fl.fl4.daddr = tun_key->u.ipv4.dst;
 	attr.fl.fl4.saddr = tun_key->u.ipv4.src;
 	attr.ttl = tun_key->ttl;
@@ -350,7 +369,13 @@ int mlx5e_tc_tun_update_header_ipv4(stru
 	int err;
 
 	/* add the IP fields */
+#ifdef HAVE_FLOWI4_DSCP
+/* Newer kernels (6.18+): flowi4_dscp field with dscp_t type */
 	attr.fl.fl4.flowi4_dscp = inet_dsfield_to_dscp(tun_key->tos);
+#else
+/* Older kernels: flowi4_tos field with __u8 type */
+	attr.fl.fl4.flowi4_tos = tun_key->tos & ~INET_ECN_MASK;
+#endif
 	attr.fl.fl4.daddr = tun_key->u.ipv4.dst;
 	attr.fl.fl4.saddr = tun_key->u.ipv4.src;
 	attr.ttl = tun_key->ttl;
@@ -439,16 +464,16 @@ release_neigh:
 	return err;
 }
 
-#if IS_ENABLED(CONFIG_INET) && IS_ENABLED(CONFIG_IPV6)
 static int mlx5e_route_lookup_ipv6_get(struct mlx5e_priv *priv,
 				       struct net_device *dev,
 				       struct mlx5e_tc_tun_route_attr *attr)
 {
 	struct mlx5e_tc_tunnel *tunnel = mlx5e_get_tc_tun(dev);
 	struct net_device *route_dev;
+	struct dst_entry *dst = NULL;
 	struct net_device *out_dev;
-	struct dst_entry *dst;
 	struct neighbour *n;
+#if IS_ENABLED(CONFIG_INET) && IS_ENABLED(CONFIG_IPV6)
 	int ret;
 
 	if (tunnel && tunnel->get_remote_ifindex)
@@ -457,6 +482,10 @@ static int mlx5e_route_lookup_ipv6_get(s
 					      NULL);
 	if (IS_ERR(dst))
 		return PTR_ERR(dst);
+#ifdef HAVE_BASECODE_EXTRAS
+	if (!dst)
+		return -EOPNOTSUPP;
+#endif
 
 	if (!attr->ttl)
 		attr->ttl = ip6_dst_hoplimit(dst);
@@ -464,6 +493,9 @@ static int mlx5e_route_lookup_ipv6_get(s
 	ret = get_route_and_out_devs(priv, dst->dev, &route_dev, &out_dev);
 	if (ret < 0)
 		goto err_dst_release;
+#else
+	return -EOPNOTSUPP;
+#endif
 
 	dev_hold(route_dev);
 	n = dst_neigh_lookup(dst, &attr->fl.fl6.daddr);
@@ -707,7 +739,6 @@ release_neigh:
 	mlx5e_route_lookup_ipv6_put(&attr);
 	return err;
 }
-#endif
 
 int mlx5e_tc_tun_route_lookup(struct mlx5e_priv *priv,
 			      struct mlx5_flow_spec *spec,
@@ -809,7 +840,7 @@ int mlx5e_tc_tun_parse(struct net_device
 				       outer_headers);
 	struct netlink_ext_ack *extack = f->common.extack;
 	int err = 0;
-
+	
 	if (!tunnel) {
 		netdev_warn(priv->netdev,
 			    "decapsulation offload is not supported for %s net device\n",
@@ -823,6 +854,7 @@ int mlx5e_tc_tun_parse(struct net_device
 	if (tunnel->parse_udp_ports) {
 		err = tunnel->parse_udp_ports(priv, spec, f,
 					      headers_c, headers_v);
+
 		if (err)
 			goto out;
 	}
@@ -830,6 +862,7 @@ int mlx5e_tc_tun_parse(struct net_device
 	if (tunnel->parse_tunnel) {
 		err = tunnel->parse_tunnel(priv, spec, f,
 					   headers_c, headers_v);
+
 		if (err)
 			goto out;
 	}
@@ -943,6 +976,7 @@ int mlx5e_tc_tun_parse_udp_ports(struct
 				 struct flow_cls_offload *f,
 				 void *headers_c,
 				 void *headers_v)
+
 {
 	struct flow_rule *rule = flow_cls_offload_flow_rule(f);
 	struct netlink_ext_ack *extack = f->common.extack;
@@ -991,3 +1025,4 @@ int mlx5e_tc_tun_parse_udp_ports(struct
 
 	return 0;
 }
+
