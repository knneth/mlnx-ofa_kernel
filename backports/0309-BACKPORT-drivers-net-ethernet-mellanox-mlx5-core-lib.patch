 {
 	struct mlx5_core_dev *dev = devlink_priv(devlink);
 	u32 mnvda[MLX5_ST_SZ_DW(mnvda_reg)];
+#ifndef HAVE_DEVLINK_PARAM_SET_FUNCTION_POINTER_HAS_EXTACK
+	/* Older kernels: extack not passed by core; use NULL for internal helpers */
+	struct netlink_ext_ack *extack = NULL;
+#endif
 	void *data;
 	int err;
 
@@ -727,7 +841,11 @@ static int mlx5_devlink_total_vfs_set(struct devlink *devlink, u32 id,
 }
 
 static int mlx5_devlink_total_vfs_validate(struct devlink *devlink, u32 id,
+#ifdef HAVE_DEVLINK_PARAM_VALIDATE_FUNCTION_POINTER_VALUE_IS_PTR
+					   union devlink_param_value *val,
+#else
 					   union devlink_param_value val,
+#endif
 					   struct netlink_ext_ack *extack)
 {
 	struct mlx5_core_dev *dev = devlink_priv(devlink);
@@ -746,29 +864,43 @@ static int mlx5_devlink_total_vfs_validate(struct devlink *devlink, u32 id,
 		return 0; /* optimistic, but set might fail later */
 
 	max = MLX5_GET(nv_global_pci_cap, data, max_vfs_per_pf);
+#ifdef HAVE_DEVLINK_PARAM_VALIDATE_FUNCTION_POINTER_VALUE_IS_PTR
+	if (val->vu16 > max) {
+#else
 	if (val.vu16 > max) {
+#endif
+#ifdef HAVE_NL_SET_ERR_MSG_FMT_MOD
 		NL_SET_ERR_MSG_FMT_MOD(extack,
 				       "Max allowed by device is %u", max);
+#else
+		NL_SET_ERR_MSG_MOD(extack,
+				   "You reached Max allowed by device");
+#endif
 		return -EINVAL;
 	}
 
 	return 0;
 }
+#endif /* HAVE_DEVLINK_PARAM_GENERIC_ID_TOTAL_VFS */
 
 static const struct devlink_param mlx5_nv_param_devlink_params[] = {
 	DEVLINK_PARAM_GENERIC(ENABLE_SRIOV, BIT(DEVLINK_PARAM_CMODE_PERMANENT),
 			      mlx5_devlink_enable_sriov_get,
 			      mlx5_devlink_enable_sriov_set, NULL),
+#ifdef HAVE_DEVLINK_PARAM_GENERIC_ID_TOTAL_VFS
 	DEVLINK_PARAM_GENERIC(TOTAL_VFS, BIT(DEVLINK_PARAM_CMODE_PERMANENT),
 			      mlx5_devlink_total_vfs_get,
 			      mlx5_devlink_total_vfs_set,
 			      mlx5_devlink_total_vfs_validate),
+#endif
 	DEVLINK_PARAM_DRIVER(MLX5_DEVLINK_PARAM_ID_CQE_COMPRESSION_TYPE,
 			     "cqe_compress_type", DEVLINK_PARAM_TYPE_STRING,
 			     BIT(DEVLINK_PARAM_CMODE_PERMANENT),
 			     mlx5_nv_param_devlink_cqe_compress_get,
 			     mlx5_nv_param_devlink_cqe_compress_set,
 			     mlx5_nv_param_devlink_cqe_compress_validate),
+#ifdef HAVE_DEVLINK_PARAM_DRIVER_WITH_DEFAULTS
+/* Newer kernels (6.19+): get_default/reset_default callbacks supported */
 	DEVLINK_PARAM_DRIVER_WITH_DEFAULTS(MLX5_DEVLINK_PARAM_ID_SWP_L4_CSUM_MODE,
 					   "swp_l4_csum_mode", DEVLINK_PARAM_TYPE_STRING,
 					   BIT(DEVLINK_PARAM_CMODE_PERMANENT),
@@ -777,6 +909,14 @@ static const struct devlink_param mlx5_nv_param_devlink_params[] = {
 					   mlx5_devlink_swp_l4_csum_mode_validate,
 					   mlx5_devlink_swp_l4_csum_mode_get_default,
 					   mlx5_devlink_swp_l4_csum_mode_set_default),
+#else
+	DEVLINK_PARAM_DRIVER(MLX5_DEVLINK_PARAM_ID_SWP_L4_CSUM_MODE,
+			     "swp_l4_csum_mode", DEVLINK_PARAM_TYPE_STRING,
+			     BIT(DEVLINK_PARAM_CMODE_PERMANENT),
+			     mlx5_devlink_swp_l4_csum_mode_get,
+			     mlx5_devlink_swp_l4_csum_mode_set,
+			     mlx5_devlink_swp_l4_csum_mode_validate),
+#endif
 };
 
 int mlx5_nv_param_register_dl_params(struct devlink *devlink)
@@ -786,7 +926,11 @@ int mlx5_nv_param_register_dl_params(struct devlink *devlink)
 	if (!mlx5_core_is_pf(dev) || !MLX5_CAP_MCAM_REG(dev, mnvda))
 		return 0;
 
+#ifdef HAVE_DEVL_PARAM_DRIVERINIT_VALUE_GET
 	return devl_params_register(devlink, mlx5_nv_param_devlink_params,
+#else
+	return devlink_params_register(devlink, mlx5_nv_param_devlink_params,
+#endif
 				    ARRAY_SIZE(mlx5_nv_param_devlink_params));
 }
 
@@ -797,7 +941,11 @@ void mlx5_nv_param_unregister_dl_params(struct devlink *devlink)
 	if (!mlx5_core_is_pf(dev) || !MLX5_CAP_MCAM_REG(dev, mnvda))
 		return;
 
+#ifdef HAVE_DEVL_PARAM_DRIVERINIT_VALUE_GET
 	devl_params_unregister(devlink, mlx5_nv_param_devlink_params,
+#else
+	devlink_params_unregister(devlink, mlx5_nv_param_devlink_params,
+#endif
 			       ARRAY_SIZE(mlx5_nv_param_devlink_params));
 }
 
