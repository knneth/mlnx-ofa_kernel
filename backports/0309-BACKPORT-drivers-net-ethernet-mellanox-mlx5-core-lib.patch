From: Valentine Fatiev <valentinef@nvidia.com>
Subject: [PATCH] BACKPORT:
 drivers/net/ethernet/mellanox/mlx5/core/lib/nv_param.c

---

diff --git a/drivers/net/ethernet/mellanox/mlx5/core/lib/nv_param.c b/drivers/net/ethernet/mellanox/mlx5/core/lib/nv_param.c
index xxxxxxx..xxxxxxx 100644
--- a/drivers/net/ethernet/mellanox/mlx5/core/lib/nv_param.c
+++ b/drivers/net/ethernet/mellanox/mlx5/core/lib/nv_param.c
@@ -245,8 +245,12 @@ static const char *const
 
 static int
 mlx5_nv_param_devlink_cqe_compress_get(struct devlink *devlink, u32 id,
+#ifdef HAVE_DEVLINK_PARAM_GET_FUNCTION_POINTER_HAS_EXTACK
 				       struct devlink_param_gset_ctx *ctx,
 				       struct netlink_ext_ack *extack)
+#else
+				       struct devlink_param_gset_ctx *ctx)
+#endif
 {
 	struct mlx5_core_dev *dev = devlink_priv(devlink);
 	u32 mnvda[MLX5_ST_SZ_DW(mnvda_reg)] = {};
@@ -270,13 +274,21 @@ mlx5_nv_param_devlink_cqe_compress_get(struct devlink *devlink, u32 id,
 
 static int
 mlx5_nv_param_devlink_cqe_compress_validate(struct devlink *devlink, u32 id,
+#ifdef HAVE_DEVLINK_PARAM_VALIDATE_FUNCTION_POINTER_VALUE_IS_PTR
+					    union devlink_param_value *val,
+#else
 					    union devlink_param_value val,
+#endif
 					    struct netlink_ext_ack *extack)
 {
 	int i;
 
 	for (i = 0; i < ARRAY_SIZE(cqe_compress_str); i++) {
+#ifdef HAVE_DEVLINK_PARAM_VALIDATE_FUNCTION_POINTER_VALUE_IS_PTR
+		if (!strcmp(val->vstr, cqe_compress_str[i]))
+#else
 		if (!strcmp(val.vstr, cqe_compress_str[i]))
+#endif
 			return 0;
 	}
 
@@ -287,8 +299,12 @@ mlx5_nv_param_devlink_cqe_compress_validate(struct devlink *devlink, u32 id,
 
 static int
 mlx5_nv_param_devlink_cqe_compress_set(struct devlink *devlink, u32 id,
-				       struct devlink_param_gset_ctx *ctx,
-				       struct netlink_ext_ack *extack)
+				       struct devlink_param_gset_ctx *ctx
+#ifdef HAVE_DEVLINK_PARAM_SET_FUNCTION_POINTER_HAS_EXTACK
+/* Newer kernels (6.10+): extack parameter added for better error reporting */
+				       , struct netlink_ext_ack *extack
+#endif
+				       )
 {
 	struct mlx5_core_dev *dev = devlink_priv(devlink);
 	u32 mnvda[MLX5_ST_SZ_DW(mnvda_reg)] = {};
@@ -303,7 +319,13 @@ mlx5_nv_param_devlink_cqe_compress_set(struct devlink *devlink, u32 id,
 
 	err = mlx5_nv_param_read_sw_offload_conf(dev, mnvda, sizeof(mnvda));
 	if (err) {
-		NL_SET_ERR_MSG_MOD(extack,
+		NL_SET_ERR_MSG_MOD(
+#ifdef HAVE_DEVLINK_PARAM_SET_FUNCTION_POINTER_HAS_EXTACK
+/* Newer kernels (6.10+): extack parameter added for better error reporting */
+				extack,
+#else
+				NULL,
+#endif
 				   "Failed to read sw_offload_conf mnvda reg");
 		return err;
 	}
@@ -345,9 +367,15 @@ mlx5_swp_l4_csum_mode_get(struct devlink *devlink, u32 id,
 	*value = MLX5_GET(nv_sw_accelerate_conf, data, swp_l4_csum_mode);
 
 	if (*value >= ARRAY_SIZE(swp_l4_csum_mode_str)) {
+#ifdef HAVE_NL_SET_ERR_MSG_FMT_MOD
 		NL_SET_ERR_MSG_FMT_MOD(extack,
 				       "Invalid swp_l4_csum_mode value %u read from device",
 				       *value);
+#else
+		NL_SET_ERR_MSG_MOD(extack,
+				   "Invalid swp_l4_csum_mode value read from device");
+#endif
+
 		return -EINVAL;
 	}
 
@@ -356,14 +384,24 @@ mlx5_swp_l4_csum_mode_get(struct devlink *devlink, u32 id,
 
 static int
 mlx5_devlink_swp_l4_csum_mode_get(struct devlink *devlink, u32 id,
+#ifdef HAVE_DEVLINK_PARAM_GET_FUNCTION_POINTER_HAS_EXTACK
+/* Newer kernels (6.19+): extack parameter added for error reporting */
 				  struct devlink_param_gset_ctx *ctx,
 				  struct netlink_ext_ack *extack)
+#else
+				  struct devlink_param_gset_ctx *ctx)
+#endif
 {
 	u8 value;
 	int err;
 
 	err = mlx5_swp_l4_csum_mode_get(devlink, id, MLX5_ACCESS_MODE_NEXT,
-					&value, extack);
+					&value,
+#ifdef HAVE_DEVLINK_PARAM_GET_FUNCTION_POINTER_HAS_EXTACK
+					extack);
+#else
+					NULL);
+#endif
 	if (err)
 		return err;
 
@@ -374,7 +412,11 @@ mlx5_devlink_swp_l4_csum_mode_get(struct devlink *devlink, u32 id,
 
 static int
 mlx5_devlink_swp_l4_csum_mode_validate(struct devlink *devlink, u32 id,
+#ifdef HAVE_DEVLINK_PARAM_VALIDATE_FUNCTION_POINTER_VALUE_IS_PTR
+				       union devlink_param_value *val,
+#else
 				       union devlink_param_value val,
+#endif
 				       struct netlink_ext_ack *extack)
 {
 	struct mlx5_core_dev *dev = devlink_priv(devlink);
@@ -383,7 +425,11 @@ mlx5_devlink_swp_l4_csum_mode_validate(struct devlink *devlink, u32 id,
 	int err, i;
 
 	for (i = 0; i < ARRAY_SIZE(swp_l4_csum_mode_str); i++) {
+#ifdef HAVE_DEVLINK_PARAM_VALIDATE_FUNCTION_POINTER_VALUE_IS_PTR
+		if (!strcmp(val->vstr, swp_l4_csum_mode_str[i]))
+#else
 		if (!strcmp(val.vstr, swp_l4_csum_mode_str[i]))
+#endif
 			break;
 	}
 
@@ -443,10 +489,18 @@ mlx5_swp_l4_csum_mode_set(struct devlink *devlink, u32 id, u8 value,
 
 static int
 mlx5_devlink_swp_l4_csum_mode_set(struct devlink *devlink, u32 id,
-				  struct devlink_param_gset_ctx *ctx,
-				  struct netlink_ext_ack *extack)
+				  struct devlink_param_gset_ctx *ctx
+#ifdef HAVE_DEVLINK_PARAM_SET_FUNCTION_POINTER_HAS_EXTACK
+/* Newer kernels (6.10+): extack parameter added for better error reporting */
+				  , struct netlink_ext_ack *extack
+#endif
+				  )
 {
 	u8 value;
+#ifndef HAVE_DEVLINK_PARAM_SET_FUNCTION_POINTER_HAS_EXTACK
+	/* Older kernels: extack not passed by core; use NULL for internal helpers */
+	struct netlink_ext_ack *extack = NULL;
+#endif
 
 	if (!strcmp(ctx->val.vstr, "full_csum"))
 		value = SWP_L4_CSUM_MODE_FULL_CSUM;
@@ -456,6 +510,8 @@ mlx5_devlink_swp_l4_csum_mode_set(struct devlink *devlink, u32 id,
 	return mlx5_swp_l4_csum_mode_set(devlink, id, value, extack);
 }
 
+#ifdef HAVE_DEVLINK_PARAM_DRIVER_WITH_DEFAULTS
+/* Newer kernels (6.19+): devlink_param supports get_default/reset_default callbacks */
 static int
 mlx5_devlink_swp_l4_csum_mode_get_default(struct devlink *devlink, u32 id,
 					  struct devlink_param_gset_ctx *ctx,
@@ -489,6 +545,7 @@ mlx5_devlink_swp_l4_csum_mode_set_default(struct devlink *devlink, u32 id,
 
 	return mlx5_swp_l4_csum_mode_set(devlink, id, value, extack);
 }
+#endif /* HAVE_DEVLINK_PARAM_DRIVER_WITH_DEFAULTS */
 
 static int mlx5_nv_param_read_global_pci_conf(struct mlx5_core_dev *dev,
 					      void *mnvda, size_t len)
@@ -524,8 +581,12 @@ static int mlx5_nv_param_read_per_host_pf_conf(struct mlx5_core_dev *dev,
 }
 
