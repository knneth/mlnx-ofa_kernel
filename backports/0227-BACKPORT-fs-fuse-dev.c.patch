From: Valentine Fatiev <valentinef@nvidia.com>
Subject: [PATCH] BACKPORT: fs/fuse/dev.c

---
 fs/fuse/dev.c | 18 ++++++++++++++++++
 1 file changed, 18 insertions(+)

--- a/fs/fuse/dev.c
+++ b/fs/fuse/dev.c
@@ -38,6 +38,7 @@ void fuse_creds(struct fuse_req *req)
 {
 	struct fuse_conn *fc = req->fm->fc;
 
+#ifdef HAVE_SB_I_NOIDMAP
 	if (!req->fm->sb || req->fm->sb->s_iflags & SB_I_NOIDMAP) {
 		req->in.h.uid = from_kuid(fc->user_ns, current_fsuid());
 		req->in.h.gid = from_kgid(fc->user_ns, current_fsgid());
@@ -45,6 +46,10 @@ void fuse_creds(struct fuse_req *req)
 		req->in.h.uid = FUSE_INVALID_UIDGID;
 		req->in.h.gid = FUSE_INVALID_UIDGID;
 	}
+#else
+	req->in.h.uid = from_kuid(fc->user_ns, current_fsuid());
+	req->in.h.gid = from_kgid(fc->user_ns, current_fsgid());
+#endif
 
 	req->in.h.pid = pid_nr_ns(task_pid(current), fc->pid_ns);
 }
@@ -112,6 +117,7 @@ void fuse_force_creds(struct fuse_req *r
 {
 	struct fuse_conn *fc = req->fm->fc;
 
+#ifdef HAVE_SB_I_NOIDMAP
 	if (!req->fm->sb || req->fm->sb->s_iflags & SB_I_NOIDMAP) {
 		req->in.h.uid = from_kuid_munged(fc->user_ns, current_fsuid());
 		req->in.h.gid = from_kgid_munged(fc->user_ns, current_fsgid());
@@ -119,6 +125,10 @@ void fuse_force_creds(struct fuse_req *r
 		req->in.h.uid = FUSE_INVALID_UIDGID;
 		req->in.h.gid = FUSE_INVALID_UIDGID;
 	}
+#else
+	req->in.h.uid = from_kuid_munged(fc->user_ns, current_fsuid());
+	req->in.h.gid = from_kgid_munged(fc->user_ns, current_fsgid());
+#endif
 
 	req->in.h.pid = pid_nr_ns(task_pid(current), fc->pid_ns);
 }
@@ -346,7 +356,11 @@ static int fuse_check_folio(struct folio
 {
 	if (folio_mapped(folio) ||
 	    folio->mapping != NULL ||
+#ifdef HAVE_FOLIO_FLAGS_F
+	    (folio->flags.f & PAGE_FLAGS_CHECK_AT_PREP &
+#else
 	    (folio->flags & PAGE_FLAGS_CHECK_AT_PREP &
+#endif
 	     ~(1 << PG_locked |
 	       1 << PG_referenced |
 	       1 << PG_lru |
@@ -927,6 +941,7 @@ copy_finish:
 	return err;
 }
 
+#ifdef HAVE_FUSE_NOTIFY_RESEND
 /*
  * Resending all processing queue requests.
  *
@@ -960,6 +975,7 @@ static int fuse_notify_resend(struct fus
 	fuse_resend(fc);
 	return 0;
 }
+#endif
 
 int fuse_notify(struct fuse_conn *fc, enum fuse_notify_code code,
 		unsigned int size, struct fuse_copy_state *cs)
@@ -986,8 +1002,10 @@ int fuse_notify(struct fuse_conn *fc, en
 	case FUSE_NOTIFY_DELETE:
 		return fuse_notify_delete(fc, size, cs);
 
+#ifdef HAVE_FUSE_NOTIFY_RESEND
 	case FUSE_NOTIFY_RESEND:
 		return fuse_notify_resend(fc);
+#endif
 
 	default:
 		fuse_copy_finish(cs);
