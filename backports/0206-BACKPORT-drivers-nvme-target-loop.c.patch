From: Valentine Fatiev <valentinef@nvidia.com>
Subject: [PATCH] BACKPORT: drivers/nvme/target/loop.c

---
 drivers/nvme/target/loop.c | 21 +++++++++++++++++++++
 1 file changed, 21 insertions(+)

diff --git a/drivers/nvme/target/loop.c b/drivers/nvme/target/loop.c
index xxxxxxx..xxxxxxx 100644
--- a/drivers/nvme/target/loop.c
+++ b/drivers/nvme/target/loop.c
@@ -166,7 +166,11 @@ static blk_status_t nvme_loop_queue_rq(struct blk_mq_hw_ctx *hctx,
 		}
 
 		iod->req.sg = iod->sg_table.sgl;
+#ifdef HAVE_BLK_RQ_MAP_SG_2_PARAMS
 		iod->req.sg_cnt = blk_rq_map_sg(req, iod->sg_table.sgl);
+#else
+		iod->req.sg_cnt = blk_rq_map_sg(req->q, req, iod->sg_table.sgl);
+#endif
 		iod->req.transfer_len = blk_rq_payload_bytes(req);
 	}
 
@@ -205,7 +209,16 @@ static int nvme_loop_init_iod(struct nvme_loop_ctrl *ctrl,
 
 static int nvme_loop_init_request(struct blk_mq_tag_set *set,
 		struct request *req, unsigned int hctx_idx,
+#ifdef HAVE_BLK_MQ_OPS_INIT_REQUEST_INT_NUMA_NODE
+/* Upstream commit b040a1a4523d99a935cb6566b1e2a753c84733cd
+ * ("block: switch numa_node to int in blk_mq_hw_ctx and init_request", 7.2+)
+ * Changed init_request numa_node arg from unsigned int to int so NUMA_NO_NODE
+ * (-1) is not silently coerced to UINT_MAX on CONFIG_NUMA=n.
+ */
+		int numa_node)
+#else
 		unsigned int numa_node)
+#endif
 {
 	struct nvme_loop_ctrl *ctrl = to_loop_ctrl(set->driver_data);
 	struct nvme_loop_iod *iod = blk_mq_rq_to_pdu(req);
@@ -216,7 +229,9 @@ static int nvme_loop_init_request(struct blk_mq_tag_set *set,
 			(set == &ctrl->tag_set) ? hctx_idx + 1 : 0);
 }
 
+#ifdef HAVE_BLK_MQ_HCTX_SET_FQ_LOCK_CLASS
 static struct lock_class_key loop_hctx_fq_lock_key;
+#endif
 
 static int nvme_loop_init_hctx(struct blk_mq_hw_ctx *hctx, void *data,
 		unsigned int hctx_idx)
@@ -232,7 +247,9 @@ static int nvme_loop_init_hctx(struct blk_mq_hw_ctx *hctx, void *data,
 	 * then we can remove the dynamically allocated lock class for each
 	 * flush queue, that way may cause horrible boot delay.
 	 */
+#ifdef HAVE_BLK_MQ_HCTX_SET_FQ_LOCK_CLASS
 	blk_mq_hctx_set_fq_lock_class(hctx, &loop_hctx_fq_lock_key);
+#endif
 
 	hctx->driver_data = queue;
 	return 0;
@@ -399,7 +416,11 @@ static int nvme_loop_configure_admin_queue(struct nvme_loop_ctrl *ctrl)
 		goto out_cleanup_tagset;
 
 	ctrl->ctrl.max_hw_sectors =
+#ifdef HAVE_BLK_TYPES_PAGE_SECTORS_SHIFT
 		(NVME_LOOP_MAX_SEGMENTS - 1) << PAGE_SECTORS_SHIFT;
+#else
+		(NVME_LOOP_MAX_SEGMENTS - 1) << (PAGE_SHIFT - 9);
+#endif
 
 	nvme_unquiesce_admin_queue(&ctrl->ctrl);
 
