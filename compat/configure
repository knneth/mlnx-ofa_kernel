		case "X${NJOBS}" in
			X | XA-Za-z*)
			NJOBS=$(MLXNUMC=$(grep ^processor /proc/cpuinfo | wc -l) && echo $(($MLXNUMC<16?$MLXNUMC:16)))
			;;
		esac

else
  NJOBS=1

fi




# prep some default values
