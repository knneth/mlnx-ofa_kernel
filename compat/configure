	declare -i RUNNING_JOBS=0
fi


# wait if there are MAX_JOBS tests running
if [ $RUNNING_JOBS -eq $MAX_JOBS ]; then
	wait
	RUNNING_JOBS=0
else
	let RUNNING_JOBS++
fi

# inc header index
let CONFDEFS_H_INDEX++

# run test in background if MAX_JOBS > 1
if [ $MAX_JOBS -eq 1 ]; then

{
