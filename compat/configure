else
	{ $as_echo "$as_me:${as_lineno-$LINENO}: result: yes" >&5
$as_echo "yes" >&6; }

$as_echo "#define HAVE_FIB_LOOKUP_EXPORTED 1" >>confdefs.h

fi


	{ $as_echo "$as_me:${as_lineno-$LINENO}: checking if Linux was built with symbol idr_get_next_ul exported" >&5
$as_echo_n "checking if Linux was built with symbol idr_get_next_ul exported... " >&6; }
grep -q -E '[[:space:]]idr_get_next_ul[[:space:]]' $LINUX_OBJ/$SYMVERFILE 2>/dev/null
