	export=0
	for file in net/sunrpc/svc.c; do
		grep -q -E "EXPORT_SYMBOL.*\(svc_pool_wake_idle_thread\)" "$LINUX/$file" 2>/dev/null
		rc=$?
		if test $rc -eq 0; then
			export=1
			break;
		fi
	done
